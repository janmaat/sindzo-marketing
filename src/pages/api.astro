---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';

// /api — eerlijke stand van de FHIR-laag. Er is (24-09-2026) geen publiek FHIR-endpoint,
// geen sandbox en geen OAuth2-toegang voor derden: de resources hieronder bouwt de
// BgZ-module intern (Ponscura.Integratie.BgZ, projectors). Beloof hier niets wat daar
// niet staat.

const resources = [
  { name: 'Patient', desc: 'Cliëntdemografie en contactgegevens — Zib-profiel.', status: 'live' },
  { name: 'Encounter', desc: 'Zorgmoment/contact — episode of care-context.', status: 'live' },
  { name: 'Observation', desc: 'Metingen, scores, vitale waarden.', status: 'live' },
  { name: 'MedicationStatement / MedicationRequest', desc: 'Medicatie-overzicht en voorschriften.', status: 'live' },
  { name: 'Condition', desc: 'Probleem-/diagnoseregistratie.', status: 'live' },
  { name: 'AllergyIntolerance', desc: 'Allergieën en intoleranties.', status: 'live' },
  { name: 'RelatedPerson', desc: 'Mantelzorger, wettelijk vertegenwoordiger, contactpersonen.', status: 'live' },
  { name: 'CarePlan', desc: 'Zorgplan — Omaha gemapped.', status: 'live' },
  { name: 'Practitioner / PractitionerRole', desc: 'Behandelaar en zijn rol.', status: 'live' },
];

const dot = (s: string) =>
  s === 'live' ? 'bg-green-500' : s === 'wip' ? 'bg-amber-500' : 'bg-ink-300';
---
<Base
  title="API & FHIR — Curanta"
  description="FHIR R4 met Nederlandse Zib-profielen: intern gebouwd voor de BgZ, een publieke API is in ontwikkeling. De eerlijke stand van zaken."
>
  <PageHero
    eyebrow="API & integratie"
    title="FHIR R4 met Zib-profielen."
    subtitle="Curanta zet dossiergegevens intern om naar FHIR R4 met Nederlandse Zib-profielen — dat is de basis voor de BgZ en de eOverdracht. Een publieke API voor ketenpartners is in ontwikkeling: er draait nog geen publiek endpoint en er is nog geen sandbox."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="mailto:api@curanta.nl?subject=API%3A%20stand%20van%20zaken" class="btn-primary no-underline">Vraag de stand van zaken</a>
      <a href="/integraties" class="btn-secondary no-underline">Overzicht integraties</a>
    </div>
  </PageHero>

  <section class="container-prose py-12 border-b border-ink-100 bg-ink-100/40">
    <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-5 max-w-3xl">
      <div class="text-[10px] font-extrabold uppercase tracking-[0.22em] text-amber-900">Publieke API in ontwikkeling</div>
      <p class="mt-2 text-sm text-ink-700 leading-relaxed">
        Er is nog geen publieke FHIR-API, geen api.curanta.nl/docs en geen sandbox-tenant. Wilt u
        weten wat er wel is en wanneer u kunt koppelen? Mail
        <a href="mailto:api@curanta.nl" class="text-curanta-700 hover:underline">api@curanta.nl</a> —
        reactie binnen 1 werkdag, geen NDA nodig.
      </p>
    </div>
  </section>

  <section class="container-prose py-14 border-b border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">FHIR R4-resources (intern)</h2>
    <p class="mt-2 text-sm text-ink-700 max-w-2xl">
      Deze resources bouwt Curanta intern uit het dossier voor de BgZ-bundel, gemapt op de Nederlandse
      Zorginformatiebouwstenen (Zib's) waar die bestaan. Nog niet alle onderdelen van de BgZ worden
      gevuld, en geen van deze resources is al via een publiek endpoint op te vragen.
    </p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {resources.map((r) => (
        <li class="flex items-start gap-3 rounded-lg border border-ink-100 bg-white p-4">
          <span class={`status-dot mt-1.5 shrink-0 ${dot(r.status)}`}></span>
          <div>
            <div class="text-sm font-semibold text-ink-900">{r.name}</div>
            <div class="mt-0.5 text-xs text-ink-500">{r.desc}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-prose py-14 border-b border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">Hoe wij FHIR gebruiken</h2>
    <p class="mt-2 text-sm text-ink-700 max-w-3xl leading-relaxed">
      FHIR R4 is bij ons het uitwisselingsformaat aan de grens met de keten; intern blijft de opslag
      relationeel (zie <a href="/adr" class="text-curanta-700 hover:underline">ADR-002</a>). Uw volledige
      export krijgt u los daarvan in JSON, op verzoek en zonder exit-fee — zie
      <a href="/overstappen#eruit" class="text-curanta-700 hover:underline">/overstappen</a>.
    </p>
  </section>

  <Cta
    title="Implementatiepartner of ketenleverancier?"
    subtitle="Wij helpen integratiepartners graag op weg met spec, sandbox en architectuurklankbord. Mail rechtstreeks naar api@curanta.nl."
  />
</Base>
