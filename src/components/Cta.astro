---
import { DEMO_ZELF_AANGEBODEN, DEMO_EERSTE, DEMO_GESPREK } from '../config/demo';
import DotPattern from './magic/DotPattern.astro';

// Afsluitende oproep onderaan een pagina. Standaard de twee demo-knoppen van de site
// (src/config/demo.ts); een pagina met een eigen vraag ("laat het doorrekenen", "vraag de
// architectuurplaat aan") geeft een eigen primaire en tweede knop mee, zodat titel en knop
// hetzelfde vragen.
interface Knop { label: string; href: string; }
interface Props {
  title?: string;
  subtitle?: string;
  primary?: Knop;
  secondary?: Knop;
}
// Zonder demo-toegang (src/config/demo.ts) is er standaard één knop: de demonstratie.
const {
  title = DEMO_ZELF_AANGEBODEN ? 'Zelf rondkijken, of een demo op uw eigen proces?' : 'Curanta zien op uw eigen proces?',
  subtitle = DEMO_ZELF_AANGEBODEN
    ? 'Kijk zelf rond in een werkende omgeving met verzonnen cliënten. Of stuur ons drie typische werkstromen uit uw organisatie; dan laten wij zien hoe Curanta ze ondersteunt.'
    : 'Stuur ons drie typische werkstromen uit uw organisatie; dan laten wij met verzonnen cliënten zien hoe Curanta ze ondersteunt.',
  primary = DEMO_EERSTE,
  secondary = DEMO_ZELF_AANGEBODEN ? DEMO_GESPREK : undefined,
} = Astro.props;
---
<section class="container-prose py-20">
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-curanta-900 to-curanta-950 px-8 py-14 sm:px-14" data-reveal>
    {/* Stippenraster naar Magic UI. Geen lichtstreep: deze oproep staat op bijna elke pagina, en
        een eindeloze lus die niets vertelt is versiering (Taste Skill: beweging moet iets zeggen). */}
    <DotPattern class="text-white/[0.08]" masker="rechtsboven" />
    <div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 class="font-display text-3xl font-bold tracking-tightish text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-2xl text-curanta-100 leading-relaxed">{subtitle}</p>
      </div>
      <div class="flex flex-col items-start gap-3">
        <div class="flex flex-wrap gap-3">
          <a href={primary.href} class="inline-flex items-center justify-center rounded-full bg-accent-500 px-6 py-3 text-sm font-bold text-[#06231f] no-underline transition hover:bg-accent-600">
            {primary.label}
          </a>
          {secondary && secondary.href !== primary.href && (
            <a href={secondary.href} class="inline-flex items-center justify-center rounded-full border border-curanta-300/40 px-6 py-3 text-sm font-semibold text-white no-underline transition hover:bg-curanta-800">
              {secondary.label}
            </a>
          )}
        </div>
        <a href="/presentatie" class="text-sm font-medium text-curanta-100 underline-offset-2 hover:underline">Of bekijk eerst een presentatie, wanneer het u uitkomt →</a>
        <a href="/contact" class="text-sm font-medium text-curanta-100 underline-offset-2 hover:underline">Of stel ons een vraag →</a>
      </div>
    </div>
  </div>
</section>
