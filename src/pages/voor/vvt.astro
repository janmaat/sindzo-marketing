<SegmentLayout
  image="/og/voor-vvt.png"
  segmentKey="vvt"
  segmentLabel="VVT"
  title="VVT-software — verpleging, verzorging, thuiszorg | Curanta"
  description="VVT-software voor verpleeghuis en wijkverpleging: cliëntdossier, zorgplan, planning, declaratie en eOverdracht in één platform, met cliëntportaal in 7 talen."
  eyebrow="Voor VVT-organisaties"
  hero="Eén platform voor intra- en extramurale zorg — gebouwd voor arbeidskrapte."
