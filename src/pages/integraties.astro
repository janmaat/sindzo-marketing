---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';

// Status per koppeling zoals in het feitenblad (gebouwd / in ontwikkeling) en op 25-09-2026
// tegen de code gelegd (reviewrapport feiten #48–#51, #149–#151, #164). E-health staat
// op roadmap zonder merknamen (besluit Jan 26-09-2026: geen partnerovereenkomsten, onbevestigde endpoints).

interface Integration {
  name: string;
  category: string;
  body: string;
  status: 'live' | 'wip' | 'roadmap';
  doc?: string;
}

const integrations: Integration[] = [
  // Standaarden
  { name: 'FHIR R4', category: 'Standaarden', status: 'wip', doc: '/api',
    body: 'Curanta stelt de BgZ en de eOverdracht op in FHIR R4, gevalideerd tegen de profielen van Nictiz. Een publieke FHIR-API is in ontwikkeling.' },
  { name: 'MedMij', category: 'Standaarden', status: 'wip',
    body: 'Interne BgZ-bundelbrug gebouwd. Uitwisseling met een persoonlijke gezondheidsomgeving vraagt registratie bij Stichting MedMij, een PKIoverheid-certificaat en een conformiteitstest; die zijn er nog niet.' },
  { name: 'Wegiz / eOverdracht', category: 'Standaarden', status: 'wip',
    body: 'BgZ- en eOverdracht-bundel worden opgesteld uit het dossier (BgZ: 6 van 28 onderdelen volledig, 11 deels; eOverdracht: 11 van de 14 onderdelen van de Minimale eOverdracht). Verzenden via Nuts is nog niet aangesloten; dat richten we in bij implementatie, samen met uw ketenpartner.' },
  { name: 'LSP (VZVZ)', category: 'Standaarden', status: 'wip',
    body: 'Bevragen via het Landelijk Schakelpunt, met toestemming per cliënt. Aansluiten vraagt een VZVZ-aansluittraject en UZI-certificaten; die zijn er nog niet.' },

  // Communicatie
  { name: 'ZorgMail', category: 'Communicatie', status: 'live',
    body: 'Veilige berichten en bijlagen via het ZorgMail-netwerk.' },
  { name: 'ZorgDomein', category: 'Communicatie', status: 'live',
    body: 'Inkomende verwijzingen met bijlagen via ZorgDomein. Antwoorden vanuit Curanta is in ontwikkeling.' },

  // Medicatie
  { name: 'Medimo', category: 'Medicatie', status: 'live',
    body: 'Medicatieoverzicht, voorschriften, toedienregistratie en allergieën.' },

  // Financieel
  { name: 'AGB-register (Vektis)', category: 'Financieel', status: 'live',
    body: 'AGB-codes valideren en synchroniseren met het Vektis-register. De synchronisatie richten wij per klant in.' },
  { name: 'CAK', category: 'Financieel', status: 'live',
    body: 'Aanlevering voor de eigen bijdrage (Wlz/Wmo). Retourberichten leest u nu handmatig in; automatisch ophalen is in ontwikkeling.' },
  { name: 'Gemeenten (iWmo/iJw)', category: 'Financieel', status: 'live',
    body: 'iWmo- en iJw-berichtenverkeer en toewijzingen. Retourberichten leest u nu handmatig in; automatisch ophalen is in ontwikkeling.' },
  { name: 'Zorgkantoren (iWlz)', category: 'Financieel', status: 'live',
    body: 'iWlz-berichtenverkeer met validatie. Retourberichten leest u nu handmatig in; automatisch ophalen is in ontwikkeling.' },
  { name: 'Vecozo COV-check', category: 'Financieel', status: 'live',
    body: 'Controle op verzekering via Vecozo, per cliënt of voor alle cliënten tegelijk; de uitkomst wordt vastgelegd.' },
  { name: 'Zorgverzekeraars (Zvw)', category: 'Financieel', status: 'wip',
    body: 'Zvw-declaratie wijkverpleging: productcodes, tarieven en prestaties zijn gebouwd. Het berichtformaat dat Vecozo voorschrijft (AW319) nog niet — aanleveren kan daarom nog niet.' },

  // Sensor & domotica
  { name: 'Domotica', category: 'Sensoren en domotica', status: 'live',
    body: 'Alarmen en sensormeldingen (o.a. Mextal, Ascom, Sensara, CLB, CarePhone) komen binnen in een eigen alarmoverzicht, met een urgente melding aan de dienstdoende zorg. Aansluiting per leverancier bij de implementatie.' },

  // E-health
  { name: 'E-healthaanbieders', category: 'E-health', status: 'roadmap',
    body: 'Koppeling met e-healthaanbieders voor blended zorg. Vraagt een overeenkomst en API-toegang per aanbieder; die zijn er nog niet.' },

  // Identity & overig
  { name: 'DigiD', category: 'Identiteit', status: 'live',
    body: 'Inloggen op het cliëntportaal met DigiD, minimaal niveau Substantieel. Een betaalde optie; de aansluiting bij Logius regelen wij per klant.' },
  { name: 'Microsoft Entra ID (SSO)', category: 'Identiteit', status: 'wip',
    body: 'Inloggen met het eigen account van uw organisatie (SSO via OIDC), met rollen afgeleid uit groepen. De instellingen zijn er; inloggen via SSO nog niet.' },
  { name: 'UZI-pas', category: 'Identiteit', status: 'live',
    body: 'Inloggen met de UZI-pas is gebouwd: Curanta leest de pas uit en controleert de certificaatketen en of de pas is ingetrokken. U kunt ermee inloggen zodra wij dat op onze server hebben ingericht; dat is nog niet gebeurd. De eindtest met een echte UZI-pas doen wij bij de eerste klant.' },
  { name: 'Ysis-koppeling', category: 'Klinisch', status: 'wip',
    body: 'Uitwisseling van het behandeldossier voor specialistische teams.' },

  // Backoffice
  { name: 'DocuSign', category: 'Backoffice', status: 'live',
    body: 'Digitaal ondertekenen van HR-documenten in het personeelsdossier, via DocuSign eSignature.' },
  { name: 'Nmbrs', category: 'Backoffice', status: 'wip',
    body: 'De salarisexport als CSV is gebouwd. Een rechtstreekse koppeling met Nmbrs richten we in bij implementatie; die vraagt API-toegang per klant.' },
];

const categories = Array.from(new Set(integrations.map(i => i.category)));
const dotColor = (s: string) =>
  s === 'live' ? 'bg-green-500' : s === 'wip' ? 'bg-amber-500' : 'bg-ink-300';
const statusLabel = (s: string) =>
  s === 'live' ? 'Gebouwd' : s === 'wip' ? 'In ontwikkeling' : 'Gepland';
---
<Base
  image="/og/integraties.png"
  title="Koppelingen: Vecozo, ZorgMail, ZorgDomein, Medimo | Curanta"
  description="Gebouwd: ZorgMail, ZorgDomein, Medimo, iWmo/iJw/iWlz en CAK via Vecozo, DigiD, UZI-pas. In ontwikkeling: eOverdracht, MedMij, LSP, Zvw. Status per koppeling."
>
  <PageHero
    eyebrow="Koppelingen en standaarden"
    title="Koppelingen, met een eerlijke status."
    subtitle="Gebouwd betekent: de koppeling is er; de aansluiting (certificaat, contract met de berichtenpartij) regelen wij bij de implementatie. De gebouwde koppelingen zitten in het abonnement. Wat de berichtenpartij zelf rekent, zoals een Vecozo-certificaat of een ZorgMail-abonnement, betaalt u rechtstreeks aan die partij."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="/api" class="btn-primary no-underline">Stand van de API</a>
      <a href="/trust" class="btn-secondary no-underline">Trust Centre</a>
    </div>
  </PageHero>

  <section class="container-prose py-10 border-b border-ink-100 bg-ink-100/40">
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-4 text-center">
      <div>
        <div class="font-display text-3xl font-bold text-curanta-700">{integrations.length}</div>
        <div class="mt-1 text-xs text-ink-500">Koppelingen op deze pagina</div>
      </div>
      <div>
        <div class="font-display text-3xl font-bold text-green-600">{integrations.filter(i => i.status === 'live').length}</div>
        <div class="mt-1 text-xs text-ink-500">Gebouwd</div>
      </div>
      <div>
        <div class="font-display text-3xl font-bold text-amber-600">{integrations.filter(i => i.status === 'wip').length}</div>
        <div class="mt-1 text-xs text-ink-500">In ontwikkeling</div>
      </div>
      <div>
        <div class="font-display text-3xl font-bold text-ink-500">{integrations.filter(i => i.status === 'roadmap').length}</div>
        <div class="mt-1 text-xs text-ink-500">Gepland</div>
      </div>
    </div>
  </section>

  {categories.map((cat) => (
    <section class="container-prose py-12 border-b border-ink-100 last:border-0">
      <h2 class="font-display text-2xl font-bold text-ink-900">{cat}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {integrations.filter(i => i.category === cat).map((i) => (
          <article class="rounded-lg border border-ink-100 bg-white p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-display text-base font-semibold text-ink-900">{i.name}</h3>
              <span class="flex items-center gap-1.5 text-xs font-medium text-ink-500 whitespace-nowrap">
                <span class={`status-dot ${dotColor(i.status)}`}></span>{statusLabel(i.status)}
              </span>
            </div>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{i.body}</p>
            {i.doc && (
              <a href={i.doc} class="mt-3 inline-block text-xs font-medium text-curanta-700 no-underline hover:underline">
                Stand van de API →
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="container-prose py-16">
    <div class="rounded-2xl border border-ink-100 bg-ink-100/50 p-8">
      <h2 class="font-display text-2xl font-bold text-ink-900">Mist u een koppeling?</h2>
      <p class="mt-3 max-w-2xl text-ink-700">
        Laat het ons weten. Wij bekijken of hij past in de opbouw van Curanta en in uw zorgproces,
        en wij reageren binnen 1 werkdag.
      </p>
      <a href="mailto:info@curanta.nl?subject=Koppeling" class="btn-primary mt-5 no-underline">Mail info@curanta.nl</a>
    </div>
  </section>

  <Cta />
</Base>
