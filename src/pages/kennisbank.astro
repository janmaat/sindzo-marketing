---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';

// Kennisbank (27-09-2026). De twee artikelen (meertalig cliëntportaal en peer-support) gingen op
// 25-09-2026 offline: ze noemden een wet die niet meer bestaat, een retentiecijfer dat niet terug
// te vinden was en arbeidsmarktcijfers zonder bron. Ze zijn herschreven op de branch
// content/kennisbank-herschreven en op 27-09-2026 opnieuw getoetst (claimtoets: elke wet en elk
// cijfer bij de bron); besluit Jan KB: ze komen terug.
//
// Het feitenblad staat alleen bestaande artikelen toe: geen aankondigingen, geen "in voorbereiding",
// geen kennisbank@. Een nieuw artikel komt hier pas bij als het er staat, met nagetrokken wetten en
// cijfers met bron.

const artikelen = [
  {
    category: 'Regelgeving + cliëntenrechten',
    title: 'Een cliëntportaal in de taal van de cliënt: wat de wet vraagt, en wat niet',
    body: 'Wat de Wgbo, de Wkkgz, de AVG en de Wabvpz zeggen over begrijpelijke informatie en inzage, wat CBS-cijfers laten zien over oudere migranten, en welke vragen u uw leverancier stelt.',
    bijgewerkt: '2026-09-27',
    href: '/kennisbank/meertalig-clientportaal-nl-zorg',
  },
  {
    category: 'Financiering + administratie',
    title: 'Doorbraakmiddelen: wat het modelplan van uw software vraagt',
    body: 'Wie de doorbraakmiddelen voor spraakgestuurd rapporteren en capaciteitsplanning kan aanvragen, wanneer en voor hoeveel, en wat de modelplannen van uw zorgsoftware vragen.',
    bijgewerkt: '2026-10-16',
    href: '/kennisbank/doorbraakmiddelen-modelplan-software',
  },
  {
    category: 'Wet- en regelgeving',
    title: 'De Cyberbeveiligingswet: wat het bestuur moet vaststellen',
    body: 'Voor wie de wet geldt, wat het bestuur zelf goedkeurt en bijhoudt, wat de wet over leveranciers zegt, en wanneer u een incident meldt.',
    bijgewerkt: '2026-10-16',
    href: '/kennisbank/cyberbeveiligingswet-bestuur-zorg',
  },
  {
    category: 'Informatiebeveiliging',
    title: 'Software heeft een houdbaarheidsdatum: wat het PHP-lek van oktober 2026 betekent voor zorgorganisaties',
    body: 'Wat er in oktober 2026 met PHP gebeurde, wat de zorgplicht van de Cyberbeveiligingswet over onderhoud en kwetsbaarheden zegt, en vijf vragen voor uw softwareleverancier.',
    bijgewerkt: '2026-10-23',
    href: '/kennisbank/houdbaarheid-software-php-lek',
  },
  {
    category: 'Declareren',
    title: 'GDS801: declareren in de ggz volgens de standaard van Vektis',
    body: 'Wat GDS801 is, welke zorg ermee declareert, hoe het retourbericht GDS802 werkt, en waar u op let als u in de ggz declareert.',
    bijgewerkt: '2026-10-24',
    href: '/kennisbank/gds801-declareren-ggz',
  },
  {
    category: 'Arbeidsmarkt + welzijn',
    title: 'Peer-support voor zorgmedewerkers: wat het onderzoek zegt, en wat niet',
    body: 'Wat bekend is over collegiale steun, wat de cijfers over de arbeidsmarkt in zorg en welzijn (AZW) laten zien, en waar een werkgever op let bij privacy, de DPIA en psychosociale arbeidsbelasting.',
    bijgewerkt: '2026-09-27',
    href: '/kennisbank/peer-support-zorgmedewerkers',
  },
];

const datumNl = (d: string) => new Date(d).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const verder = [
  { title: 'Trust Centre', body: 'De stand van beveiliging, privacy, koppelingen en wettelijke termijnen, per onderwerp.', href: '/trust' },
  { title: 'Vergelijking', body: 'Curanta naast Nedap Ons, mijnCaress en Pluriform Zorg, met bron en controledatum per onderwerp.', href: '/vergelijking' },
  { title: 'Architectuurbesluiten', body: 'Waarom Curanta bouwt zoals het bouwt, met de afweging erbij.', href: '/adr' },
];
---
<Base
  title="Kennisbank | Curanta"
  description="Met bron: de doorbraakmiddelen, de Cyberbeveiligingswet, houdbaarheid van software, GDS801 in de ggz, een meertalig cliëntportaal en peer-support."
>
  <PageHero
    eyebrow="Kennisbank"
    title="Wat de wet en het onderzoek zeggen, met bron."
    subtitle="Wij publiceren een artikel pas als wij de wetten en cijfers erin hebben nagetrokken, met bron. Onder elk artikel staat wat er sinds de eerste versie is veranderd."
  />

  <section class="container-prose py-14 border-b border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">Artikelen</h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {artikelen.map((a) => (
        <li>
          <a href={a.href} class="group block h-full rounded-xl border border-ink-100 bg-white p-5 no-underline transition hover:border-curanta-300 hover:shadow-sm">
            <span class="text-[10px] uppercase tracking-wider text-curanta-700 font-semibold">{a.category}</span>
            <h3 class="mt-3 font-display text-base font-semibold text-ink-900 group-hover:text-curanta-700 transition">{a.title}</h3>
            <p class="mt-2 text-sm text-ink-700 leading-snug">{a.body}</p>
            <p class="mt-3 text-xs text-ink-500">Bijgewerkt op <time datetime={a.bijgewerkt}>{datumNl(a.bijgewerkt)}</time></p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-prose py-14">
    <h2 class="font-display text-2xl font-bold text-ink-900">Over Curanta zelf</h2>
    {/* Een rij links, geen drie gelijke kaarten (Taste Skill, 14-10-2026): het zijn verwijzingen,
        geen onderdelen die naast elkaar om aandacht vragen. */}
    <ul class="mt-6 max-w-4xl divide-y divide-ink-200 border-y border-ink-200">
      {verder.map((a) => (
        <li>
          <a href={a.href} class="group grid gap-1 py-5 no-underline sm:grid-cols-[14rem_1fr_auto] sm:items-baseline sm:gap-6">
            <h3 class="font-display text-base font-semibold text-ink-900 transition group-hover:text-curanta-700">{a.title}</h3>
            <p class="text-sm leading-relaxed text-ink-700">{a.body}</p>
            <span class="text-sm font-semibold text-curanta-700 transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Cta />
</Base>
