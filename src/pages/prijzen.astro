---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanCard from '../components/PlanCard.astro';
import Cta from '../components/Cta.astro';

// Prijzen zijn indicatief en bewust zichtbaar — concurrenten verbergen
// pricing tot na demo, wat procurement-cyclus verlengt. Wij tonen ranges
// zodat bestuurders interne business case kunnen maken vóór gesprek.
---
<Base
  image="/og/prijzen.png"
  title="Prijzen & abonnementen | Curanta"
  description="Transparante plan-matrix per medewerker per maand. Vier tiers, modulair geactiveerd, geen verborgen kosten."
>
  <PageHero
    eyebrow="Prijzen"
    title="Eerlijke prijzen, op tafel."
    subtitle="Vier abonnementsplannen, modulair geactiveerd. Geen verborgen kosten voor implementatie, hosting of basis-support. Eerlijke indicatie zodat u een interne business case kunt maken vóór er een gesprek nodig is."
  />

  <section class="container-prose py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <PlanCard
        name="Basic"
        tagline="Voor kleine teams en startende organisaties"
        priceFrom="€19"
        features={[
          'Cliëntdossier (Core) + SOEP-rapportage',
          'Tot 25 medewerkers',
          'Cliënt- en mantelzorgerportaal gratis',
          '1 module declaratie (Wmo óf Jw óf Wlz)',
          'E-mail-support binnen 1 werkdag',
          'NEN 7510 basis-controls',
        ]}
        cta={{ label: 'Start kennismaking', href: '/demo' }}
      />
      <PlanCard
        name="Compliance Pro"
        tagline="Voor organisaties met compliance-druk"
        priceFrom="€29"
        highlight={true}
        features={[
          'Alles uit Basic',
          'Onbeperkt medewerkers',
          'Wtza-wizard, Wtta, Zelfstandigenwet',
          'NEN 7510 control-suite + audit-export',
          'Wzd-stappenplan + IGJ-XML',
          'Klachten (Wkkgz) + VIM-engine',
          'Meertalig cliëntportaal (7 talen)',
          'Collega-netwerk + Lotgenoten-support',
          'DPA, subverwerkerslijst, security-pack',
          'Phone-support 09:00–17:00',
        ]}
        cta={{ label: 'Start kennismaking', href: '/demo' }}
      />
      <PlanCard
        name="Totaalzorg Plus"
        tagline="Voor organisaties met flexibele personeelsschil"
        priceFrom="€39"
        features={[
          'Alles uit Compliance Pro',
          'Volledige Planning + Routing + CAO-engine',
          'Marketplace-koppeling (Ponscura)',
          'ZZP-financieel + AGB-validatie',
          'Internationale-instroom-buddy (TR/AR/PL/UK)',
          'WPM CO₂-rapportage (RVO, >100 mw verplicht)',
          'AI-Matching (in ontwikkeling)',
          'Featured listings & Temp-to-perm',
        ]}
        cta={{ label: 'Start kennismaking', href: '/demo' }}
      />
      <PlanCard
        name="Enterprise"
        tagline="Voor concerns, ketens en grote tenants"
        features={[
          'Alles uit Totaalzorg Plus',
          'Multi-tenant met concern-rapportage',
          'Dedicated success-manager',
          'SLA op maat, in overleg',
          'On-premises hosting optie (NL)',
          'Custom-koppelingen bouwen wij',
          'Architecture-review jaarlijks',
        ]}
        cta={{ label: 'Plan een verkenning', href: '/contact' }}
      />
    </div>

    <p class="mt-8 text-center text-sm text-ink-500">
      Alle prijzen ex. BTW, per actieve medewerker per maand, vanaf jaar-contract.
      Zorgmedewerkers die alleen het medewerkerportaal gebruiken: €19 per maand, in elk plan.
      Het cliënt- en mantelzorgerportaal zijn gratis.
      Vanaf 500 medewerkers stappen we over op een staffel-tarief.
      Indicatief — werkelijke prijs hangt af van segment, schaal en gekozen modules.
    </p>
  </section>

  {/* Toegevoegd 2026-08-17. Onderzocht: in elk ECD-selectieadvies staat dat
      organisaties de implementatie onderschatten en dat de eenmalige kosten vaak
      zwaarder wegen dan de licentie. Onze tarieven stonden er wel, maar zonder
      referentiekader — en juist het kader maakt ze pas een argument. Bewust een
      vergelijking met een marktbandbreedte en niet met een genoemde concurrent:
      dat laatste vraagt om gelijksoortige, verifieerbare cijfers per leverancier,
      en die publiceert niemand in deze markt. */}
  <section class="border-y border-ink-100 bg-curanta-50/60 py-16">
    <div class="container-prose">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Waar deze bedragen staan in de markt</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">
          Een licentieprijs zegt weinig zonder de rest van de rekening. In selectietrajecten
          gaat het mis op precies twee posten: de eenmalige implementatie, en de vraag wie de
          migratie betaalt. Daarom staan die hier naast het abonnement.
        </p>
      </div>

      <div class="mt-8 overflow-x-auto rounded-xl border border-ink-100 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-ink-100/50 text-left text-xs uppercase tracking-wider text-ink-500">
            <tr>
              <th class="px-4 py-3 font-semibold">Kostenpost</th>
              <th class="px-4 py-3 font-semibold">Gangbaar in de markt</th>
              <th class="px-4 py-3 font-semibold">Bij Curanta</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100 text-ink-700">
            <tr>
              <td class="px-4 py-3">Abonnement per gebruiker per maand</td>
              <td class="px-4 py-3">€50 – €90</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">€19 – €39 per actieve medewerker</td>
            </tr>
            <tr>
              <td class="px-4 py-3">Eenmalige implementatie en training</td>
              <td class="px-4 py-3">€4.000 – €5.000 bij kleinere trajecten, circa €15.000 bij grotere</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">inbegrepen in elk plan</td>
            </tr>
            <tr>
              <td class="px-4 py-3">Migratie vanuit uw huidige ECD</td>
              <td class="px-4 py-3">per geval, vaak nacalculatie</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">
                vaste prijs vooraf, per bronsysteem
              </td>
            </tr>
            <tr>
              <td class="px-4 py-3">Exit-export bij opzegging</td>
              <td class="px-4 py-3">wisselend, soms tegen kosten</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">geen exit-fee, JSON of CSV</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-4 max-w-3xl text-xs text-ink-500">
        Marktcijfers uit publieke overzichten van ECD-kosten voor Nederlandse zorgaanbieders
        (peildatum augustus 2026). Een bandbreedte, geen tarief van een specifieke leverancier —
        de grote partijen in deze markt publiceren hun prijzen niet, dus een cijfer per
        concurrent zou niet te verifiëren zijn. Wat u werkelijk betaalt hangt bij ons én bij hen
        af van schaal, segment en modulekeuze.
      </p>

      <p class="mt-6 max-w-3xl text-sm text-ink-700 leading-relaxed">
        Dat wij onderaan die bandbreedte zitten is een keuze, geen introductieactie: er zit geen
        salesorganisatie, geen implementatieafdeling en geen accountmanagementlaag in onze
        kosten. Wat dat betekent voor de verwachting die u van ons mag hebben, staat op
        <a href="/cases" class="text-curanta-700 hover:underline">/cases</a> —
        inclusief wat wij nog níét kunnen bieden.
      </p>
    </div>
  </section>

  {/* Herzien 2026-08-17. De vorige versie rekende elke leverancier om naar "per
      medewerker per maand" bij een aangenomen 8 cliënten per medewerker. Dat gaf
      Nedap €184 — vijf keer wat een organisatie van 50-500 medewerkers betaalt,
      omdat die €23 een zzp-resellertarief is terwijl Nedap zelf een schaalbaar
      pay-per-use-model publiceert zonder eenheidsprijs. En die caseload-ratio had
      geen bron: V&VN, Movisie en het NJi zeggen alle drie dat er geen vaste ratio
      bestaat. Een concurrent vijf keer te duur voorstellen op een pagina die
      eerlijkheid als onderscheid verkoopt, is het slechtst mogelijke ruilmiddel —
      onze kopers hebben Nedap-offertes op hun bureau liggen.

      Nu: elke leverancier in zijn eigen eenheid, met wat hij zélf publiceert, en
      de rekenoefening vervangen door de vraag die er werkelijk toe doet. Elke
      regel is op 2026-08-17 bij de bron nagetrokken. */}
  <section class="container-prose py-16 border-t border-ink-100">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Hoe dit zich verhoudt tot andere modellen</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        Wij rekenen per actieve medewerker. De meeste partijen in de langdurige zorg rekenen
        per actief cliëntdossier, en in de GGZ komt betalen per behandelaar of per seat plus
        een deel van de omzet ook voor. Die modellen zijn niet rechtstreeks vergelijkbaar: wat
        voordelig uitpakt hangt af van hoeveel cliënten één medewerker gemiddeld draagt, en dat
        verschilt sterk per organisatie.
      </p>
      <p class="mt-3 text-ink-700 leading-relaxed">
        Daarom zetten wij hier geen omgerekend bedrag neer. Hieronder staat per leverancier wat
        hij <em>zelf</em> publiceert, in zijn eigen eenheid.
      </p>
    </div>
    <div class="mt-8 overflow-x-auto rounded-xl border border-ink-100 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-ink-100/50 text-left text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="px-4 py-3 font-semibold">Leverancier</th>
            <th class="px-4 py-3 font-semibold">U betaalt per</th>
            <th class="px-4 py-3 font-semibold">Gepubliceerd tarief</th>
            <th class="px-4 py-3 font-semibold">Bron</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100 text-ink-700">
          <tr class="bg-greensoft/40">
            <td class="px-4 py-3 font-semibold text-curanta-900">Curanta Compliance Pro</td>
            <td class="px-4 py-3">actieve medewerker</td>
            <td class="px-4 py-3 font-semibold text-curanta-900">€29 per maand</td>
            <td class="px-4 py-3 text-xs text-ink-500">Deze pagina</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Nedap Ons</td>
            <td class="px-4 py-3">actief cliëntdossier</td>
            <td class="px-4 py-3">
              Geen eenheidsprijs openbaar. Nedap noemt het model schaalbaar en publiceert
              alleen een minimum van €25 per maand.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">nedap-ons.nl</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Ecare PUUR.</td>
            <td class="px-4 py-3">niet gepubliceerd</td>
            <td class="px-4 py-3">
              Geen tarief of prijsmodel openbaar. Ecare verwijst voor een prijs naar een demo of
              een gesprek.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">ecare.nl</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Octaaf Thuiszorgsoftware</td>
            <td class="px-4 py-3">licentie + cliënt</td>
            <td class="px-4 py-3">
              €27,83 per maand + €2,79 per cliënt. Onbeperkt aantal gebruikers inbegrepen.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">octaafthuiszorgsoftware.nl</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Karify (GGZ, eHealth)</td>
            <td class="px-4 py-3">professional</td>
            <td class="px-4 py-3">
              Vanaf €29,95 per maand. Boven 250 medewerkers op aanvraag; modules deels per
              gebruik.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">karify.com</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Curasoft (GGZ)</td>
            <td class="px-4 py-3">gebruiker, plus beheerder</td>
            <td class="px-4 py-3">
              €106 per gebruiker, of €26 per gebruiker + 1% van de maandomzet. Beheerderslicentie
              apart: €185 respectievelijk €104.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">curasoft.nl</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-4 max-w-3xl text-xs text-ink-500">
      Elk tarief hierboven is op 17 augustus 2026 nagetrokken bij de leverancier zelf, dat van
      Ecare op 25 september 2026. Wij zetten
      hier bewust geen omrekening naar één noemer: dat vraagt een aanname over het aantal
      cliënten per medewerker, en V&amp;VN, Movisie en het Nederlands Jeugdinstituut stellen alle
      drie dat daar geen vaste norm voor bestaat. Een vergelijking op een aanname die wij zelf
      kiezen, is geen vergelijking. Ziet u een fout in deze tabel, dan corrigeren wij die binnen
      1 werkdag — <a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a>.
    </p>
    <div class="mt-8 rounded-2xl border border-ink-100 bg-curanta-50 p-6 max-w-3xl">
      <h3 class="font-display text-lg font-semibold text-ink-900">Wat het voor ú betekent</h3>
      <p class="mt-2 text-sm text-ink-700 leading-relaxed">
        Geef ons uw aantal medewerkers en uw aantal actieve cliënten, en wij rekenen het door
        tegen uw huidige contract. Valt dat in het voordeel van uw huidige leverancier uit, dan
        zeggen wij dat — dat is goedkoper voor ons dan een klant die na een jaar spijt heeft.
      </p>
      <a href="/contact" class="mt-4 inline-block btn-primary no-underline">Laat het doorrekenen</a>
    </div>
  </section>

  <section class="container-prose py-16 border-t border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Wat <em>niet</em> apart in rekening wordt gebracht</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        ['Hosting in NL', 'Azure West-Europe + backup NL — geen extra kosten.'],
        ['Standaard-implementatie', 'Onboarding-traject in alle plannen inbegrepen.'],
        ['Training (e-learning)', 'Self-paced training voor alle gebruikers.'],
        ['Software-updates', 'Continuous deployment — geen versie-upgrades met meerprijs.'],
        ['Basis-support', 'E-mail binnen 1 werkdag, kennisbank en community.'],
        ['DPA & security-pack', 'Standaard meegeleverd, geen NDA nodig.'],
      ].map(([title, body]) => (
        <li class="rounded-lg border border-ink-100 bg-white p-5">
          <h3 class="font-semibold text-ink-900">{title}</h3>
          <p class="mt-1 text-sm text-ink-700">{body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-prose py-16 border-t border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">Veelgestelde vragen over prijs</h2>
    <dl class="mt-8 space-y-6 max-w-3xl">
      <div>
        <dt class="font-semibold text-ink-900">Wat telt als "actieve medewerker"?</dt>
        <dd class="mt-1 text-sm text-ink-700">Een gebruiker die in de afgelopen 30 dagen heeft ingelogd. Slapende accounts tellen niet mee — u betaalt niet voor mensen die niet werken.</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink-900">Wat kost een zorgmedewerker die alleen het medewerkerportaal gebruikt?</dt>
        <dd class="mt-1 text-sm text-ink-700">€19 per maand, in elk plan. Dat geldt voor wie alleen het medewerkerportaal nodig heeft. Wie ook in de backoffice werkt, betaalt het bedrag van het plan — bijvoorbeeld een wijkverpleegkundige die indicaties stelt.</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink-900">Hoe zit het met cliënten en mantelzorgers?</dt>
        <dd class="mt-1 text-sm text-ink-700">Het cliëntportaal en het mantelzorgerportaal zijn gratis, in alle plannen. Cliënten, mantelzorgers en familie tellen niet als medewerker.</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink-900">Hoe loggen gebruikers in?</dt>
        <dd class="mt-1 text-sm text-ink-700">Met tweestapsverificatie, inbegrepen in elk plan. Inloggen met DigiD voor cliënten en mantelzorgers is een betaalde optie.</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink-900">Wat kost het bij meer dan 1.000 medewerkers?</dt>
        <dd class="mt-1 text-sm text-ink-700">Vanaf 500 medewerkers stappen we over op een staffel-tarief. Bij Enterprise contractje stelt u zelf de schaal vast — bel ons voor een indicatie.</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink-900">Is migratie van mijn huidige ECD inbegrepen?</dt>
        <dd class="mt-1 text-sm text-ink-700">Migratie vanuit <strong>Nedap Ons</strong>, <strong>Gerimedica Ysis</strong>, <strong>SDB</strong> of <strong>Adapcare</strong> doen we als migratieproject tegen een vaste prijs vooraf — geen open einde. Een kant-en-klare import per bronsysteem is er nog niet; de route stellen we per organisatie samen op. Per bronsysteem uitgewerkt, inclusief het exit-pad, op <a href="/overstappen" class="text-curanta-700 hover:underline">/overstappen</a>.</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink-900">Hoelang duurt een implementatie?</dt>
        <dd class="mt-1 text-sm text-ink-700">Dat spreken we per organisatie af, na een migratie-inschatting. Wij zijn nieuw en noemen liever geen doorlooptijd die nog door geen enkele klant is gehaald. Onboarding­traject, migratie en training zijn inbegrepen in alle plannen. Grotere of complexere trajecten worden als vast project geprijsd, zodat u geen open­einde hebt.</dd>
      </div>
      <div>
        <dt class="font-semibold text-ink-900">Kan ik tussentijds switchen tussen plannen?</dt>
        <dd class="mt-1 text-sm text-ink-700">Upgraden kan altijd direct. Downgraden kan per kwartaal-grens, geen exit-fee. Data blijft volledig u eigendom — exit-export in JSON/CSV op verzoek.</dd>
      </div>
    </dl>
  </section>

  <Cta
    title="Niet zeker welk plan past?"
    subtitle="Stuur uw situatie (segment, schaal, huidige systemen) en wij geven binnen 1 werkdag een eerlijk advies — ook als dat is dat een andere leverancier beter past."
  />
</Base>
