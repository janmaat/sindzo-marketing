---
import Base from '../layouts/Base.astro';
import StatusLabel from '../components/StatusLabel.astro';
import StatusLegenda from '../components/StatusLegenda.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { NIS2CARE_LIVE, NIS2CARE_URL } from '../config/features';
import { CONTINUITEIT, CYBERBEVEILIGINGSWET, HOUDBAARHEID } from '../config/kennisbank';
import { DOTNET, LEKKEN_GEMETEN } from '../config/fundament';
import type { Status } from '../config/status';

// Trust Centre. Herzien 08-10-2026:
// - Twee soorten onderwerpen. Een functie of koppeling (FHIR-API, NIS2-module) krijgt de gedeelde
//   status uit src/config/status.ts, gelijk aan de homepage, /oplossing en /integraties. Een
//   maatregel van Curanta als organisatie (certificering, pentest, FG) krijgt een eigen stand:
//   geregeld, in uitvoering, gepland of nog niet begonnen.
// - De wettelijke termijnen staan hier, niet meer op de homepage; nagelopen tegen officiële
//   bronnen op 08-10-2026 (zie de bronregel onder die sectie en docs/controlelijst-claims.md).
//
// "Laatst herzien" is een vaste datum, geen builddatum: elke uitrol zette anders de datum van
// vandaag, ook zonder herziening. Bijwerken bij een inhoudelijke herziening.
const HERZIEN = '26 oktober 2026';

type Stand = 'geregeld' | 'uitvoering' | 'gepland' | 'niet';
const STAND: Record<Stand, { label: string; dot: string }> = {
  geregeld: { label: 'Geregeld', dot: 'bg-accent-600' },
  uitvoering: { label: 'In uitvoering', dot: 'bg-amber-500' },
  gepland: { label: 'Gepland', dot: 'bg-ink-300' },
  niet: { label: 'Nog niet', dot: 'bg-rose-400' },
};

interface Item { label: string; note: string; status?: Status; stand?: Stand; doc?: string; }

const pillars: { key: string; title: string; intro: string; items: Item[] }[] = [
  {
    key: 'security',
    title: 'Informatiebeveiliging',
    intro: 'Wij volgen ons werkdocument voor NEN 7510, de norm voor informatiebeveiliging in de zorg. Per onderwerp staat de stand erbij, ook voor de externe pentest (een gecontroleerde inbraakpoging) en de versleuteling van de hele database.',
    items: [
      { label: 'NEN 7510:2024', stand: 'uitvoering', note: 'Maatregelen ingevoerd, met een eerste beoordeling. Curanta is niet gecertificeerd; het certificeringstraject is in voorbereiding.', doc: '/procurement' },
      { label: 'NEN 7513 (logging)', stand: 'geregeld', note: 'Auditlog met hash-keten, zodat een wijziging achteraf aantoonbaar is. Elke regel zegt of iemand gegevens inzag, vastlegde, wijzigde of verwijderde. Een logregel over een cliënt blijft bewaard zolang het dossier bestaat; logregels zonder dossier 7 jaar.' },
      { label: 'Auditlogs naar uw SIEM', stand: 'geregeld', note: 'Curanta stuurt elke minuut het beveiligingslogboek en de beheeraudit naar het SIEM van uw organisatie. Het NEN 7513-logboek gaat mee als u dat aanzet, en dan gepseudonimiseerd. Getest met Splunk, Azure Monitor en een syslog-server.', doc: '/oplossing#kwaliteit' },
      { label: 'Scanblokkade', stand: 'geregeld', note: 'Wie bekende zwakke plekken van websites afzoekt, wordt automatisch geblokkeerd, oplopend tot een week. Verkeer van buiten Europa telt Curanta apart; binnen de EU weigert Curanta niemand.' },
      { label: 'NEN 7512 (uitwisseling)', stand: 'uitvoering', note: 'Uitgangspunt bij het bouwen van de koppelingen; nog niet extern getoetst.' },
      { label: 'Tweestapsverificatie', stand: 'geregeld', note: 'Verplicht in de backoffice voor zorg- en beheerrollen. Een nieuwe collega stelt het bij zijn eerste aanmelding zelf in, met een authenticator-app; tot dan opent Curanta voor hem alleen dat scherm.' },
      { label: 'Versleuteling BSN', stand: 'geregeld', note: 'Curanta versleutelt het BSN op veldniveau, met AES-256-GCM. Zoeken gaat via een aparte hash, zonder te ontsleutelen.' },
      { label: 'Versleuteling hele database', stand: 'geregeld', note: 'Uw gegevens staan versleuteld opgeslagen: volumeversleuteling op de server, ook voor de bijlagen en de back-ups. Het wachtwoord van dat volume staat niet op de server.' },
      // Besluit Jan 26-10-2026 (gelijk aan /veiligheid#garantie en #streven): virusscan als toezegging bij de oplevering;
      // pentest en ISO 27001 zonder datum.
      { label: 'Virusscan op uploads', stand: 'gepland', note: 'Bij de oplevering aan uw organisatie gegarandeerd: elk bestand dat iemand in Curanta uploadt, scannen wij op virussen.', doc: '/veiligheid#garantie' },
      { label: 'Externe pentest', stand: 'niet', note: 'Nog niet uitgevoerd. Wij werken naar een externe pentest toe.', doc: '/veiligheid#streven' },
      { label: 'ISO 27001', stand: 'gepland', note: 'Wij werken naar certificering toe. Een datum is er nog niet.', doc: '/veiligheid#streven' },
    ],
  },
  {
    key: 'privacy',
    title: 'Privacy en gegevensbescherming',
    intro: 'Wie welke gegevens verwerkt, en waar.',
    items: [
      { label: 'Functionaris gegevensbescherming', stand: 'niet', note: 'Nog niet aangesteld. Een externe FG volgt vóór de eerste zorgorganisatie met echte cliëntgegevens.' },
      { label: 'Verwerkersovereenkomst', stand: 'uitvoering', note: 'Wij stellen hem op aanvraag op, zonder geheimhoudingsverklaring (NDA).', doc: '/procurement' },
      { label: 'Subverwerkers', stand: 'geregeld', note: 'Hosting, site en mail bij een hostingpartij in Duitsland (EU); de namen staan in de subverwerkerslijst. De AI-functies: standaard Mistral AI via het EU-endpoint, gepseudonimiseerd; alleen als uw organisatie zelf kiest: Anthropic in de VS, met modelcontractbepalingen. Als u digitaal ondertekent: DocuSign in de VS.', doc: 'https://app.curanta.nl/trust/subverwerkers' },
      { label: 'Amerikaanse wetgeving (Cloud Act)', stand: 'geregeld', note: 'De applicatie en de databases staan bij een Europese hostingpartij in Duitsland. De AI-functies draaien standaard bij Mistral AI, een Frans bedrijf, via het EU-endpoint. Alleen als uw organisatie zelf voor Anthropic kiest, of als u digitaal ondertekenen aanzet, gaan gegevens naar Amerikaanse bedrijven (Anthropic gepseudonimiseerd, DocuSign), met modelcontractbepalingen. Het kabinet erkende op 7 oktober 2026 dat de Cloud Act kan botsen met de AVG (antwoorden op Kamervragen 2026Z16981).', doc: '/privacy' },
      { label: 'DPIA', stand: 'uitvoering', note: 'Voor de eigen DPIA van uw organisatie stellen wij de onderbouwing op aanvraag op.', doc: '/procurement' },
      { label: 'Pseudonimiseren', stand: 'geregeld', note: 'Cliëntgegevens pseudonimiseren bij een verzoek tot verwijdering; het logboek legt dat vast.' },
    ],
  },
  {
    key: 'interop',
    title: 'Koppelingen en uw gegevens',
    intro: 'Welke standaarden er zijn, en hoe u uw gegevens meeneemt. De status per koppeling is dezelfde als op de pagina Koppelingen.',
    items: [
      { label: 'FHIR-API voor de BgZ', status: 'inrichten', note: 'Levert de Basisgegevensset Zorg (BgZ) van een cliënt. Publiek en alleen om te lezen (FHIR R4), voor systemen die wij vooraf registreren. Geen testomgeving en geen algemene lees- of schrijftoegang.', doc: '/api' },
      { label: 'Wegiz / eOverdracht', status: 'inrichten', note: 'Het overdrachtsdocument volgens eOverdracht 4.0 gaat via het eOverdracht-netwerk; de ontvanger haalt het op en meldt terug. De aansluiting regelen wij bij de implementatie, met het UZI-servercertificaat van uw organisatie. Getest tussen twee omgevingen, nog niet met een ketenpartner, en niet door Nictiz gekwalificeerd.', doc: '/integraties' },
      { label: 'MedMij', status: 'ontwikkeling', note: 'Registratie bij MedMij en een PKIoverheid-certificaat zijn er nog niet.', doc: '/integraties' },
      { label: 'LSP', status: 'ontwikkeling', note: 'Voor het Landelijk Schakelpunt zijn de VZVZ-aansluiting en UZI-certificaten er nog niet.', doc: '/integraties' },
      { label: 'Export van uw gegevens', stand: 'geregeld', note: 'Een volledige export van uw gegevens en bestanden in JSON. Het BSN alleen als laatste vier cijfers en hash.', doc: '/overstappen#eruit' },
    ],
  },
  {
    key: 'operations',
    title: 'Beschikbaarheid en continuïteit',
    intro: 'Hosting in de EU, het onderhoud van de software en een openbare statuspagina, met per onderwerp het doel en de stand.',
    items: [
      { label: 'Hosting in de EU', stand: 'geregeld', note: 'Op een server in Duitsland (EU). Wie de hostingpartij is, staat in de subverwerkerslijst.', doc: 'https://app.curanta.nl/trust/subverwerkers' },
      // Feitenblad, rij Onderhoud en updates (besluit Jan 23-10-2026). Niet: "binnen x uur", "altijd de nieuwste versie".
      { label: 'Onderhoud van de software', stand: 'geregeld', note: `Elke maand controleren wij het platform op beveiliging. Een beveiligingsupdate brengen wij uit zodra hij nodig is, zonder te wachten op de volgende versie, en elke vier maanden komt er een nieuwe versie. Op ${LEKKEN_GEMETEN} zat er in Curanta geen enkel softwarepakket met een bekend lek, en geen pakket dat de maker niet meer onderhoudt.` },
      // Feitenblad, rij Fundament. De jaarlijkse overstap is de hoofdzin, de huidige versie de bijzin: na november
      // 2026 is het .NET 11, een versie met kortere ondersteuning. Bewaakt door scripts/controleer-fundament.mjs.
      { label: 'Techniek onder Curanta', stand: 'geregeld', note: `Curanta draait op .NET van Microsoft. Daarvan komt elk jaar in november een nieuwe versie uit, en wij stappen een paar weken later over. Nu is dat ${DOTNET.versie}, met beveiligingsupdates van Microsoft tot ${DOTNET.updatesTot}. De databank is PostgreSQL 18, ondersteund tot november 2030.` },
      { label: 'Openbare statuspagina', stand: 'geregeld', note: 'Actuele beschikbaarheid per onderdeel; geen incidenthistorie.', doc: 'https://app.curanta.nl/status' },
      { label: 'Beschikbaarheid', stand: 'uitvoering', note: 'Doel 99,9% op kantooruren. Nog geen gemeten historie.', doc: 'https://app.curanta.nl/status' },
      { label: 'Exit-procedure', stand: 'geregeld', note: 'In onze voorwaarden (artikel 9): wij leveren de export binnen 5 werkdagen, en u hebt 30 dagen om hem op te halen. Na afloop van die 30 dagen wissen wij uw gegevens; u krijgt een vernietigingsverklaring. Wissen kan pas nadat u hebt bevestigd dat u de volledige export hebt ontvangen, of nadat wij hebben vastgelegd waarom het zonder kan.', doc: '/voorwaarden#beeindiging' },
    ],
  },
  {
    // Toegevoegd 23-10-2026 (prompt site-houdbaarheid 01, aanvulling Janus Hoeks: "we gaan ervan uit dat het
    // gebeurt"). Alleen bestaande feitenbladrijen: RPO/RTO, hersteltoets, back-up, versleuteling, noodoverzicht,
    // Cbw-module. ⛔ Niet: 24/7-incidentrespons (besluit Jan 25-09). Sinds 26-10-2026 (besluit Jan) wel: de bewaking van
    // buitenaf als toezegging bij de oplevering (zelfde tekst als /veiligheid#garantie). De back-up buiten de server
    // loopt sinds 27-10-2026 (feitenblad, rij RPO / RTO, besluit Jan 28-10); de hersteltoets van 21-10 gold voor een
    // volume dat niet meer bestaat en staat hier daarom niet meer als stand van vandaag.
    key: 'herstel',
    title: 'Als het toch gebeurt',
    intro: 'Wij gaan ervan uit dat er een keer iets misgaat, ook met de nieuwste techniek. Daarom staat hier ook hoe wij herstellen, en hoe uw team dan doorwerkt.',
    items: [
      { label: 'RPO en RTO', stand: 'uitvoering', note: 'Doel in onze voorwaarden: RPO 1 uur (hoogstens 1 uur aan gegevens kwijt) en RTO 4 uur (binnen 4 uur weer in gebruik). De database wordt doorlopend geback-upt, en elke dag gaat er een versleutelde kopie naar een plek buiten de server.', doc: '/voorwaarden#sla' },
      { label: 'Hersteltest', stand: 'geregeld', note: 'Geslaagd op 28 oktober 2026: de kopie van buiten de server is op een aparte machine gecontroleerd, ontsleuteld en teruggezet. Binnen twee minuten stond de database weer.' },
      { label: 'Back-up buiten de server', stand: 'geregeld', note: 'Sinds 27 oktober 2026 gaat er elke dag een versleutelde kopie naar een plek buiten de server, in de EU. Die kopie bevat de database, de sleutels en de bijlagen. Een kopie telt pas als de ontvangst is bevestigd.', doc: '/veiligheid#garantie' },
      { label: 'Bewaking dag en nacht', stand: 'gepland', note: 'Bij de oplevering aan uw organisatie gegarandeerd: van buitenaf controleren wij 24 uur per dag, 7 dagen per week of Curanta bereikbaar is.', doc: '/veiligheid#garantie' },
      { label: 'Een gestolen schijf of back-up', stand: 'geregeld', note: 'Uw gegevens staan versleuteld opgeslagen, ook de bijlagen, de back-ups en de logs. Het wachtwoord van dat volume staat niet op de server.' },
      { label: 'Bij uitval', stand: 'geregeld', note: 'Elke dag een versleuteld noodoverzicht (pdf) met per cliënt de contactgegevens, waarschuwingen, allergieën en de medicatie van de dag. Het medewerkerportaal bewaart ook een kopie op het toestel. En er is een noodprocedure voor uw organisatie. Met de continuïteitscheck ziet u wat uw organisatie zelf nog regelt.', doc: '/continuiteitscheck' },
      { label: 'Een cyberincident bij uw organisatie', status: 'demo', note: 'U legt het incident vast in de module voor de Cyberbeveiligingswet, en Curanta bewaakt de meldtermijnen van 24 uur, 72 uur en één maand. Melden bij het CSIRT doet uw organisatie zelf.', doc: NIS2CARE_LIVE ? NIS2CARE_URL : '/oplossing#kwaliteit' },
    ],
  },
  {
    key: 'regulatory',
    title: 'Ondersteuning bij wetten',
    intro: 'Curanta helpt u registreren en termijnen bewaken. Aan de wet voldoen doet uw organisatie zelf; de software is daar een hulpmiddel bij.',
    items: [
      { label: 'Cyberbeveiligingswet (NIS2)', status: 'demo', note: 'Cyberincidenten registreren en de meldtermijnen van 24 uur, 72 uur en één maand bewaken. Verder de tien maatregelen van de zorgplicht met stand, bewijs en eigenaar, de vaststelling door het bestuur, en een leveranciersregister waarin Curanta zelf al staat.', doc: NIS2CARE_LIVE ? NIS2CARE_URL : '/oplossing#kwaliteit' },
      { label: 'Wkkgz', status: 'demo', note: 'Klachtenregeling, en de interne procedure om incidenten te melden.', doc: '/oplossing#kwaliteit' },
      { label: 'Wzd en Wvggz', status: 'demo', note: 'Registratie, en het halfjaarlijkse overzicht voor de IGJ, gevalideerd tegen het XML-schema van de IGJ. Een echte aanlevering is er nog niet.', doc: '/oplossing#kwaliteit' },
      { label: 'Wtza', status: 'demo', note: 'Toelating vastleggen en de jaarverantwoording bewaken (vóór 1 juni, in DigiMV).', doc: '/oplossing#kwaliteit' },
      { label: 'Wtta', status: 'demo', note: 'Uw eigen toelating vastleggen. En als inlener per uitlener vastleggen dat u zijn toelating controleerde.', doc: '/oplossing#kwaliteit' },
      { label: 'AI-verordening', status: 'demo', note: 'Een register en classificatie van de AI-systemen in Curanta, met een logboek van AI-aanroepen.', doc: '/oplossing#ai' },
    ],
  },
];

// Wettelijke termijnen, nagelopen op 08-10-2026 (bronnen onder de sectie).
const termijnen = [
  {
    datum: 'Sinds 15 augustus 2026',
    wet: 'Cyberbeveiligingswet (NIS2)',
    wat: 'Zorgaanbieders met 50 of meer fte, of met een jaaromzet én balanstotaal van €10 miljoen of meer, vallen eronder. Zij registreren zich bij het Nationaal Cyber Security Centrum (NCSC). Een significant incident melden zij binnen 24 uur (vroegtijdige waarschuwing), 72 uur (melding) en één maand (eindverslag).',
    curanta: 'U registreert incidenten; Curanta bewaakt de drie meldtermijnen.',
  },
  {
    datum: 'Elk jaar vóór 1 juni',
    wet: 'Openbare jaarverantwoording (Wtza)',
    wat: 'De plicht geldt voor zorgaanbieders die zorg leveren uit de Zvw of de Wlz, of subsidie van VWS krijgen. Zij maken hun jaarverantwoording openbaar via DigiMV. Solisten die zelf de zorg verlenen zijn uitgezonderd.',
    curanta: 'U legt de toelating vast en krijgt een herinnering vóór de uiterste datum. Aanleveren doet u zelf, in DigiMV.',
  },
  {
    datum: '1 januari 2027 en 1 januari 2028',
    wet: 'Wtta (toelating uitleners)',
    wat: 'De wet geldt vanaf 1 januari 2027; 2027 is een overgangsjaar. Vanaf 1 januari 2028 mag u alleen inlenen van een uitlener met een toelating. Het register van de NAU kunt u raadplegen vanaf 1 juli 2027.',
    curanta: 'U legt per uitlener vast dat u de toelating controleerde: met datum, uitkomst en bewijs. Een koppeling met het register van de NAU is er niet.',
  },
  {
    datum: '2 december 2027',
    wet: 'AI-verordening (hoog risico)',
    wat: 'Vanaf dan gelden de extra eisen voor AI-systemen met een hoog risico uit bijlage III. Die datum is in 2026 uitgesteld; eerst was het 2 augustus 2026. Niet elke AI-toepassing in de zorg valt eronder.',
    curanta: 'Een register van de AI-systemen in Curanta. Alleen de kandidaatmatching bij werving is hoog risico; die staat standaard uit.',
  },
];
---
<Base
  image="/og/trust.png"
  title="Trust Centre: beveiliging, privacy en AVG | Curanta"
  description="De stand van beveiliging, privacy, koppelingen en wettelijke termijnen bij Curanta, per onderwerp: wat geregeld is en wat nog niet. Zonder NDA te lezen."
>
  <section class="border-b border-ink-200 bg-curanta-50">
    <div class="container-prose py-14 sm:py-16">
      <p class="eyebrow">Trust Centre · laatst herzien {HERZIEN}</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold text-curanta-900 sm:text-5xl">
        Beveiliging, privacy en koppelingen: de stand per onderwerp
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-700">
        Voor inkoop, de functionaris gegevensbescherming, de informatiebeveiliger en het bestuur.
        Per onderwerp ziet u wat geregeld is, wat in uitvoering is en wat nog niet is begonnen.
      </p>
      <p class="mt-3 max-w-2xl text-ink-700">
        Liever in gewone taal? Op de pagina <a href="/veiligheid" class="font-semibold text-curanta-700">Veiligheid</a>
        staat wat Curanta vanaf de eerste dag voor uw cliëntgegevens regelt, en wat bij u blijft.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3 text-sm">
        <a href="/procurement" class="btn-primary no-underline">Naar het inkoopdossier</a>
        <a href="mailto:trust@curanta.nl?subject=Beveiligingsdossier%20en%20verwerkersovereenkomst" class="btn-secondary no-underline">Vraag de verwerkersovereenkomst aan</a>
        <a href="https://app.curanta.nl/status" class="font-semibold text-curanta-700">Actuele status</a>
      </div>
      <nav class="mt-10 border-t border-ink-200 pt-6" aria-label="Onderwerpen op deze pagina">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          {pillars.map((p) => <li><a href={`#${p.key}`} class="text-curanta-700">{p.title}</a></li>)}
          <li><a href="#termijnen" class="text-curanta-700">Wettelijke termijnen</a></li>
          <li><a href="#continuiteit" class="text-curanta-700">Als Curanta wegvalt</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="container-prose grid gap-8 border-b border-ink-200 py-10 lg:grid-cols-2">
    <div>
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">Maatregelen van Curanta</h2>
      <ul class="mt-3 grid gap-2 text-sm text-ink-700 sm:grid-cols-2">
        {Object.values(STAND).map((s) => (
          <li class="flex items-center gap-2"><span class={`status-dot ${s.dot}`} aria-hidden="true"></span>{s.label}</li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">Functies en koppelingen</h2>
      <StatusLegenda class="mt-3" />
    </div>
  </section>

  {pillars.map((pillar) => (
    <section id={pillar.key} class="container-prose scroll-mt-20 border-b border-ink-200 py-14" aria-labelledby={`${pillar.key}-kop`}>
      <div class="grid gap-10 md:grid-cols-[260px_1fr]">
        <div>
          <h2 id={`${pillar.key}-kop`} class="font-display text-2xl font-bold text-curanta-900">{pillar.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-700">{pillar.intro}</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {pillar.items.map((item) => (
            <li class="rounded-xl bg-white p-4 ring-1 ring-ink-200">
              <h3 class="text-sm font-bold text-curanta-900">{item.label}</h3>
              {item.status ? (
                <StatusLabel status={item.status} class="mt-1" />
              ) : item.stand && (
                <span class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-ink-700">
                  <span class={`status-dot ${STAND[item.stand].dot}`} aria-hidden="true"></span>{STAND[item.stand].label}
                </span>
              )}
              <p class="mt-2 text-sm leading-snug text-ink-700">{item.note}</p>
              {item.doc && (
                <a href={item.doc} class="mt-2 inline-block text-xs font-semibold text-curanta-700">
                  Meer hierover<span class="sr-only">: {item.label}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section id="termijnen" class="scroll-mt-20 border-b border-ink-200 bg-curanta-50 py-14" aria-labelledby="termijnen-kop">
    <div class="container-prose">
      <div class="max-w-3xl">
        <h2 id="termijnen-kop" class="font-display text-2xl font-bold text-curanta-900 sm:text-3xl">Wettelijke termijnen 2026-2028</h2>
        <p class="mt-3 text-ink-700">
          Wat de wet vraagt, en waarbij Curanta helpt. Of een wet voor uw organisatie geldt, hangt af
          van uw omvang en uw zorg; dat stelt u zelf vast.
        </p>
      </div>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {termijnen.map((t) => (
          <li class="rounded-xl bg-white p-5 ring-1 ring-ink-200">
            <p class="text-sm font-bold text-accent-700">{t.datum}</p>
            <h3 class="mt-1 font-display text-lg font-bold text-curanta-900">{t.wet}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700">{t.wat}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-700"><span class="font-semibold text-ink-900">Curanta:</span> {t.curanta}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 max-w-4xl text-xs leading-relaxed text-ink-500">
        Bronnen, geraadpleegd op 8 oktober 2026: Staatsblad 2026, 187 en 189 (Cyberbeveiligingswet en
