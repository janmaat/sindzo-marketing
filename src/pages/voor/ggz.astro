---
import SegmentLayout from '../../layouts/SegmentLayout.astro';
// Herzien 08-10-2026 met wat in de week van 2–7 oktober is gebouwd (GDS801/GDS802, afscherming per
// cliënt, ROM-uitdraai, nota zonder contract, omzetplafonds, Wvggz). Nagelopen in de code; zie
// docs/feitenblad-voorstel-2026-10-08.md. SQ-48 en 4DKL staan er bewust als "in ontwikkeling".
---
<SegmentLayout
  image="/og/voor-ggz.png"
  segmentKey="ggz"
  segmentLabel="GGZ"
  title="GGZ-software — geestelijke gezondheidszorg | Curanta"
  description="GGZ-software: trajecten volgens het zorgprestatiemodel, declareren volgens Vektis, afscherming per cliënt en omzetplafonds, voor praktijk en instelling."
  eyebrow="Voor de GGZ"
  hero="Trajecten, declaratie en afscherming voor de GGZ"
  subtitle="Voor vrijgevestigde praktijken en GGZ-instellingen. De behandelaar registreert prestaties per traject. De administratie declareert volgens de standaard die Vektis voor declaraties aan zorgverzekeraars beheert, of stuurt een nota. De zorginhoud ziet alleen wie de cliënt behandelt."
  triggers={[
    { title: 'Declareren zonder overtikken', body: 'Het declaratiebericht (GDS801) volgt de standaard van Vektis. Curanta toetst het vóór verzending. Een afgewezen prestatie declareert u opnieuw; een toegekende crediteert u en declareert u gecorrigeerd. Versturen gaat via Vecozo, na aansluiting met uw certificaat.' },
    { title: 'Zorginhoud alleen voor de behandelaars', body: 'Een behandelrelatie volgt uit het rooster, de agenda of de rol van regiebehandelaar. Wie geen behandelrelatie met de cliënt heeft, ziet de zorginhoud niet. Noodtoegang kan, met een reden in het logboek. De administratie ziet alleen wat zij voor de declaratie nodig heeft.' },
    { title: 'Omzetplafonds in beeld', body: 'Per zorgverzekeraar en jaar ziet u hoe ver u bent. U krijgt een signaal bij 80, 90 en 100 procent, en een prognose tot het jaareinde.' },
    { title: 'Zorg zonder contract', body: 'Hebt u geen contract met de verzekeraar van een cliënt? Dan maakt Curanta een nota met de gegevens die de Nederlandse Zorgautoriteit (NZa) voorschrijft. Curanta verstuurt die nota per e-mail.' },
  ]}
  modules={[
    { name: 'Zorgprestatiemodel', note: 'Prestaties per traject, met controle op tarief, duur en datum' },
    { name: 'GDS801 en GDS802', note: 'Declareren en retourberichten volgens Vektis; versturen via Vecozo na aansluiting' },
    { name: 'Afscherming per cliënt', note: 'Op basis van de behandelrelatie, met noodtoegang' },
    { name: 'Omzetplafonds', note: 'Per verzekeraar en jaar, met signalen en prognose' },
    { name: 'ROM-uitdraai', note: 'Uitkomstmetingen van de behandeling (ROM) per periode, zonder vrije tekst; u levert zelf aan bij Akwa GGZ' },
    { name: 'SQ-48 en 4DKL', note: 'Vragenlijsten in ontwikkeling: wachten op toestemming van de rechthebbenden' },
    { name: 'Wet verplichte ggz', note: 'Vormen en titels met geldigheid, voor instellingen' },
    { name: 'Aanmelding en wachtlijst', note: 'Na aansluiting op ZorgDomein komt een geaccepteerde verwijzing op de wachtlijst' },
  ]}
  nogNiet={[
    'Een test bij Vecozo met de GGZ-declaratie; versturen vraagt uw Vecozo-certificaat.',
    'De vragenlijsten SQ-48 en 4DKL: wachten op toestemming van de rechthebbenden.',
    'Een rechtstreekse aanlevering van ROM-gegevens bij Akwa GGZ.',
    'Koppelingen met e-healthaanbieders.',
  ]}
  regulatory={['Wvggz', 'Wkkgz', 'Zorgprestatiemodel', 'AVG', 'NEN 7510']}
  proofPoints={[
    { value: 'GDS801', label: 'Volgens de standaard van Vektis, getoetst aan het schema' },
    { value: 'Per cliënt', label: 'Zorginhoud alleen voor wie behandelt' },
    { value: 'EU', label: 'Hosting bij IONOS in Berlijn' },
    { value: 'FHIR', label: 'API voor de Basisgegevensset Zorg (BgZ), alleen lezen, na registratie' },
  ]}
/>
