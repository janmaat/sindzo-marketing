---
import SegmentLayout from '../../layouts/SegmentLayout.astro';
// Herzien 08-10-2026 met wat in de week van 4–7 oktober is gebouwd (signaleringsplan, akkoord op het
// OPP in het portaal, verblijf met zzp, logeren, vpt, Wzd volgens de wet van 1-7-2025). Nagelopen in
// de code; zie docs/feitenblad-voorstel-2026-10-08.md.
---
<SegmentLayout
  image="/og/voor-ghz.png"
  segmentKey="ghz"
  segmentLabel="GHZ"
  title="Gehandicaptenzorg-software | Curanta"
  description="Software voor de gehandicaptenzorg: ondersteuningsplan met signaleringsplan, dagbesteding, verblijf en Wlz, Wzd en een portaal voor verwanten."
  eyebrow="Voor de gehandicaptenzorg"
  hero="Ondersteuningsplan, verblijf en de Wzd in één systeem"
  subtitle="Voor wonen, dagbesteding en ambulante begeleiding. De begeleider werkt vanuit het ondersteuningsplan (OPP) en het signaleringsplan, de administratie declareert verblijf en dagbesteding onder de Wlz, en de Wzd-functionaris houdt het stappenplan en de termijnen bij."
  triggers={[
    { title: 'De begeleider werkt vanuit het OPP', body: 'De begeleider begint op Vandaag met de eigen cliënten, rapporteert op de doelen uit het OPP en tekent af, ook in de app op de telefoon. In het verslag begeleiding staat per doel hoeveel rapportages er zijn.' },
    { title: 'Spanning op tijd zien', body: 'Het signaleringsplan beschrijft per fase (rust, spanning, crisis) de signalen en de afspraken. Incidenten sinds de vaststelling staan erbij, zodat het team ziet wanneer het plan herzien moet worden.' },
    { title: 'Verwanten lezen mee en geven akkoord', body: 'De mentor of vertegenwoordiger leest in het cliëntportaal het vrijgegeven OPP, het signaleringsplan en de verslagen, en geeft akkoord met een handtekening. Het akkoord komt met naam en relatie terug in het OPP.' },
    { title: 'Verblijf en logeren onder de Wlz', body: 'Opname, afwezigheid volgens de NZa en de maandproductie per etmaal, met de zorgzwaartepakketten van 2026. Logeren met de grens van 156 nachten en het volledig pakket thuis als leveringsvorm.' },
    { title: 'De Wzd volgens de wet van 2025', body: 'De vormen van onvrijwillige zorg, het stappenplan met termijnen, een zorgverantwoordelijke per cliënt, de juridische titel van het verblijf en beslissingen over verlof en ontslag. Het halfjaarlijkse overzicht voor de IGJ wordt gevalideerd tegen het schema van de IGJ; u levert het zelf aan via Mijn IGJ. Een echte aanlevering is er nog niet.' },
  ]}
  modules={[
    { name: 'Ondersteuningsplan (OPP) en AVB-verslag', note: 'Doelen per levensdomein, methodiek, akkoord in het portaal' },
    { name: 'Signaleringsplan', note: 'Fasen, signalen en afspraken; incidenten sinds de vaststelling' },
    { name: 'Groepszorg en dagbesteding', note: 'Aanwezigheid wordt een conceptregel voor de Wlz' },
    { name: 'Verblijf, zzp en logeren', note: 'Afwezigheid volgens de NZa; maandproductie per etmaal' },
    { name: 'Wlz-declaratie', note: 'Versturen via Vecozo na aansluiting; retourberichten zelf inlezen' },
    { name: 'CIZ-zorgprofiel', note: 'Naast de Wlz-toewijzing, met een waarschuwing bij verschil' },
    { name: 'Wet zorg en dwang', note: 'Stappenplan, titels, verlof en ontslag, overzicht voor de IGJ' },
    { name: 'Cliëntkas', note: 'Zakgeld en uitgaven per cliënt' },
  ]}
  nogNiet={[
    'Versturen van de Wlz-declaratie zonder Vecozo-certificaat van uw organisatie; retourberichten haalt u zelf op.',
    'Een echte aanlevering van het Wzd-overzicht bij de IGJ; u levert het zelf aan via Mijn IGJ.',
    'Ggz-wonen, toeslagen, deeltijdverblijf en mutatiedagen bij het verblijf.',
  ]}
  regulatory={['Wzd', 'Wlz', 'Wkkgz', 'Wtza', 'AVG', 'NEN 7510']}
  proofPoints={[
    { value: 'OPP', label: 'Met signaleringsplan en akkoord van de vertegenwoordiger' },
    { value: 'Wlz', label: 'Verblijf, logeren, vpt en mpt' },
    { value: 'Wzd', label: 'Wettekst van 1 juli 2025' },
    { value: 'EU', label: 'Hosting bij IONOS in Berlijn' },
  ]}
/>
