---
import Base from '../layouts/Base.astro';
import { DEMO_ZELF } from '../config/demo';

// Custom 404. .htaccess (Apache op de Strato-server) serveert dit
// automatisch als dist/404.html als een route niet matched.
// Astro genereert deze pagina als plain HTML; geen server-side logic.
---
<Base
  title="Pagina niet gevonden (404) | Curanta"
  noindex
  description="Deze pagina bestaat niet of is verplaatst. Hieronder de meest gezochte ingangen."
>
  <section class="container-prose py-20 sm:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow">Foutcode 404</span>
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tightish text-ink-900 sm:text-5xl md:text-6xl">
        Deze pagina bestaat niet (meer).
      </h1>
      <p class="mt-5 text-lg text-ink-700">
        Misschien is een link verouderd, hebben wij de pagina verplaatst of zit er een tikfout in het adres.
        Probeer een van de ingangen hieronder, of <a href="/contact" class="text-curanta-700 hover:underline">stuur ons een bericht</a>
        als u iets bepaalds zoekt.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class="btn-primary no-underline">Naar de startpagina</a>
        <a href="/oplossing" class="btn-secondary no-underline">Bekijk de oplossing</a>
      </div>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { title: 'Oplossing', body: 'Alle onderdelen, met per onderdeel de status.', href: '/oplossing' },
        { title: 'Voor wie', body: 'VVT, gehandicaptenzorg en GGZ.', href: '/voor' },
        { title: 'Koppelingen', body: 'Vecozo, ZorgMail, ZorgDomein, Medimo en meer, met de status per koppeling.', href: '/integraties' },
        { title: 'Trust Centre', body: 'De stand van beveiliging en privacy, zonder geheimhoudingsverklaring (NDA).', href: '/trust' },
        { title: 'Prijzen', body: 'Vier plannen, met prijs.', href: '/prijzen' },
        { title: DEMO_ZELF.label, body: 'Verzonnen cliënten, u kunt niets stukmaken.', href: DEMO_ZELF.href },
      ].map((card) => (
        <a href={card.href} class="rounded-xl border border-ink-100 bg-white p-5 no-underline transition hover:border-curanta-300 hover:shadow-sm">
          <h2 class="font-display text-base font-semibold text-ink-900">{card.title}</h2>
          <p class="mt-2 text-sm text-ink-700 leading-snug">{card.body}</p>
          <span class="mt-3 inline-block text-xs font-medium text-curanta-700">Open →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
