---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';

// Eigen indexpagina voor "Voor wie" — voorkomt dat de nav-link op subpagina's
// terugspringt naar #voor-wie op de homepage (gebroken navigatiepatroon).

const segments = [
  {
    label: 'VVT',
    title: 'Verpleging, verzorging & thuiszorg',
    pitch: 'Dossier, planning en medewerkerportaal voor wijk en verpleeghuis. De Wmo-maanddeclaratie en de Zvw zijn in ontwikkeling.',
    href: '/voor/vvt',
    accent: 'from-curanta-100 to-curanta-50',
  },
  {
    label: 'GHZ',
    title: 'Gehandicaptenzorg',
    pitch: 'Ondersteuningsplan met signaleringsplan, verblijf en logeren onder de Wlz, en de Wzd.',
    href: '/voor/ghz',
    accent: 'from-greensoft to-cream',
  },
  {
    label: 'Kraamzorg',
    title: 'Kraamzorg',
    pitch: 'Het kraamdossier met controles van moeder en kind per kraamdag en de overdracht aan de JGZ. Declaratie en planning nog niet.',
    href: '/voor/kraamzorg',
    accent: 'from-curanta-50 to-cream',
  },
  {
    label: 'Jeugdzorg',
    title: 'Jeugdzorg',
    pitch: 'Het jeugddossier met hulpvragen, toewijzingen en de meldcode voor de aandachtsfunctionaris. De maanddeclaratie nog niet.',
    href: '/voor/jeugdzorg',
    accent: 'from-greensoft to-cream',
  },
  {
    label: 'GGZ',
    title: 'Geestelijke gezondheidszorg',
    pitch: 'Trajecten volgens het zorgprestatiemodel, declareren volgens Vektis en afscherming per cliënt. E-healthkoppelingen zijn gepland.',
    href: '/voor/ggz',
    accent: 'from-curanta-50 to-cream',
  },
];
---
<Base
  title="Voor wie is Curanta? VVT, GHZ, GGZ, kraam- en jeugdzorg"
  description="Zorgsoftware voor VVT, gehandicaptenzorg en GGZ: één systeem voor dossier, planning, declaratie en kwaliteit. U zet alleen aan wat u nodig hebt."
>
  <PageHero
    eyebrow="Voor wie"
    title="Voor wie is Curanta gebouwd?"
    subtitle="Voor zorgorganisaties in de VVT, de gehandicaptenzorg, de GGZ, de kraamzorg en de jeugdzorg: één systeem voor dossier, planning, declaratie en kwaliteit. U zet alleen aan wat u nodig hebt, en later bijzetten kan zonder overstap."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="/oplossing" class="btn-primary no-underline">Bekijk modulekaart</a>
      <a href="/prijzen" class="btn-secondary no-underline">Prijzen</a>
    </div>
  </PageHero>

  <section class="container-prose py-16">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {segments.map((s) => (
        <a href={s.href} class="group relative overflow-hidden rounded-xl border border-ink-300 bg-white p-6 no-underline transition hover:border-curanta-300 hover:shadow-md">
          <div class={`absolute inset-x-0 top-0 h-24 -z-0 bg-gradient-to-b ${s.accent}`}></div>
          <div class="relative">
            <span class="text-xs font-semibold uppercase tracking-wider text-curanta-700">{s.label}</span>
            <h2 class="mt-3 font-display text-lg font-semibold text-ink-900">{s.title}</h2>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{s.pitch}</p>
            <span class="mt-5 inline-block text-sm font-medium text-curanta-700 transition group-hover:translate-x-0.5">
              Naar segmentpagina →
            </span>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-8 text-sm text-ink-500 max-w-3xl">
      <strong class="text-ink-700">Eerstelijnszorg (huisartsen)</strong> — Curanta heeft geen HIS en bouwt er
      nu geen. Voor de samenwerking met de huisarts zijn ZorgMail en ZorgDomein gebouwd.
    </p>
  </section>

  <Cta />
</Base>
