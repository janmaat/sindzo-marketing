    link: { label: 'Alle onderdelen van het dossier', href: '/oplossing#ecd' },
    beelden: [
      {
        src: rapportage,
        alt: 'Medewerkerportaal: het scherm Rapportage schrijven bij een bezoek, met de problemen uit het zorgplan om aan te koppelen en velden voor subjectief, objectief en evaluatie.',
        adres: 'medewerker.curanta.nl',
        bijschrift: 'Medewerkerportaal: rapportage bij een bezoek, gekoppeld aan een probleem uit het zorgplan. Opname oktober 2026.',
