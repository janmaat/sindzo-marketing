---
// Een lichtstreep die langs de rand van het omringende vlak loopt, naar BorderBeam van Magic UI
// (magicui.design, MIT-licentie). Het origineel animeert met motion/react; dit is dezelfde techniek
// (offset-path over de rand, een masker dat alleen de rand doorlaat) in alleen CSS — zie
// `.border-beam` in global.css. Zet hem als laatste kind in een element met `relative` en een
// afgeronde hoek; hij erft die hoek. Zonder ondersteuning voor offset-path, of bij
// "beweging beperken", toont hij niets.
interface Props {
  /** Lengte van de streep in px. */
  lengte?: number;
  /** Tijd voor één rondje in seconden. */
  duur?: number;
  /** Dikte van de rand in px. */
  dikte?: number;
  /** Start halverwege het rondje in plaats van linksboven (0–100). */
  start?: number;
}
const { lengte = 180, duur = 9, dikte = 2, start = 0 } = Astro.props;
---
<span
  class="border-beam"
  aria-hidden="true"
  style={`--beam-lengte:${lengte}px;--beam-duur:${duur}s;--beam-dikte:${dikte}px;--beam-start:-${(duur * start) / 100}s`}
></span>
