---
import Nav from '../components/Nav.astro';
import EarlyAccessBanner from '../components/EarlyAccessBanner.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  /** Houdt de pagina uit de zoekresultaten (bedankt, 404). Zonder canonical: die zou naar een pagina wijzen die er niet in hoort. */
  noindex?: boolean;
  /** 'article' voor kennisbankartikelen; de rest is 'website'. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Curanta — één zorgsuite voor dossier, planning, declaratie en kwaliteit. Bewust open, aantoonbaar veilig, gebouwd voor de Nederlandse zorgpraktijk.',
  canonical,
  image = '/og.png',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Curanta',
  url: Astro.site?.toString() ?? 'https://curanta.nl',
  logo: new URL('/logo/curanta-logo.svg', Astro.site).toString(),
  description: 'Eén modulair zorgplatform voor de Nederlandse VVT, gehandicaptenzorg en GGZ — dossier, planning, declaratie, kwaliteit, meertalig cliëntportaal (5 talen) en welzijn-modules voor medewerkers.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Marshallstraat 26',
    postalCode: '5705 CN',
    addressLocality: 'Helmond',
    addressRegion: 'Noord-Brabant',
    addressCountry: 'NL',
  },
  foundingLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressCountry: 'NL' }},
  areaServed: { '@type': 'Country', name: 'Nederland' },
  knowsAbout: [
    'Elektronisch Cliëntdossier (ECD)',
    'FHIR R4',
    'NEN 7510',
    'NIS2 / Cyberbeveiligingswet',
    'Meertalig cliëntportaal',
    'Wegiz eOverdracht',
    'MedMij',
    'iWmo iJw iWlz',
    'ZPM-declaratie GGZ',
    'Peer-support voor zorgmedewerkers',
    'AVG / DPIA',
  ],
  knowsLanguage: ['nl', 'en', 'tr', 'ar', 'de', 'pl', 'uk'],
  email: 'hello@curanta.nl',
  telephone: '+31611746283',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: '+31611746283',
      email: 'hello@curanta.nl',
      areaServed: 'NL',
      availableLanguage: ['Dutch', 'English'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'security',
      email: 'trust@curanta.nl',
      areaServed: 'NL',
      availableLanguage: ['Dutch', 'English'],
    },
  ],
};
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url} />}
    <meta property="og:site_name" content="Curanta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E4F57" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgLd)} />
    {/* Het merkfont staat zelf gehost in /fonts (zie global.css); preload van de latin-subset
        zodat de eerste weergave niet op de CSS hoeft te wachten om hem te ontdekken. */}
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/*
      Plausible Analytics — cookie-loos, EU-gehost (geen GA, geen tracker-popups).
      Alleen in productie laden zodat dev-traffic geen statistiek vervuilt.
    */}
    {import.meta.env.PROD && (
      <script defer data-domain="curanta.nl" src="https://plausible.io/js/script.outbound-links.js"></script>
      <script is:inline set:html={`window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }`} />
    )}
    {/*
      Eigen bezoekersmeting — cookieloos; de cijfers staan in de backoffice op
      app.curanta.nl/admin/bezoekers. Script en endpoint leven in Curanta.Host, dus wijzigingen
      aan de meting gaan mee met een uitrol daarvan. Alleen in productie: het endpoint neemt ook
      localhost aan, anders telt `npm run dev` mee in de echte cijfers.
    */}
    {import.meta.env.PROD && (
      <script src="https://app.curanta.nl/bezoekmeting.js" defer></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    {/* Skip-link voor keyboard-users — verbergt visueel, verschijnt op focus. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-curanta-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:no-underline focus:outline focus:outline-2 focus:outline-accent-500"
    >
      Direct naar inhoud
    </a>
    <EarlyAccessBanner />
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    {/*
      Campagnebron meenemen zonder iets op het apparaat op te slaan. Wie via een advertentie
      binnenkomt (…?utm_source=google&gclid=…), klikt zelden meteen op "Demo aanvragen"; meestal
      eerst naar prijzen of een segmentpagina. Daarom krijgen alle interne links op de pagina
      dezelfde campagneparameters mee, tot en met het demoformulier. Geen cookie, geen
      localStorage — de belofte op /cookies blijft staan. De canonical wijst altijd naar de URL
      zonder parameters, dus voor zoekmachines verandert er niets.
    */}
    <script is:inline>
      (function () {
        var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'];
        var here = new URLSearchParams(window.location.search);
        var carry = keys.filter(function (k) { return here.get(k); });
        if (!carry.length) return;
        document.querySelectorAll('a[href^="/"]').forEach(function (a) {
          var href = a.getAttribute('href');
          if (href.indexOf('//') === 0 || /\.[a-z0-9]{2,5}($|[?#])/i.test(href)) return;
          var url = new URL(href, window.location.origin);
          carry.forEach(function (k) { if (!url.searchParams.has(k)) url.searchParams.set(k, here.get(k)); });
          a.setAttribute('href', url.pathname + url.search + url.hash);
        });
      })();
    </script>
  </body>
</html>
