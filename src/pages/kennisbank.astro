---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';

// Kennisbank zonder artikelen (25-09-2026). De twee artikelen (meertalig cliëntportaal en
// peer-support) zijn offline gehaald: ze noemden een wet die niet meer bestaat, een
// retentiecijfer dat niet terug te vinden was en arbeidsmarktcijfers zonder bron. Ze worden op
// een eigen branch herschreven. Het feitenblad staat alleen bestaande artikelen toe, geen
// aankondigingen, en artikelen alleen met nagetrokken wetten en cijfers met bron.
//
// Keuze: de pagina blijft bestaan (de oude artikeladressen verwijzen hierheen, zie
// public/.htaccess), maar verdwijnt uit de footer en de sitemap en staat op noindex.
// Een lege kennisbank in het menu oogt leger dan geen kennisbank. Wie hier via een oude link
// landt, krijgt een eerlijke uitleg en de pagina's waar de onderbouwing nu wél staat.
// Komen er artikelen terug: noindex weghalen, footerlink en sitemap herstellen.

const verder = [
  { title: 'Trust Centre', body: 'De stand van beveiliging, privacy en koppelingen, per onderwerp met een eerlijke status.', href: '/trust' },
  { title: 'Vergelijking', body: 'Curanta naast Nedap Ons, PinkRoccade myNeva en Pluriform Zorg, met peildatum en bron.', href: '/vergelijking' },
  { title: 'Architectuurbesluiten', body: 'Waarom Curanta bouwt zoals het bouwt, met de afweging erbij.', href: '/adr' },
];
---
<Base
  title="Kennisbank | Curanta"
  description="De kennisbank van Curanta heeft op dit moment geen artikelen. De onderbouwing staat in het Trust Centre, de vergelijking en de architectuurbesluiten."
  noindex
>
  <PageHero
    eyebrow="Kennisbank"
    title="Op dit moment staan hier geen artikelen."
    subtitle="Wij publiceren een artikel pas als de wetten en cijfers erin zijn nagetrokken, met bron. De onderbouwing van wat Curanta doet, vindt u intussen op de pagina's hieronder."
  />

  <section class="container-prose py-14">
    <ul class="grid gap-4 md:grid-cols-3">
      {verder.map((a) => (
        <li>
          <a href={a.href} class="group block h-full rounded-xl border border-ink-100 bg-white p-5 no-underline transition hover:border-curanta-300 hover:shadow-sm">
            <h2 class="font-display text-base font-semibold text-ink-900 group-hover:text-curanta-700 transition">{a.title}</h2>
            <p class="mt-2 text-sm text-ink-700 leading-snug">{a.body}</p>
            <span class="mt-3 inline-block text-xs font-semibold text-curanta-700">Naar {a.title === 'Trust Centre' ? 'het Trust Centre' : `de ${a.title.toLowerCase()}`} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Cta />
</Base>
