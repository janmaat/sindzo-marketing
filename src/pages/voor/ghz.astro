---
import SegmentLayout from '../../layouts/SegmentLayout.astro';
import { CYBERBEVEILIGINGSWET } from '../../config/kennisbank';
import beeld from '../../assets/schermen/bo-signaleringsplan.jpg';
// Herzien 08-10-2026 met wat in de week van 4–7 oktober is gebouwd (signaleringsplan, akkoord op het
// OPP in het portaal, verblijf met zzp, logeren, vpt, Wzd volgens de wet van 1-7-2025). Nagelopen in
// de code; zie docs/feitenblad-voorstel-2026-10-08.md.
---
<SegmentLayout
  beeld={{ src: beeld, adres: 'app.curanta.nl', alt: 'Backoffice: het signaleringsplan van een verzonnen cliënt, met een melding over een incident sinds de vaststelling en per fase rust, spanning en crisis de signalen, wat de cliënt doet en wat de begeleider doet.', bijschrift: 'Het signaleringsplan, met het incident sinds de vaststelling. Opname oktober 2026.' }}
  image="/og/voor-ghz.png"
  segmentKey="ghz"
  segmentLabel="GHZ"
  title="Software gehandicaptenzorg: ondersteuningsplan | Curanta"
  description="Software voor de gehandicaptenzorg: ondersteuningsplan met signaleringsplan, dagbesteding, verblijf en Wlz, Wzd en een portaal voor verwanten."
  eyebrow="Voor de gehandicaptenzorg"
  hero="Ondersteuningsplan, verblijf en de Wzd in één systeem"
  subtitle="Voor wonen, dagbesteding en ambulante begeleiding. De begeleider werkt vanuit het ondersteuningsplan (OPP) en het signaleringsplan. De administratie declareert verblijf en dagbesteding onder de Wet langdurige zorg (Wlz). De Wzd-functionaris houdt het stappenplan en de termijnen van de Wet zorg en dwang (Wzd) bij."
  triggers={[
    { title: 'De begeleider werkt vanuit het OPP', body: 'De begeleider begint op het scherm Vandaag met de eigen cliënten. Daar rapporteert de begeleider op de doelen uit het OPP en tekent af, ook in de app op de telefoon. In het verslag begeleiding staat per doel hoeveel rapportages er zijn.' },
    { title: 'Spanning op tijd zien', body: 'Het signaleringsplan beschrijft per fase (rust, spanning, crisis) de signalen en de afspraken. Incidenten sinds de vaststelling staan erbij, zodat het team ziet wanneer het plan herzien moet worden.' },
    { title: 'Verwanten lezen mee en geven akkoord', body: 'De mentor of vertegenwoordiger leest in het cliëntportaal het vrijgegeven OPP, het signaleringsplan en de verslagen. Akkoord geven gaat met een handtekening. Het akkoord komt met naam en relatie terug in het OPP.' },
    { title: 'Verblijf en logeren onder de Wlz', body: 'Opname, afwezigheid volgens de Nederlandse Zorgautoriteit (NZa) en de maandproductie per etmaal, met de zorgzwaartepakketten (zzp) van 2026. Logeren met de grens van 156 nachten en het volledig pakket thuis als leveringsvorm.' },
    { title: 'Het bestuur en de Cyberbeveiligingswet', body: 'Een zorgaanbieder vanaf 50 fte valt onder de Cyberbeveiligingswet, en het bestuur keurt de maatregelen zelf goed. In Curanta staan de tien onderwerpen van de zorgplicht op één plek. Het bestuur stelt ze vast en houdt een leveranciersregister bij, met Curanta zelf erin. Incidenten registreert u met de meldtermijnen van 24 uur, 72 uur en een maand.' },
    { title: 'De Wzd volgens de wet van 2025', body: 'De vormen van onvrijwillige zorg, het stappenplan met termijnen, een zorgverantwoordelijke per cliënt, de juridische titel van het verblijf en beslissingen over verlof en ontslag. Curanta toetst het halfjaarlijkse overzicht voor de Inspectie Gezondheidszorg en Jeugd (IGJ) aan het schema van de IGJ. U levert het zelf aan via Mijn IGJ. Een echte aanlevering is er nog niet.' },
  ]}
  modules={[
    { name: 'Ondersteuningsplan (OPP) en verslag begeleiding (AVB)', note: 'Doelen per levensdomein, methodiek, akkoord in het portaal' },
    { name: 'Signaleringsplan', note: 'Fasen, signalen en afspraken; incidenten sinds de vaststelling' },
    { name: 'Groepszorg en dagbesteding', note: 'Aanwezigheid wordt een conceptregel voor de Wlz' },
    { name: 'Verblijf, zzp en logeren', note: 'Afwezigheid volgens de NZa; maandproductie per etmaal; deeltijdverblijf en mutatiedagen' },
    { name: 'Toeslagen, meerzorg en vervoer', note: 'Met het kenmerk van het zorgkantoor; vervoer naar de dagbesteding per aanwezigheidsdag' },
    { name: 'Medewerkerportaal voor wonen en dagbesteding', note: 'Wzd vastleggen, aanwezigheid aftekenen, slaap- en bereikbaarheidsdiensten in het rooster met de cao Gehandicaptenzorg' },
    { name: 'Behandeldienst', note: 'Fysiotherapie, ergotherapie, logopedie en diëtetiek naast het wonen; de behandeluren verantwoorden, niet declareren' },
    { name: 'Wlz-declaratie', note: 'Berichten en maanddeclaratie opstellen; u levert ze zelf aan bij het zorgkantoor' },
    { name: 'CIZ-zorgprofiel', note: 'Het profiel van het Centrum indicatiestelling zorg naast de Wlz-toewijzing, met een waarschuwing bij verschil' },
    { name: 'Wet zorg en dwang', note: 'Stappenplan, titels, verlof en ontslag, overzicht voor de IGJ' },
    { name: 'Cliëntkas', note: 'Zakgeld en uitgaven per cliënt' },
    { name: 'Cyberbeveiligingswet voor het bestuur', note: 'Zorgplicht, vaststelling, leveranciersregister en meldtermijnen' },
  ]}
  vragen={[
    // Zoekterm 'ondersteuningsplan gehandicaptenzorg voorbeeld' (Search Console 22-10, positie 13). Alles staat al op deze pagina.
    { vraag: 'Hoe ziet een ondersteuningsplan in Curanta eruit?', antwoord: 'Het ondersteuningsplan (OPP) heeft doelen per levensdomein, met de methodiek. De begeleider rapporteert op die doelen, en in het verslag begeleiding staat per doel hoeveel rapportages er zijn. Naast het OPP staat het signaleringsplan, met per fase (rust, spanning, crisis) de signalen en de afspraken. De mentor of vertegenwoordiger leest het vrijgegeven OPP in het cliëntportaal en geeft akkoord met een handtekening.' },
    { vraag: 'Hoe gaat de Wlz-declaratie naar het zorgkantoor?', antwoord: 'Curanta maakt de iWlz-berichten en de Wlz-declaratie (AW319). Rechtstreeks aanleveren via VECOZO is ingericht, met het ophalen van de retourberichten; wij beproeven het per organisatie in de testomgeving van VECOZO, vóór uw eerste declaratiemaand. Tot dan levert u de bestanden met de hand aan.' },
    { vraag: 'Ondersteunt Curanta de Wet zorg en dwang?', antwoord: 'Ja, volgens de wet van 2025: de vormen van onvrijwillige zorg, het stappenplan met termijnen en een zorgverantwoordelijke per cliënt. Curanta toetst het halfjaarlijkse overzicht voor de IGJ aan het schema van de IGJ. U levert het zelf aan via Mijn IGJ.' },
  ]}
  nogNiet={[
    'De proef van het rechtstreeks aanleveren in de testomgeving van VECOZO: die doen wij per organisatie, vóór uw eerste declaratiemaand.',
    'Een echte aanlevering van het Wzd-overzicht bij de IGJ; u levert het zelf aan via Mijn IGJ.',
    'Meerzorg bij ggz-wonen en ggz-b, en toeslagen voor dagbesteding van een kind per dagdeel.',
    'Deeltijdverblijf in de vv.',
  ]}
  artikelen={[CYBERBEVEILIGINGSWET]}
  regulatory={['Wzd', 'Wlz', 'Wkkgz', 'Wtza', 'AVG', 'NEN 7510']}
  proofPoints={[
    { value: 'OPP', label: 'Met signaleringsplan en akkoord van de vertegenwoordiger' },
    { value: 'Wlz', label: 'Verblijf, logeren, volledig en modulair pakket thuis (vpt en mpt)' },
    { value: 'Wzd', label: 'Wettekst van 1 juli 2025' },
    { value: 'EU', label: 'Hosting in Duitsland, versleuteld opgeslagen' },
  ]}
/>
