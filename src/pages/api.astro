---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';

// /api — eerlijke stand van de FHIR-laag. Er is (28-09-2026) geen publiek endpoint, geen
// API-sleutel, geen sandbox en geen OAuth2-toegang voor derden (feitenblad, rij API): de resources hieronder bouwt de
// BgZ-module intern (Ponscura.Integratie.BgZ, projectors). Beloof hier niets wat daar
// niet staat.

const resources = [
  { name: 'Patient', desc: 'Cliëntdemografie en contactgegevens — Zib-profiel.', status: 'live' },
  { name: 'Encounter', desc: 'Zorgmoment/contact — episode of care-context.', status: 'live' },
  { name: 'Observation', desc: 'Vitale functies.', status: 'live' },
  { name: 'MedicationStatement / MedicationRequest', desc: 'Medicatie-overzicht en voorschriften.', status: 'live' },
  { name: 'Condition', desc: 'Probleem-/diagnoseregistratie.', status: 'live' },
  { name: 'AllergyIntolerance', desc: 'Allergieën en intoleranties.', status: 'live' },
  { name: 'RelatedPerson', desc: 'Mantelzorger, wettelijk vertegenwoordiger, contactpersonen.', status: 'live' },
  { name: 'CarePlan', desc: 'Zorgplan — Omaha gemapped.', status: 'live' },
  { name: 'Practitioner / PractitionerRole', desc: 'Behandelaar en zijn rol.', status: 'live' },
];

const dot = (s: string) =>
  s === 'live' ? 'bg-green-500' : s === 'wip' ? 'bg-amber-500' : 'bg-ink-300';
---
<Base
  title="API en FHIR: stand van zaken | Curanta"
  description="Er is nog geen publieke API. FHIR met Nederlandse Zib-profielen is intern gebouwd voor de BgZ; een publieke FHIR-API is in ontwikkeling. De eerlijke stand van zaken."
>
  <PageHero
    eyebrow="API en koppelen"
    title="FHIR met Zib-profielen: de stand van zaken."
    subtitle="Voor I&A en ketenpartners. Curanta zet dossiergegevens intern om naar FHIR met Nederlandse Zib-profielen — de basis voor de BgZ en de eOverdracht. Er is nog geen publieke API: geen endpoint voor externe partijen, geen API-sleutel en geen testomgeving. Een publieke FHIR-API is in ontwikkeling."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="mailto:info@curanta.nl?subject=API%3A%20stand%20van%20zaken" class="btn-primary no-underline">Vraag de stand van zaken</a>
      <a href="/integraties" class="btn-secondary no-underline">Overzicht koppelingen</a>
    </div>
  </PageHero>

  <section class="container-prose py-12 border-b border-ink-100 bg-ink-100/40">
    <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-5 max-w-3xl">
      <div class="text-xs font-extrabold uppercase tracking-[0.15em] text-amber-900">Nog geen publieke API</div>
      <p class="mt-2 text-sm text-ink-700 leading-relaxed">
        Er is nog geen publieke API: geen endpoint voor externe partijen, geen API-sleutel en geen testomgeving. Een publieke FHIR-API is in ontwikkeling. De endpoints van Curanta zijn er alleen voor de eigen portalen en voor de koppelingen die wij zelf bouwen.
        Wilt u weten wat er wel is? Mail
        <a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a> —
        wij reageren binnen 1 werkdag, geen NDA nodig.
      </p>
    </div>
  </section>

  <section class="container-prose py-14 border-b border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">FHIR-resources (intern)</h2>
    <p class="mt-2 text-sm text-ink-700 max-w-2xl">
      Deze resources bouwt Curanta intern uit het dossier voor de BgZ-bundel, gemapt op de Nederlandse
      Zorginformatiebouwstenen (Zib's) waar die bestaan. Nog niet alle onderdelen van de BgZ worden
      gevuld, en geen van deze resources is al via een publiek endpoint op te vragen. Groen betekent
      hier: intern gebouwd voor de BgZ.
    </p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {resources.map((r) => (
        <li class="flex items-start gap-3 rounded-lg border border-ink-100 bg-white p-4">
          <span class={`status-dot mt-1.5 shrink-0 ${dot(r.status)}`}></span>
          <div>
            <div class="text-sm font-semibold text-ink-900">{r.name}</div>
            <div class="mt-0.5 text-xs text-ink-500">{r.desc}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-prose py-14 border-b border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">Hoe wij FHIR gebruiken</h2>
    <p class="mt-2 text-sm text-ink-700 max-w-3xl leading-relaxed">
      FHIR is bij ons het uitwisselingsformaat aan de grens met de keten; intern blijft de opslag
      relationeel (zie <a href="/adr" class="text-curanta-700 hover:underline">ADR-002</a>). Een volledige
      export van uw gegevens en bestanden krijgt u los daarvan in JSON, zonder exit-fee — zie <a href="/overstappen#eruit" class="text-curanta-700 hover:underline">Overstappen en exit</a>.
    </p>
  </section>

  <Cta
    title="Implementatiepartner of ketenleverancier?"
    subtitle="Wij denken graag mee over uw koppeling, en laten u weten wanneer de publieke FHIR-API en een testomgeving klaarstaan."
    primary={{ label: 'Mail ons over de API', href: 'mailto:info@curanta.nl?subject=API' }}
    secondary={{ label: 'Overzicht koppelingen', href: '/integraties' }}
  />
</Base>
