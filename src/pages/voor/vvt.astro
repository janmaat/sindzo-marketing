  triggers={[
    { title: 'Arbeidsmarktkrapte', body: 'ActiZ verwacht structurele tekorten tot 2030. Curanta verlaagt de admin-last per dienst zodat zorgmedewerkers meer tijd aan cliënten besteden — én blijven.' },
    { title: 'Intra- vs. extramurale versnippering', body: 'Eén dossier voor verpleeghuis én wijk. Eén identiteit per cliënt, één route, één rapportage — ongeacht waar zorg geleverd wordt.' },
    { title: 'Regeldruk via het ECD', body: 'Berenschot voor VWS (meting 2025): 34% van de werktijd gaat naar administratie, terwijl zorgprofessionals zelf 23% acceptabel vinden. In de meting van 2022 noemde 54% het aanmaken en bijhouden van het dossier de meest tijdrovende taak. Curanta dringt dat terug met SOEP-pre-fill, spraak-rapportage en een logische dossierstructuur.' },
    { title: 'eOverdracht & Wegiz', body: 'Overdracht naar ziekenhuis, huisarts of vervolgzorg via de BgZ in plaats van printen en faxen. De BgZ-bundel bouwt Curanta al; de aansluiting voor de eOverdracht is in ontwikkeling.' },
    { title: 'Diverse cliëntenpopulatie', body: 'De 1e-generatie Turkse en Marokkaanse VVT-cliënten beheersen vaak onvoldoende Nederlands voor formele portaal-teksten. Curanta Naast is in 7 talen (NL/EN/TR/AR/DE + PL/UK) — uniek in NL-VVT volgens onze marktscan (mei 2026).' },
  ]}
  modules={[
    { name: 'Cliëntdossier + zorgplan', note: 'Omaha + episode of care, BSN-encrypted' },
