---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Hub-pagina voor drie portalen. Vermijdt verwarring: één Inloggen-knop in
// de Nav, gebruiker kiest hier welk portaal hij/zij nodig heeft. Bij directe
// kennis van het portaal kan iemand ook rechtstreeks naar bv. medewerker.curanta.nl.
// Namen en doelgroepen zoals in het feitenblad: backoffice, medewerkerportaal, cliëntportaal.
// UZI-inloggen is gebouwd, maar pas beschikbaar als de UZI-hostnaam op de server is ingericht
// (feitenblad, rij UZI). Tot dan staat het hier niet.

const portals = [
  {
    audience: 'Planning, dossier, declaratie, beheer',
    title: 'Backoffice',
    body: 'Voor planners, teamleiders, zorgverleners in de backoffice, zorgadministratie, kwaliteit, beheer en management.',
    href: 'https://app.curanta.nl/login',
    cta: 'Open app.curanta.nl',
    icon: '🗂️',
  },
  {
    audience: 'Zorgmedewerkers onderweg',
    title: 'Medewerkerportaal',
    body: 'Voor de zorgmedewerker onderweg: rooster, bezoeken met SOEP-rapportage en verlof, en met de volledige planning ook uren en ruilen. Ook op de telefoon.',
    href: 'https://medewerker.curanta.nl/',
    cta: 'Open medewerker.curanta.nl',
    icon: '👩‍⚕️',
  },
  {
    audience: 'Cliënten en mantelzorgers',
    title: 'Cliëntportaal',
    body: 'Voor cliënten, mantelzorgers en familie: berichten, documenten, machtigingen, taken en het eigen zorgplan inzien.',
    href: 'https://klant.curanta.nl/',
    cta: 'Open klant.curanta.nl',
    icon: '🏠',
  },
];
---
<Base
  title="Inloggen — kies uw portaal | Curanta"
  description="Drie portalen: app.curanta.nl (backoffice), medewerker.curanta.nl voor zorgmedewerkers onderweg, klant.curanta.nl voor cliënten en mantelzorgers."
>
  <PageHero
    eyebrow="Inloggen"
    title="Welk portaal heeft u nodig?"
    subtitle="Curanta heeft drie aparte portalen voor verschillende gebruikers. Kies hieronder, of ga rechtstreeks naar het adres als u dat kent."
  />

  <section class="container-prose py-12">
    <div class="grid gap-5 md:grid-cols-3">
      {portals.map((p) => (
        <a
          href={p.href}
          class="group rounded-2xl border border-ink-200 bg-white p-6 no-underline transition hover:border-curanta-300 hover:shadow-md"
        >
          <div class="text-3xl" aria-hidden="true">{p.icon}</div>
          <div class="mt-4 text-xs font-semibold uppercase tracking-wider text-accent-700">{p.audience}</div>
          <h2 class="mt-1 font-display text-xl font-semibold text-ink-900">{p.title}</h2>
          <p class="mt-2 text-sm text-ink-700 leading-relaxed">{p.body}</p>
          <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-curanta-700 transition group-hover:translate-x-0.5">
            {p.cta} →
          </span>
        </a>
      ))}
    </div>

    <div class="mt-12 rounded-xl border border-ink-100 bg-ink-100/40 p-6 max-w-3xl">
      <h2 class="font-display text-base font-semibold text-ink-900">Weet u niet welk portaal?</h2>
      <p class="mt-2 text-sm text-ink-700">
        Werkt u <strong>bij</strong> een zorgaanbieder die Curanta gebruikt? Vraag uw beheerder
        om een uitnodiging; dan komt u in het juiste portaal terecht. Bent u <strong>cliënt of mantelzorger</strong>?
        De uitnodiging komt van de zorgaanbieder, niet rechtstreeks van Curanta.
      </p>
      <p class="mt-3 text-sm text-ink-500">
        Vragen? Mail <a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a>
        of bel <a href="tel:+31852501301" class="text-curanta-700 hover:underline">085 250 1301</a>.
      </p>
    </div>
  </section>
</Base>
