---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { LINKEDIN_BEDRIJFSPAGINA } from '../config/linkedin';
import { KRUIMELNAMEN } from '../config/kruimels';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  /** Houdt de pagina uit de zoekresultaten (bedankt, 404). Zonder canonical: die zou naar een pagina wijzen die er niet in hoort. */
  noindex?: boolean;
  /** 'article' voor kennisbankartikelen; de rest is 'website'. */
  ogType?: 'website' | 'article';
  /**
   * Alleen op de 404-pagina: 'niet-gevonden'. Beide metingen tellen de pagina dan als niet gevonden en
   * niet als gewone weergave: app.curanta.nl/bezoekmeting.js leest `curanta-pagina`,
   * statistiek.curanta.nl/m.js leest `bezoekmeting-pagina`. Zonder tag vallen ze terug op "404" in
   * de titel.
   */
  paginasoort?: 'niet-gevonden';
}

const {
  title,
  description = 'Curanta: één systeem voor dossier, planning, declaratie en kwaliteit in de VVT, gehandicaptenzorg en GGZ. Vanaf €19 per medewerker per maand.',
  canonical,
  image = '/og.png',
  noindex = false,
  ogType = 'website',
  paginasoort,
} = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Curanta',
  url: Astro.site?.toString() ?? 'https://curanta.nl',
  logo: new URL('/logo/curanta-logo.svg', Astro.site).toString(),
  description: 'Eén modulair zorgplatform voor de Nederlandse VVT, gehandicaptenzorg en GGZ: dossier, planning, declaratie, kwaliteit, meertalig cliëntportaal (5 talen) en welzijn-modules voor medewerkers.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Marshallstraat 26',
    postalCode: '5705 CN',
    addressLocality: 'Helmond',
    addressRegion: 'Noord-Brabant',
    addressCountry: 'NL',
  },
  foundingLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressCountry: 'NL' }},
  areaServed: { '@type': 'Country', name: 'Nederland' },
  knowsAbout: [
    'Elektronisch Cliëntdossier (ECD)',
    'FHIR',
    'NEN 7510',
    'NIS2 / Cyberbeveiligingswet',
    'Meertalig cliëntportaal',
    'Wegiz eOverdracht',
    'MedMij',
    'iWmo iJw iWlz',
    'ZPM-declaratie GGZ',
    'Peer-support voor zorgmedewerkers',
    'AVG / DPIA',
  ],
  // De talen waarin Curanta als organisatie communiceert (gelijk aan availableLanguage hieronder),
  // niet de vijf talen van het cliëntportaal.
  knowsLanguage: ['nl', 'en'],
  email: 'info@curanta.nl',
  telephone: '+31852501301',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: '+31852501301',
      email: 'info@curanta.nl',
      areaServed: 'NL',
      availableLanguage: ['Dutch', 'English'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'security',
      email: 'trust@curanta.nl',
      areaServed: 'NL',
      availableLanguage: ['Dutch', 'English'],
    },
  ],
  // Koppelt de site aan het profiel van de organisatie elders (skill site-inhoudscontrole, Vindbaarheid).
  ...(LINKEDIN_BEDRIJFSPAGINA ? { sameAs: [LINKEDIN_BEDRIJFSPAGINA] } : {}),
};

// Kruimelpad (BreadcrumbList), afgeleid uit het pad: /voor/ggz → Curanta › Voor wie › GGZ. Niet op de homepage en
// niet op pagina's met noindex. Namen uit src/config/kruimels.ts; de laatste kruimel valt terug op de paginatitel.
const delen = Astro.url.pathname.split('/').filter(Boolean);
const titelZonderMerk = title.replace(/\s*\|\s*Curanta\s*$/, '');
const kruimelLd = !noindex && delen.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Curanta', item: new URL('/', Astro.site).toString() },
    ...delen.map((deel, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: KRUIMELNAMEN[deel] ?? (i === delen.length - 1 ? titelZonderMerk : deel),
      item: new URL('/' + delen.slice(0, i + 1).join('/'), Astro.site).toString(),
    })),
  ],
} : null;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url} />}
    {paginasoort && <meta name="curanta-pagina" content={paginasoort} />}
    {paginasoort && <meta name="bezoekmeting-pagina" content={paginasoort} />}
    <meta property="og:site_name" content="Curanta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E4F57" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgLd)} />
    {kruimelLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(kruimelLd)} />}
    {/* Het merkfont staat zelf gehost in /fonts (zie global.css); preload van de latin-subset
        zodat de eerste weergave niet op de CSS hoeft te wachten om hem te ontdekken. */}
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* Zet de inloopanimatie (BlurFade, zie global.css) pas aan als de browser kan zien wat in
        beeld komt. In de head, zodat een blok niet eerst zichtbaar is en dan verdwijnt. */}
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('reveal-aan');
    </script>
    {/*
      Eigen bezoekersmeting (geen meetdienst van derden; besluit Jan 25-09-2026, zie het feitenblad).
      Sinds 04-11-2026 (besluit Jan) draaien er twee naast elkaar, een paar weken lang; daarna vergelijken en
      de oude weghalen. Beide alleen in productie en cookieloos.

      1. app.curanta.nl/bezoekmeting.js. De cijfers staan in de verkoopdatabank op de
      Linux-server, te zien op app.curanta.nl/admin/bezoekers. Sinds 22-10-2026 neemt de productie-backoffice
      (app.curanta.nl) /api/bezoek aan; daarvoor deed alleen de demo (demo.curanta.nl) dat (ADR
      2026-10-17-verkoopbeheer-op-productie, wijziging 22-10). Script en endpoint leven in Curanta.Host, dus
      wijzigingen aan de meting gaan mee met een uitrol daarvan. Alleen in productie: het endpoint neemt ook localhost aan, anders telt `npm run dev`
      mee in de echte cijfers.

      2. De centrale dienst Bezoekmeting (statistiek.curanta.nl/m.js, repo D:\Repos\Bezoekmeting; wat hij
      bewaart: docs/privacy.md daar). Geen eigen gebeurtenissen op deze site, dus geen window.bm-stub.
      Beide hosts staan in de CSP (public/.htaccess en deploy/nginx-plesk.conf).
    */}
    {import.meta.env.PROD && (
      <script src="https://app.curanta.nl/bezoekmeting.js" defer></script>
    )}
    {import.meta.env.PROD && (
      <script src="https://statistiek.curanta.nl/m.js" defer></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    {/* Skip-link voor keyboard-users — verbergt visueel, verschijnt op focus. */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-curanta-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:no-underline focus:outline focus:outline-2 focus:outline-accent-500"
    >
      Direct naar inhoud
    </a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    {/*
      Campagnebron meenemen zonder iets op het apparaat op te slaan. Wie via een advertentie
      binnenkomt (…?utm_source=google&gclid=…), klikt zelden meteen op een demoknop; meestal
      eerst naar prijzen of een segmentpagina. Daarom krijgen alle interne links op de pagina
      dezelfde campagneparameters mee, tot en met het demoformulier. Geen cookie, geen
      localStorage — de belofte op /cookies blijft staan. De canonical wijst altijd naar de URL
      zonder parameters, dus voor zoekmachines verandert er niets.
    */}
    <script is:inline>
      (function () {
        // gbraid en wbraid: de klikcode die Google bij een deel van het iOS-verkeer meestuurt in plaats van een gclid.
        var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'gbraid', 'wbraid'];
        var here = new URLSearchParams(window.location.search);
        var carry = keys.filter(function (k) { return here.get(k); });
        if (!carry.length) return;
        document.querySelectorAll('a[href^="/"]').forEach(function (a) {
          var href = a.getAttribute('href');
          if (href.indexOf('//') === 0 || /\.[a-z0-9]{2,5}($|[?#])/i.test(href)) return;
          var url = new URL(href, window.location.origin);
          carry.forEach(function (k) { if (!url.searchParams.has(k)) url.searchParams.set(k, here.get(k)); });
          a.setAttribute('href', url.pathname + url.search + url.hash);
        });
      })();
    </script>
    {/* De twee effecten uit global.css die een script nodig hebben: BlurFade (blokken met
        data-reveal komen binnen als ze in beeld scrollen, één keer) en MagicCard (de gloed op
        .spotlight volgt de muis). Geen opslag, geen netwerk. */}
    <script is:inline>
      (function () {
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (items) {
            items.forEach(function (item) {
              if (!item.isIntersecting) return;
              item.target.classList.add('is-zichtbaar');
              io.unobserve(item.target);
            });
          }, { rootMargin: '0px 0px -60px 0px' });
          document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
        }
        document.querySelectorAll('.spotlight').forEach(function (el) {
          el.addEventListener('pointermove', function (e) {
            var r = el.getBoundingClientRect();
            el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
            el.style.setProperty('--my', (e.clientY - r.top) + 'px');
          });
        });
      })();
    </script>
  </body>
</html>
