---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base
  title="Contact — Curanta"
  description="Bereik Curanta direct via e-mail of telefoon. Algemene vragen, trust/security, of support — geen contactformulier-zwart-gat, antwoord binnen 1 werkdag."
>
  <PageHero
    eyebrow="Contact"
    title="Vraag, vragenlijst of gewoon overleg."
    subtitle="Wij zijn een klein NL-team. Geen contactformulier-zwart-gat — vragen komen direct bij iemand die antwoord kan geven."
  />

  <section class="container-prose py-16">
    <div class="grid gap-8 md:grid-cols-3">
      <div class="rounded-xl border border-ink-100 bg-white p-6">
        <h2 class="font-display text-lg font-semibold text-ink-900">Algemene vragen</h2>
        <p class="mt-2 text-sm text-ink-700">Sales, partnerships, demo's.</p>
        <p class="mt-4 text-sm leading-8">
          <a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a><br>
          <a href="tel:+31852501301" class="text-curanta-700 hover:underline">085 250 1301</a>
        </p>
      </div>
      <div class="rounded-xl border border-ink-100 bg-white p-6">
        <h2 class="font-display text-lg font-semibold text-ink-900">Trust &amp; security</h2>
        <p class="mt-2 text-sm text-ink-700">DPA, vragenlijsten, due-diligence.</p>
        <p class="mt-4 text-sm leading-8">
          <a href="mailto:trust@curanta.nl" class="text-curanta-700 hover:underline">trust@curanta.nl</a><br>
          CAIQ · SIG · BSI C5 geaccepteerd
        </p>
      </div>
      <div class="rounded-xl border border-ink-100 bg-white p-6">
        <h2 class="font-display text-lg font-semibold text-ink-900">Support &amp; klanten</h2>
        <p class="mt-2 text-sm text-ink-700">Reeds klant? Direct naar support.</p>
        <p class="mt-4 text-sm leading-8">
          <a href="https://app.curanta.nl/help" class="text-curanta-700 hover:underline">Helpcentrum</a> (na inloggen)<br>
          <a href="https://app.curanta.nl/status" class="text-curanta-700 hover:underline">Systeemstatus</a>
        </p>
      </div>
    </div>

    <div class="mt-12 rounded-2xl border border-ink-100 bg-ink-100/50 p-8">
      <h2 class="font-display text-xl font-semibold text-ink-900">Bezoekadres</h2>
      <p class="mt-3 text-sm text-ink-700">
        Curanta<br>
        Marshallstraat 26<br>
        5705 CN Helmond<br>
        Nederland<br>
        KvK- en BTW-nummer op aanvraag
      </p>
      <p class="mt-3 text-xs text-ink-500">Bezoek op afspraak.</p>
    </div>
  </section>
</Base>
