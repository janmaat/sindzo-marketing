# Apache fallback voor Plesk waar nginx als reverse proxy naar Apache draait.
# De nginx-laag pakt statische assets af; pagina-requests komen hier.
# Wordt door Astro automatisch mee gekopieerd naar dist/.
# Astro draait met trailingSlash: 'never' -> canonical URL is zonder slash.

# ----- Geen automatische slash-redirect van mod_dir -----
# Zonder dit stuurt Apache /pad -> 301 /pad/ voordat onze rewrite iets doet.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # mod_rewrite negeert standaard directory-URL's zonder slash (verwacht dat
  # mod_dir redirect). AllowNoSlash laat onze regels die URL's wel afhandelen.
  RewriteOptions AllowNoSlash

  # ----- Scanpaden: 403, zonder de 404-pagina -----
  # De site is statisch: geen PHP, geen WordPress, geen .env of .git. Wie daarnaar vraagt, is een
  # scanner. Een 403 hier is goedkoop (de 404-pagina zou ook nog de bezoekmeting laden en elke scan als
  # bezoek tellen), en Fail2Ban in Plesk blokkeert een adres dat er tien binnen tien minuten haalt
  # (ADR 2026-10-16-herkomstbeveiliging in de Ponscura-repo; dezelfde lijst als op de app-hosts).
  # De certificaatvalidatie van Let's Encrypt komt hier nooit langs: die staat in /.well-known/.
  RewriteRule (^|/)\.(env|git|svn|hg|aws|ssh|docker|vscode|idea|ds_store|htpasswd|bash_history)(/|$|\.) - [F,L,NC]
  RewriteRule (^|/)(wp-admin|wp-includes|wp-content|wp-login|wordpress|phpmyadmin|phpinfo|adminer|cgi-bin|xmlrpc\.php|wlwmanifest\.xml|server-status|vendor/phpunit|eval-stdin) - [F,L,NC]
  RewriteRule \.(php|phtml|asp|aspx|cgi|jsp|sh|bak|sql|cfg|ini|old|swp|env|7z|rar)$ - [F,L,NC]

  # ----- HTTPS afdwingen -----
  # Plesk zet HTTPS-detectie via X-Forwarded-Proto bij nginx-proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ----- www -> apex -----
  # Werkt pas als het certificaat ook www.curanta.nl dekt; zonder dat breekt de
  # TLS-handdruk af voordat Apache deze regel ziet (stand 23-09-2026).
  RewriteCond %{HTTP_HOST} ^www\.curanta\.nl$ [NC]
  RewriteRule ^ https://curanta.nl%{REQUEST_URI} [R=301,L]

  # ----- Gangbare adressen voor de over-pagina -> /over -----
  # Wie "over ons" zoekt, typt /ons of /over-ons (zoals bij sigillum.nl); de pagina heet /over.
  RewriteRule ^(ons|over-ons)/?$ https://%{HTTP_HOST}/over [R=301,L]

  # ----- /pad/index.html en /index.html -> 301 naar de schone URL -----
  # THE_REQUEST is de oorspronkelijke verzoekregel, dus de interne rewrite
  # hieronder naar /pad/index.html komt hier niet in een lus.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(.*?)/?index\.html[\s?]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

  # ----- Canonical: /pad/ -> 301 /pad (ook voor directories) -----
  # Alleen op het originele request, niet na een interne rewrite.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ----- /pad intern serveren als /pad/index.html (geen round-trip) -----
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# ----- Compressie -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf application/x-font-ttf
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/ttf
</IfModule>

# ----- Cache-headers -----
<IfModule mod_headers.c>
  # Astro fingerprint-assets (in /_astro/) + fonts — far-future cache + immutable.
  # NB: <Location> is server-config-only; in .htaccess-context geeft het 500.
  # <FilesMatch> werkt wél in .htaccess en dekt alle JS/CSS/font-extensies.
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Logo, favicons en og-afbeeldingen: een week. Ze hebben geen hash in de naam, dus niet
  # immutable; een week is lang genoeg voor de herhaalbezoeker en kort genoeg na een wijziging.
  <FilesMatch "\.(svg|png|ico|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Alles in /_astro/ heeft een hash in de naam, ook de afbeeldingen (avif, webp, jpg) die astro:assets
  # maakt; die vielen tot 24-10-2026 buiten de regel hierboven en kregen geen cachetijd (PageSpeed
  # "cache-insight"). Staat ná de week-regel, zodat een webp in /_astro/ toch een jaar krijgt.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # HTML mag nooit langer dan een paar minuten cachen — anders zien
  # bezoekers oude versies na een deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # X-Frame-Options voor oudere browsers; CSP frame-ancestors voor moderne
  Header always set X-Frame-Options "DENY"
  # Een pagina van een ander domein die curanta.nl in een venster opent, krijgt er geen greep op (24-10-2026).
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Content-Security-Policy (16-10-2026). Alleen eigen bestanden, plus demo.curanta.nl (demoformulier) en
  # app.curanta.nl (presentatieformulier, en sinds 22-10-2026 de bezoekmeting), en sinds 04-11-2026
  # de centrale bezoekmeting (sinds 17-11-2026 als statistiek.curanta.nl, daarvoor statistiek.maat-software.nl; een tijd naast die van app). Wat de policy tegenhoudt:
  # scripts en verbindingen naar andere domeinen, formulieren naar elders, inlijsten, <base> en plug-ins.
  # Sinds 24-10-2026 ook geïnjecteerde inline scripts: `npm run build` draait scripts/csp-hashes.mjs, dat in
  # dist/.htaccess 'unsafe-inline' bij script-src vervangt door de hashes van de inline scripts die Astro bouwde.
  # Hier blijft 'unsafe-inline' staan als ankerpunt voor dat script. Inline handlers (onclick=) kunnen niet meer;
  # de build faalt erop. style-src houdt 'unsafe-inline' (style-attributen, en de inline CSS uit astro.config).
  # Komt er een externe bron bij (een video, een kaart), dan moet die hier bij.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://app.curanta.nl https://statistiek.curanta.nl; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://demo.curanta.nl https://app.curanta.nl https://statistiek.curanta.nl; form-action 'self' https://demo.curanta.nl https://app.curanta.nl; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ----- MIME-types die Apache standaard mist -----
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  # Video op /presentatie (22-10-2026). Zonder text/vtt weigert de browser de ondertitels, want nosniff staat aan.
  AddType video/mp4 .mp4
  AddType text/vtt .vtt
</IfModule>

# ----- 404-pagina -----
ErrorDocument 404 /404.html
