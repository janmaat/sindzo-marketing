---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { DEMO_GESPREK, PRESENTATIE } from '../config/demo';
import inhoud from '../config/overstap-inhoud.json';

// Voor adviseurs (24-10-2026, aanbeveling 12 uit het onderzoek naar de online presentatie, Ponscura:
// docs/campagne/onderzoek-presentaties-2026-10-24.md). Selectie- en inkoopadviseurs zitten vaak aan tafel bij de keuze
// van een ECD en bepalen mee wie op de longlist komt (B.3 van dat onderzoek). Geen adviesbureau bij naam: Curanta heeft
// met geen van hen een afspraak, en een naam zou er een suggereren. Geen vergoeding of provisie genoemd: daar is niets
// over besloten.
//
// Elke bewering komt uit het feitenblad: Presentatie aanvragen (besluit Jan 24-10-2026: zakelijk adres meteen, anders
// na beoordeling), Prijzen, Implementatie (maatwerk), Migratie, Documenten voor inkoop (op aanvraag; het programma van
// eisen voor een overstap, de dertien vragen en de overstapscan staan online), Contract (art. 9, concept, juridisch nog
// te toetsen), Export en Exit, Positionering (aantal onderdelen uit src/config/onderdelen.ts), Demonstratie.
// De link naar het formulier zet "Hoe kwam u bij ons?" op Adviseur (?gevonden_via=adviseur, zie presentatie/index.astro).
const aanvraag = `${PRESENTATIE.href}?gevonden_via=adviseur#presentatie-aanvraag`;
const aantalEisen = inhoud.pve.reduce((n, c) => n + c.eisen.length, 0);
const aantalVragen = inhoud.leveranciersvragen.length;

const nakijken = [
  {
    kop: 'De prijs, per plan',
    tekst: 'Wat Curanta per actieve medewerker per maand kost, staat per plan op de site, met wat er wel en niet in zit. De implementatie is maatwerk, met een prijs die wij vooraf afspreken. Het overzetten van de gegevens is een project tegen een vaste prijs, na een migratie-inschatting.',
    link: { label: 'Prijzen', href: '/prijzen' },
  },
  {
    kop: 'De stand per onderdeel',
    tekst: `Bij elk onderdeel staat wat het doet en of het bij een organisatie nog ingericht moet worden. Voor de koppelingen staat dat per koppeling, voor de beveiliging per onderwerp.`,
    link: { label: 'Alle onderdelen', href: '/oplossing' },
  },
  {
    kop: 'Eisen die niet van ons zijn',
    tekst: `Het programma van eisen voor een overstap (${aantalEisen} eisen, ook als Word-bestand) en de ${aantalVragen} vragen aan de huidige leverancier zijn leveranciersneutraal. U legt ze naast elk pakket. De overstapscan maakt er een planning bij.`,
    link: { label: 'Programma van eisen', href: '/overstappen/programma-van-eisen' },
  },
  {
    kop: 'De weg naar buiten',
    tekst: 'In het concept van onze voorwaarden (artikel 9) kan een organisatie ook tijdens het contractjaar overstappen, met 2 maanden opzegtermijn en zonder vergoeding. De export van alle gegevens en bestanden komt binnen 5 werkdagen. Een jurist moet artikel 9 nog toetsen.',
    link: { label: 'Overstappen en exit', href: '/overstappen#eruit' },
  },
  {
    kop: 'Documenten voor de inkoop',
    tekst: 'Andere stukken voor de inkoop stellen wij op aanvraag op, zonder geheimhoudingsverklaring. Denk aan een volledig programma van eisen voor zorg, planning en administratie, de verwerkersovereenkomst, een beveiligingsdossier en de SLA.',
    link: { label: 'Inkoopdossier', href: '/procurement' },
  },
];
---
<Base
  image="/og/adviseurs.png"
  title="Voor adviseurs bij de keuze van zorgsoftware | Curanta"
  description="Begeleidt u een zorgorganisatie bij de keuze van zorgsoftware? Wat u bij Curanta zelf nakijkt, en hoe u de online presentatie voor uw klant aanvraagt."
>
  <PageHero
    eyebrow="Voor adviseurs"
    title="U helpt een zorgorganisatie kiezen."
    subtitle="Als zorg-ICT-adviseur of inkoopadviseur zet u leveranciers naast elkaar, vaak voor een keuze van tien jaar. Op deze pagina staat wat u bij Curanta zonder gesprek kunt nakijken, en hoe de mensen van uw klant de presentatie krijgen."
  >
    <div slot="actions" class="flex flex-wrap items-center gap-3">
      <a href={aanvraag} class="btn-primary no-underline">{PRESENTATIE.label}</a>
      <a href="#voor-uw-klant" class="btn-secondary no-underline">Een presentatie voor uw klant</a>
    </div>
  </PageHero>

  <section class="container-prose py-14">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900">Eerst zelf kijken</h2>
      <p class="mt-4 leading-relaxed text-ink-700">
        U bekijkt de online presentatie zelf, in uw eigen tempo, met een persoonlijke link voor presentatie.curanta.nl.
        Die begint met een introductie van vijf korte delen over de sector van uw klant. Daarna vindt u schermvideo's uit
        Curanta, de dia's en "Uw overstap in één project". Kies in het formulier bij "Hoe kwam u bij ons?" voor Adviseur;
        de link hierboven doet dat al.
      </p>
      <p class="mt-4 leading-relaxed text-ink-700">
        Met een zakelijk e-mailadres krijgt u de link meestal binnen enkele minuten per mail. Hij is 30 dagen geldig, en daarna vraagt u zelf een
        nieuwe aan. Loopt een selectie langer, dan kunt u dus gewoon terugkomen.
      </p>
    </div>
  </section>

  <section class="border-y border-ink-100 bg-ink-100/40 py-14">
    <div class="container-prose">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl font-bold text-ink-900">Wat u zonder gesprek kunt nakijken</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          Bij een longlist wilt u weten wat een pakket kost, wat het nu kan en hoe een organisatie er weer uit komt.
          Dat staat op de site, met de stand erbij.
        </p>
      </div>
      <ul class="mt-8 grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {nakijken.map((n) => (
          <li class="flex flex-col rounded-2xl border border-ink-100 bg-white p-6">
            <h3 class="font-display text-lg font-semibold text-ink-900">{n.kop}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-700">{n.tekst}</p>
            <a href={n.link.href} class="mt-3 text-sm font-semibold text-curanta-700 no-underline hover:underline">{n.link.label} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="voor-uw-klant" class="container-prose scroll-mt-24 py-14">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900">Een presentatie voor uw klant</h2>
      <p class="mt-4 leading-relaxed text-ink-700">
        Iedereen die kijkt, krijgt een eigen, persoonlijke link. Dat kan op twee manieren.
      </p>
      <ol class="mt-6 space-y-5">
        <li class="rounded-2xl border border-ink-100 bg-white p-6">
          <p class="text-sm font-semibold text-curanta-700">1. Uw klant vraagt zelf aan</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-700">
            Stuur de mensen van de projectgroep de link naar <a href={aanvraag} class="text-curanta-700 hover:underline">het
            aanvraagformulier</a>. Bij "Hoe kwam u bij ons?" staat dan al Adviseur; uw bureau vullen zij in bij "Wie of
            welke?". Zo zien wij dat de aanvraag via u loopt.
          </p>
        </li>
        <li class="rounded-2xl border border-ink-100 bg-white p-6">
          <p class="text-sm font-semibold text-curanta-700">2. U geeft ons de namen</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-700">
            Mail <a href="mailto:info@curanta.nl?subject=Presentatie%20voor%20een%20klant" class="text-curanta-700 hover:underline">info@curanta.nl</a>
            de naam van de organisatie, de sector, en de namen en e-mailadressen van wie moet kijken. Wij sturen ieder van
            hen een eigen uitnodiging. Spreek dat wel eerst met hen af: zij krijgen een mail van Curanta.
          </p>
        </li>
      </ol>
      <p class="mt-6 leading-relaxed text-ink-700">
        Wij leggen vast wanneer iemand inlogt. Wat iemand in de presentatie bekijkt, leggen wij alleen vast als hij of zij
        daar zelf toestemming voor geeft.
      </p>
      <p class="mt-4 leading-relaxed text-ink-700">
        Staat Curanta op de shortlist en wilt u het samen zien? Dan komen wij langs en laten Curanta zien aan de hand van
        het zorgproces van uw klant. Vragen kunt u ook stellen via
        <a href="tel:+31852501301" class="text-curanta-700 hover:underline">085 250 1301</a>.
      </p>
    </div>
  </section>

  <Cta
    title="Zelf eerst kijken?"
    subtitle="Vraag de online presentatie aan. Met een zakelijk e-mailadres krijgt u de link meestal binnen enkele minuten per mail."
    primary={{ label: PRESENTATIE.label, href: aanvraag }}
    secondary={{ label: DEMO_GESPREK.label, href: DEMO_GESPREK.href }}
  />
</Base>
