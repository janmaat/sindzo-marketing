---
// Eén onderdeel op /oplossing: naam, status uit de gedeelde indeling en een korte uitleg.
// Geen emoji meer als icoon: die oogden per systeem anders en voegden niets toe.
import StatusLabel from './StatusLabel.astro';
import type { Status } from '../config/status';

interface Props {
  title: string;
  body: string;
  features?: string[];
  status: Status;
  /** Korte toelichting achter het statuslabel, bijvoorbeeld "versturen na aansluiting". */
  noot?: string;
}
const { title, body, features = [], status, noot } = Astro.props;
---
<article class="flex flex-col rounded-xl bg-white p-5 shadow-[0_4px_14px_rgba(14,79,87,0.06)] ring-1 ring-ink-200">
  <h3 class="font-display text-base font-bold text-curanta-900">{title}</h3>
  <StatusLabel status={status} noot={noot} class="mt-1.5" />
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-700">{body}</p>
  {features.length > 0 && (
    <ul class="mt-3 space-y-1 text-xs text-ink-700">
      {features.map((f) => (
        <li class="flex items-start gap-2">
          <span class="mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-curanta-500" aria-hidden="true"></span>
          <span>{f}</span>
        </li>
      ))}
    </ul>
  )}
</article>
