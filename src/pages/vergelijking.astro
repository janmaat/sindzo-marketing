---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StatusLabel from '../components/StatusLabel.astro';
import Cta from '../components/Cta.astro';
import { DEMO_ZELF_AANGEBODEN, DEMO_EERSTE } from '../config/demo';
import type { Status } from '../config/status';

// Vergelijking met drie gevestigde VVT-leveranciers. Herzien 08-10-2026: elke cel over een andere
// leverancier is opnieuw nagelopen in publieke bronnen, met de URL erbij.
//
// Wat daarbij veranderde ten opzichte van de marktscan van 29-05-2026:
// - "PinkRoccade myNeva" bestaat niet: myneva is een ander bedrijf (myneva Nederland B.V.,
//   voorheen Regas). Het VVT-dossier van PinkRoccade is mijnCaress (PinkRoccade Care).
// - Nedap Caren heeft wel een tweede taal (Engels); spraak bij rapporteren kan bij Nedap en
//   Pluriform via partners. Die cellen stonden op "nee".
// - Cura en Plancare 2 zijn sinds 2020 samen Fierit (Tenzinger). Carit Care en Famped/Famedio zijn
//   niet als zorgsoftware teruggevonden en staan er niet meer.
// - De aantallen interventiesjablonen (~187, ~140) hadden geen publieke bron; weggehaald.
//
// 08-10-2026: rij Omaha-keurmerk toegevoegd uit de lijst van Stichting Omaha System Support. 'Nee' staat er
// alleen waar die bron het zegt (Nedap: "Geen keurmerk").
//
// Uitgangspunt: een functie die niet op de website van een leverancier staat, kan er toch zijn.
// Daarom "niet gevonden", nooit "nee". Curanta zelf staat er met de gedeelde status
// (src/config/status.ts).

const GECONTROLEERD = '8 oktober 2026 (de rij over AI: 16 oktober 2026)';

type Oordeel = 'ja' | 'deels' | 'nee' | 'niet-gevonden';
interface Cel { oordeel: Oordeel; tekst: string; bron?: string; }
interface Rij {
  onderwerp: string;
  curanta: { status: Status | null; tekst: string };
  nedap: Cel;
  caress: Cel;
  pluriform: Cel;
}

const rijen: Rij[] = [
  {
    onderwerp: 'Cliëntportaal in een andere taal dan Nederlands',
    curanta: { status: 'demo', tekst: 'Menu\'s en vaste teksten in vijf talen: NL, EN, TR, AR, DE.' },
    nedap: { oordeel: 'ja', tekst: 'Caren: Nederlands of Engels.', bron: 'https://support.caren.nl/support/solutions/articles/75000124925-de-instellingen-in-caren' },
    caress: { oordeel: 'niet-gevonden', tekst: 'mijncaress.nl was op de controledatum niet bereikbaar.' },
    pluriform: { oordeel: 'niet-gevonden', tekst: 'Geen taalkeuze vermeld.', bron: 'https://www.adapcare.nl/pluriform-zorg/' },
  },
  {
    onderwerp: 'Steun tussen collega\'s (buddy, intervisie)',
    curanta: { status: 'demo', tekst: 'Collega-netwerk, gescheiden van HR. Lotgenoten na uw DPIA.' },
    nedap: { oordeel: 'deels', tekst: 'Medewerkerportaal met collega\'s en berichten; een buddy- of intervisiefunctie niet gevonden.', bron: 'https://nedap-ons.nl/ons-suite/meer/medewerkerportaal/' },
    caress: { oordeel: 'niet-gevonden', tekst: '' },
    pluriform: { oordeel: 'deels', tekst: 'Casusoverleg over cliënten in een groep; geen steun voor medewerkers.', bron: 'https://www.adapcare.nl/cacao-samenwerkingsplatform/' },
  },
  {
    onderwerp: 'FHIR-API',
    curanta: { status: 'inrichten', tekst: 'FHIR R4-API voor de Basisgegevensset Zorg (BgZ), alleen om te lezen, na registratie.' },
    nedap: { oordeel: 'ja', tekst: 'Ons API met FHIR-endpoints; zibs 2017 op FHIR STU3.', bron: 'https://support.nedap-ons.nl/support/solutions/articles/103000374164-getting-started-with-zibs-and-fhir' },
    caress: { oordeel: 'deels', tekst: 'De koppeling met ZorgDomein gebruikt FHIR (2019); geen publieke API-documentatie gevonden.', bron: 'https://www.icthealth.nl/nieuws/koppeling-zorgdomein-mijncaress-beperkt-administratielast' },
    pluriform: { oordeel: 'deels', tekst: '"FHIR Zibs" genoemd, zonder versie.', bron: 'https://www.adapcare.nl/integraties/' },
  },
  {
    onderwerp: 'Spraak bij het rapporteren',
    curanta: { status: 'demo', tekst: 'Spraak naar tekst op het apparaat, alleen in de backoffice.' },
    nedap: { oordeel: 'ja', tekst: 'Via Attendi of Tell James, met een eigen contract met die leverancier.', bron: 'https://support.nedap-ons.nl/support/solutions/articles/103000337039-spraakgestuurd-rapporteren-inschakelen-binnen-ons-dossier' },
    caress: { oordeel: 'deels', tekst: 'Tell James is een product van PinkRoccade Care; de pagina over de koppeling met mijnCaress was niet bereikbaar.', bron: 'https://telljames.nl/waarom-tell-james/' },
    pluriform: { oordeel: 'ja', tekst: 'Via Attendi of Tell James, en inspreken in App Anne.', bron: 'https://www.adapcare.nl/integraties/' },
  },
  {
    onderwerp: 'Waar de gegevens staan',
    curanta: { status: null, tekst: 'IONOS Cloud, Berlijn (EU).' },
    nedap: { oordeel: 'ja', tekst: 'Datacenters in Nederland; bestanden bij AWS in Frankfurt en Ierland (EU).', bron: 'https://support.nedap-ons.nl/support/solutions/articles/103000336008-leveranciers-en-subverwerkers' },
    caress: { oordeel: 'niet-gevonden', tekst: '' },
    pluriform: { oordeel: 'niet-gevonden', tekst: 'AWS als partner genoemd; regio niet vermeld.', bron: 'https://www.adapcare.nl/over-ons/' },
  },
  {
    // 16-10-2026: nagelopen in de subverwerkerslijst van Nedap, op adapcare.nl en in het trustcenter van Attendi.
    // Nedap noemt zelf dat Azure 30 dagen bewaart tegen misbruik; dat hoort erbij voor een eerlijke weergave.
    onderwerp: 'AI-functies: waar de gegevens heen gaan',
    curanta: { status: null, tekst: 'Standaard Mistral AI via het EU-endpoint, zonder bewaren en zonder training. Een organisatie kan Anthropic (VS) kiezen of AI uitzetten.' },
    nedap: { oordeel: 'ja', tekst: 'Alleen als de organisatie het aanzet: OpenAI Ireland (EER, direct na verwerking verwijderd) en Microsoft Azure (EER, 30 dagen bewaard tegen misbruik); geen training.', bron: 'https://support.nedap-ons.nl/support/solutions/articles/103000336008-leveranciers-en-subverwerkers-nedap-ons-en-caren' },
    caress: { oordeel: 'niet-gevonden', tekst: 'Geen publieke informatie over AI in mijnCaress gevonden; mijncaress.nl was op de controledatum niet bereikbaar.' },
    pluriform: { oordeel: 'deels', tekst: 'Adapcare noemt geen modelaanbieder of regio. AI-partner Attendi verwerkt bij Microsoft Azure in de EU en traint niet op klantgegevens.', bron: 'https://trustcenter.attendi.nl/docs/subverwerkers' },
  },
  {
    onderwerp: 'SMART-doelen en risicosignalering in het zorgplan',
    curanta: { status: 'demo', tekst: 'SMART-doelen; risico op val, decubitus, ondervoeding en delier uit metingen.' },
    nedap: { oordeel: 'deels', tekst: 'Zorgplan volgens SMART en automatisch berekende scores van meetinstrumenten; risicosignalering niet gevonden.', bron: 'https://nedap-ons.nl/kennisbank/wat-is-een-zorgplan-en-waarvoor-is-het-bedoeld/' },
    caress: { oordeel: 'niet-gevonden', tekst: '' },
    pluriform: { oordeel: 'niet-gevonden', tekst: 'Zorgplan volgens Omaha (2016); SMART en risicosignalering niet gevonden.', bron: 'https://www.pluriform.nl/nieuwsbericht/683/pluriform-zorg-gecertificeerd-voor-omaha' },
  },
  {
    onderwerp: 'Prijs op de website',
    curanta: { status: null, tekst: 'Per actieve medewerker per maand, €19 tot €39 per plan.' },
    nedap: { oordeel: 'ja', tekst: 'Per cliënt in zorg per maand, met een minimum van €25.', bron: 'https://nedap-ons.nl/starten-met-nedap-ons/hoe-start-je-met-nedap-ons/tarieven/' },
    caress: { oordeel: 'niet-gevonden', tekst: '' },
    pluriform: { oordeel: 'deels', tekst: '"Een prijs per gebruiker"; bedrag niet vermeld.', bron: 'https://www.adapcare.nl/pluriform-zorg/' },
  },
  {
    onderwerp: 'eOverdracht, gekwalificeerd door Nictiz',
    curanta: { status: 'ontwikkeling', tekst: 'Niet gekwalificeerd. Het document (eOverdracht 4.0) is gebouwd en te downloaden; automatisch verzenden niet.' },
    nedap: { oordeel: 'ja', tekst: 'eOverdracht 4.0: ontvangen (24-01-2023) en versturen (07-04-2023).', bron: 'https://www.nictiz.nl/wat-we-doen/activiteiten/kwalificatie/overzicht-kwalificatie-resultaten/' },
    caress: { oordeel: 'ja', tekst: 'Ontvangen (19-01-2023); een nieuwsbericht noemt ook versturen.', bron: 'https://www.nictiz.nl/nieuws/verkregen-kwalificaties-eoverdracht/' },
    pluriform: { oordeel: 'deels', tekst: 'eOverdracht als standaard genoemd; niet in het kwalificatieoverzicht van Nictiz gevonden.', bron: 'https://www.adapcare.nl/integraties/' },
  },
  {
    onderwerp: 'Omaha-keurmerk van Stichting Omaha System Support',
    curanta: { status: null, tekst: 'Nee. Het zorgplan gebruikt de 42 problemen en de KBS-scores van het Omaha System; Curanta is niet aangesloten bij de stichting.' },
    nedap: { oordeel: 'nee', tekst: 'Partner van de stichting, "Geen keurmerk".', bron: 'https://www.omahasystem.nl/over-de-stichting/partners/ecd-leveranciers' },
    caress: { oordeel: 'niet-gevonden', tekst: 'Niet op de lijst van de stichting.', bron: 'https://www.omahasystem.nl/over-de-stichting/partners/ecd-leveranciers' },
    pluriform: { oordeel: 'ja', tekst: 'Adapcare: "Keurmerk ontvangen".', bron: 'https://www.omahasystem.nl/over-de-stichting/partners/ecd-leveranciers' },
  },
  {
    onderwerp: 'ISO 27001-certificaat',
    curanta: { status: null, tekst: 'Nee. Audit gepland in 2027.' },
    nedap: { oordeel: 'ja', tekst: 'Uitgegeven door Brand Compliance.', bron: 'https://support.nedap-ons.nl/support/solutions/articles/103000156794-iso-27001' },
    caress: { oordeel: 'deels', tekst: 'PinkRoccade Healthcare hergecertificeerd in 2025; of mijnCaress in de scope valt, staat er niet.', bron: 'https://www.pinkroccadeggz.nl/nieuwsberichten/hercertificering-iso-nen/' },
    pluriform: { oordeel: 'ja', tekst: 'Adapcare, sinds 2018; certificerende instelling niet vermeld.', bron: 'https://www.adapcare.nl/compliance/' },
  },
  {
    onderwerp: 'NEN 7510-certificaat',
    curanta: { status: null, tekst: 'Nee. Maatregelen ingevoerd, externe audit gepland.' },
    nedap: { oordeel: 'ja', tekst: 'Uitgegeven door Brand Compliance.', bron: 'https://support.nedap-ons.nl/support/solutions/articles/103000156795-nen-7510' },
    caress: { oordeel: 'deels', tekst: 'PinkRoccade Healthcare hergecertificeerd in 2025; scope voor mijnCaress niet vermeld.', bron: 'https://www.pinkroccadeggz.nl/nieuwsberichten/hercertificering-iso-nen/' },
    pluriform: { oordeel: 'ja', tekst: 'Adapcare, sinds 2018; instelling niet vermeld.', bron: 'https://www.adapcare.nl/compliance/' },
  },
];

const OORDEEL: Record<Oordeel, { label: string; klasse: string }> = {
  'ja': { label: 'Publiek vermeld', klasse: 'bg-greensoft text-curanta-900' },
  'deels': { label: 'Deels', klasse: 'bg-amber-100 text-amber-900' },
  // Alleen als een bron het uitdrukkelijk zegt, zoals de lijst van de Omaha-stichting.
  'nee': { label: 'Nee, volgens de bron', klasse: 'bg-rose-50 text-rose-800' },
  'niet-gevonden': { label: 'Niet gevonden', klasse: 'bg-ink-100 text-ink-700' },
};

const leveranciers = [
  { sleutel: 'nedap', naam: 'Nedap Ons', van: 'Nedap' },
  { sleutel: 'caress', naam: 'mijnCaress', van: 'PinkRoccade Care' },
  { sleutel: 'pluriform', naam: 'Pluriform Zorg', van: 'Adapcare' },
] as const;

const domein = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<Base
  title="Curanta naast Nedap Ons, mijnCaress en Pluriform Zorg"
  description="Curanta naast Nedap Ons, mijnCaress en Pluriform Zorg: per onderwerp wat publiek te vinden is, met bron en controledatum, ook waar zij verder zijn."
>
  <PageHero
    eyebrow="Vergelijking"
    title="Curanta naast drie gevestigde leveranciers"
    subtitle="Per onderwerp wat Curanta heeft en wat wij over Nedap Ons, mijnCaress en Pluriform Zorg in publieke bronnen vonden. Met de bron bij elke cel, ook waar zij verder zijn dan Curanta."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href={DEMO_EERSTE.href} class="btn-primary no-underline">{DEMO_EERSTE.label}</a>
      <a href="/trust" class="btn-secondary no-underline">Trust Centre</a>
    </div>
  </PageHero>

  <section class="border-b border-ink-200 bg-curanta-50 py-10">
    <div class="container-prose grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-bold text-curanta-900">Hoe deze vergelijking is gemaakt</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-ink-700">
          <li>Gecontroleerd op {GECONTROLEERD}, in publieke bronnen: de websites en hulppagina's van de leveranciers, het kwalificatieoverzicht van Nictiz en vakpers.</li>
          <li>Wij hebben de producten van de andere leveranciers niet zelf gebruikt, en ook geen demonstratie ervan gezien.</li>
          <li>De gegevens over Curanta komen uit de software zelf en ons feitenblad.</li>
          <li>Adapcare levert Pluriform Zorg; de certificaten in de tabel horen bij Adapcare.</li>
        </ul>
      </div>
      <div class="rounded-xl bg-white p-5 ring-1 ring-ink-200">
        <h2 class="font-display text-lg font-bold text-curanta-900">"Niet gevonden" is geen "nee"</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-700">
          Staat een functie niet op de website van een leverancier, dan kan hij er toch zijn. Daarom
          staat er dan "niet gevonden". Klopt er iets niet of is het verouderd? Mail
          <a href="mailto:info@curanta.nl?subject=Correctie%20vergelijkingspagina" class="text-curanta-700">info@curanta.nl</a>;
          wij passen het aan en zetten de datum erbij.
        </p>
      </div>
    </div>
  </section>

  <section class="container-prose py-12" aria-labelledby="tabel-kop">
    <h2 id="tabel-kop" class="font-display text-2xl font-bold text-curanta-900 sm:text-3xl">Per onderwerp</h2>
    <div class="mt-6 space-y-6">
      {rijen.map((r) => (
        <article class="overflow-hidden rounded-xl bg-white ring-1 ring-ink-200">
          <h3 class="border-b border-ink-200 bg-curanta-50 px-5 py-3 font-display text-base font-bold text-curanta-900">{r.onderwerp}</h3>
          <dl class="grid divide-y divide-ink-200 md:grid-cols-4 md:divide-x md:divide-y-0">
            <div class="p-4">
              <dt class="text-xs font-bold uppercase tracking-[0.12em] text-ink-500">Curanta</dt>
              <dd class="mt-2 text-sm text-ink-700">
                {r.curanta.status && <StatusLabel status={r.curanta.status} class="mb-1.5" />}
                <span class="block">{r.curanta.tekst}</span>
              </dd>
            </div>
            {leveranciers.map((l) => {
              const c = r[l.sleutel];
              return (
                <div class="p-4">
                  <dt class="text-xs font-bold uppercase tracking-[0.12em] text-ink-500">{l.naam} <span class="font-semibold normal-case tracking-normal">({l.van})</span></dt>
                  <dd class="mt-2 text-sm text-ink-700">
                    <span class={`inline-block rounded px-1.5 py-0.5 text-xs font-semibold ${OORDEEL[c.oordeel].klasse}`}>{OORDEEL[c.oordeel].label}</span>
                    {/* Zonder toelichting staat alleen het oordeel er; vroeger stond er dan een "—". */}
                    {c.tekst && <span class="mt-1.5 block">{c.tekst}</span>}
                    {c.bron && (
                      <a href={c.bron} rel="noopener" class="mt-1.5 inline-block break-all text-xs font-semibold text-curanta-700">Bron: {domein(c.bron)}</a>
                    )}
                  </dd>
                </div>
              );
            })}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="container-prose border-t border-ink-200 py-12">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-bold text-curanta-900">Wat Curanta nog niet heeft</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-ink-700">
          <li>Declaraties rechtstreeks versturen via VECOZO: in ontwikkeling. Nu levert u de bestanden zelf aan.</li>
          <li>eOverdracht, MedMij en het LSP: in ontwikkeling, niet aangesloten.</li>
          <li>Een ISO 27001- of NEN 7510-certificaat en een externe pentest.</li>
          <li>Een Omaha-keurmerk.</li>
          <li>Klantervaringen: er werkt nog geen zorgorganisatie met Curanta in productie.</li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-xl font-bold text-curanta-900">Andere leveranciers</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">
          Cura en Plancare 2 zijn sinds 2020 samen
          <a href="https://fierit.nl/over-ons/" rel="noopener" class="text-curanta-700">Fierit</a> (Tenzinger);
          Fierit is door Nictiz gekwalificeerd voor eOverdracht. Het Omaha-keurmerk, dat de stichting sinds
          2025 geeft en elke twee jaar opnieuw beoordeelt, hebben behalve Adapcare ook Attenza, Ecare, Reware en
          SDB (lijst van de stichting, 8 oktober 2026). Werkt u met een pakket dat hier niet
          staat? Mail ons de naam via
          <a href="mailto:info@curanta.nl?subject=Vergelijking%20aanvragen" class="text-curanta-700">info@curanta.nl</a>;
          wij reageren binnen 1 werkdag.
        </p>
      </div>
    </div>
  </section>

  <Cta
    title="Deze vergelijking naast de demo leggen?"
    subtitle={DEMO_ZELF_AANGEBODEN
      ? 'Kijk zelf rond met een eigen demo-toegang. Of vraag een demonstratie aan; daarin laten wij de punten uit deze vergelijking in het systeem zien.'
      : 'Vraag een demonstratie aan; daarin laten wij de punten uit deze vergelijking in het systeem zien.'}
  />
</Base>
