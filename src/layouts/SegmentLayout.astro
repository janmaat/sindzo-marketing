---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Screenshot from '../components/Screenshot.astro';
import Veelgesteld from '../components/Veelgesteld.astro';
import { DEMO_ZELF_AANGEBODEN, DEMO_EERSTE } from '../config/demo';
import { algemeneVragen, type Vraag } from '../config/vragen';

interface Trigger { title: string; body: string; }
interface Module { name: string; note: string; }
interface ProofPoint { value: string; label: string; }

interface Props {
  segmentKey: string;       // 'vvt' | 'ghz' | 'ggz' | 'huisartsen'
  segmentLabel: string;     // 'VVT'
  title: string;            // Pagina-titel (SEO)
  description: string;      // Meta-description (SEO + advertentie-landingspagina); verplicht, anders erven alle segmenten die van de homepage
  eyebrow: string;         // "Voor VVT-organisaties"
  hero: string;             // hero h1
  subtitle: string;         // hero subtitle
  triggers: Trigger[];      // 3-4 doelgroep-pijnpunten
  modules: Module[];        // 6-8 modules die het meest van toepassing zijn
  regulatory: string[];     // relevante wetten
  proofPoints?: ProofPoint[];
  caseQuote?: { quote: string; author: string; org: string };
  image?: string;         // og:image-pad voor deze segmentpagina
  /** Een echt scherm uit de demo, direct onder de introductie. */
  beeld?: { src: ImageMetadata; alt: string; adres: string; bijschrift: string };
  /** Wat er voor deze sector (nog) niet is; staat zichtbaar onder de modules. */
  nogNiet?: string[];
  /** Een korte regel over het plan dat bij deze sector past, met een link naar /prijzen (GGZ: Praktijk). */
  prijsNoot?: string;
  /** Voor een sector waarvoor Curanta geen eigen product heeft (huisartsen): geen demo- en
      vervangingstaal, alleen wat er voor de samenwerking is. */
  alleenSamenwerking?: boolean;
  /** Vragen van deze sector; ze staan vóór de algemene vragen (src/config/vragen.ts). */
  vragen?: Vraag[];
}

const {
  title, description, eyebrow, hero, subtitle,
  triggers, modules, regulatory, proofPoints, caseQuote, image, alleenSamenwerking = false, nogNiet = [], beeld, prijsNoot, vragen = [],
} = Astro.props;
---
<Base title={title} description={description} image={image}>
  <PageHero eyebrow={eyebrow} title={hero} subtitle={subtitle}>
    <div slot="actions" class="flex flex-wrap gap-3">
      {alleenSamenwerking ? (
        <a href="/contact" class="btn-primary no-underline">Neem contact op</a>
      ) : (
        <>
          <a href={DEMO_EERSTE.href} class="btn-primary no-underline">{DEMO_EERSTE.label}</a>
          <a href="/oplossing" class="btn-secondary no-underline">Bekijk de modules</a>
        </>
      )}
    </div>
  </PageHero>

  {beeld && (
    <section class="bg-curanta-50 pb-12 pt-10">
      <div class="container-prose">
        <Screenshot src={beeld.src} alt={beeld.alt} adres={beeld.adres} bijschrift={beeld.bijschrift} />
      </div>
    </section>
  )}

  {proofPoints && (
    <section class="border-b border-ink-100 bg-ink-100/40">
      <div class="container-prose py-10 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {proofPoints.map((p) => (
          <div>
            <div class="font-display text-3xl font-bold text-curanta-700">{p.value}</div>
            <div class="mt-1 text-xs text-ink-500">{p.label}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="container-prose py-20">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tightish text-ink-900">
        {alleenSamenwerking ? 'Wat er voor de samenwerking is' : 'Wat u ermee doet'}
      </h2>
    </div>
    {/* Twee kolommen met een lijn erboven, geen kaarten (Taste Skill, 14-10-2026). De sectoren
        hebben 3, 4 of 5 punten: in een raster van drie kaarten gaf dat lege vakken (4 en 5) of
        het sjabloonrijtje van drie gelijke kaarten (3). Zonder kaartranden valt een oneven
        laatste punt niet op als gat. */}
    <div class="mt-10 grid max-w-5xl gap-x-14 gap-y-10 md:grid-cols-2">
      {triggers.map((t, i) => (
        <div class="border-t-2 border-curanta-200 pt-5" data-reveal style={`--reveal-vertraging:${(i % 2) * 90}ms`}>
          <h3 class="font-display text-lg font-semibold text-ink-900">{t.title}</h3>
          <p class="mt-2 text-pretty text-[0.95rem] leading-relaxed text-ink-700">{t.body}</p>
        </div>
      ))}
    </div>
  </section>

  {caseQuote && (
    <section class="bg-curanta-50/50 border-y border-curanta-100">
      <div class="container-prose py-16">
        <blockquote class="max-w-3xl">
          <p class="font-display text-xl sm:text-2xl leading-relaxed text-ink-900">
            "{caseQuote.quote}"
          </p>
          <footer class="mt-6 text-sm text-ink-500">
            <span class="font-semibold text-ink-700">{caseQuote.author}</span> · {caseQuote.org}
          </footer>
        </blockquote>
      </div>
    </section>
  )}

  <section class="container-prose py-20">
    <div class="grid gap-10 lg:grid-cols-[280px_1fr]">
      <div>
        <h2 class="font-display text-3xl font-bold tracking-tightish text-ink-900">
          {alleenSamenwerking ? 'Koppelingen voor de samenwerking' : 'De onderdelen voor deze sector'}
        </h2>
        {!alleenSamenwerking && (
          <p class="mt-3 text-sm text-ink-700">
            U zet alleen aan wat u nodig hebt; later bijzetten kan zonder overstap.
          </p>
        )}
        <a href="/oplossing" class="mt-5 inline-block text-sm font-medium text-curanta-700 no-underline hover:underline">
          Volledige modulekaart →
        </a>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {modules.map((m) => (
          <li class="rounded-lg border border-ink-100 bg-white p-4">
            <div class="font-semibold text-sm text-ink-900">{m.name}</div>
            <div class="mt-1 text-xs text-ink-500">{m.note}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {nogNiet.length > 0 && (
    <section class="container-prose pb-16">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-curanta-900">Wat er nog niet is</h2>
        <ul class="mt-4 list-disc space-y-1.5 pl-5 text-ink-700">
          {nogNiet.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </section>
  )}

  {prijsNoot && (
    <section class="container-prose pb-12">
      <p class="max-w-3xl text-ink-700">
        {prijsNoot} <a href="/prijzen#praktijk" class="font-semibold text-curanta-700 hover:underline">Naar de prijzen</a>
      </p>
    </section>
  )}

  {/* Vragen en antwoorden, ook als FAQPage (skill site-inhoudscontrole, Vindbaarheid, 17-10-2026).
      Niet voor huisartsen: daar verkopen wij geen systeem, dus de algemene vragen passen niet. */}
  {!alleenSamenwerking && <Veelgesteld vragen={[...vragen, ...algemeneVragen]} />}

  <section class="container-prose py-12 border-t border-ink-100">
    <h2 class="font-display text-xl font-semibold text-ink-900">Relevante wetten en normen</h2>
    <p class="mt-2 text-sm text-ink-700 max-w-2xl">
      De stand van zaken per wet staat in het <a href="/trust" class="text-curanta-700 hover:underline">Trust Centre</a>.
    </p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {regulatory.map((r) => (
        <li class="badge">{r}</li>
      ))}
    </ul>
  </section>

  {alleenSamenwerking ? (
    <Cta
      title="Een vraag over de samenwerking?"
      subtitle="Werkt u samen met een zorgorganisatie die Curanta gebruikt, of wilt u weten wat er voor huisartsen is? Wij reageren binnen 1 werkdag."
      primary={{ label: 'Neem contact op', href: '/contact' }}
      secondary={{ label: 'Bekijk de koppelingen', href: '/integraties' }}
    />
  ) : (
    <Cta
      title="Liever Curanta op uw eigen werkprocessen zien?"
      subtitle={DEMO_ZELF_AANGEBODEN
        ? 'Kijk zelf rond in een werkende omgeving met verzonnen cliënten. Of stuur ons drie typische werkstromen uit uw organisatie; dan laten wij zien hoe Curanta ze ondersteunt, zonder vast script.'
        : 'Stuur ons drie typische werkstromen uit uw organisatie; dan laten wij met verzonnen cliënten zien hoe Curanta ze ondersteunt, zonder vast script.'}
    />
  )}
</Base>
