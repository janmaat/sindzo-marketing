---
import { DEMO_ZELF, DEMO_GESPREK } from '../config/demo';
// Hero-claim is bewust niet feature-led: het rapport leerde dat in dit segment
// vertrouwen en procesfit zwaarder wegen dan functielijsten.
---
<section class="relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-curanta-50 via-cream to-cream"></div>
  {/* One-pager-stijl radial gloed in rechterbovenhoek (accent + petrol). */}
  <div
    class="absolute -top-48 -right-40 -z-10 h-[640px] w-[640px] rounded-full opacity-80"
    style="background: radial-gradient(circle at 30% 30%, rgba(63,163,122,0.16), rgba(14,66,61,0.06) 55%, transparent 72%);"
  ></div>
  {/* Subtiele zandkleurige onderkant-wash voor warmte. */}
  <div class="absolute -bottom-32 -left-32 -z-10 h-[420px] w-[420px] rounded-full bg-sand/70 opacity-70 blur-3xl"></div>
  <div class="container-prose pt-20 pb-24 sm:pt-28 sm:pb-32">
    <div class="max-w-3xl">
      <span class="badge mb-6">
        <span class="status-dot bg-accent-500"></span>
        Gebouwd in Nederland · NEN 7510 in voorbereiding
      </span>
      <h1 class="font-display text-4xl font-bold leading-tight tracking-tightish text-ink-900 sm:text-5xl md:text-6xl">
        Minder regeldruk. <span class="italic text-accent-600">Meer tijd voor zorg.</span>
      </h1>
      {/* De markt beweegt weg van all-in-one naar modulaire landschappen
          (M&I/Partners, vijf jaar ECD-marktonderzoek). "Eén systeem voor alles"
          leest dan als het model dat men juist verlaat, terwijl onze architectuur
          in werkelijkheid modulair is. Daarom expliciet: één systeem, onderdelen die
          u aanzet. De standaarden (FHIR, BgZ, MedMij) staan op /integraties: een
          bestuurder leest hier eerst wat het hem oplevert. */}
      <p class="mt-6 text-lg leading-relaxed text-ink-700 max-w-2xl">
        Eén systeem voor dossier, planning, declaratie en kwaliteit, gebouwd voor de Nederlandse
        VVT, gehandicaptenzorg en GGZ. U zet alleen aan wat u nodig hebt, en later bijzetten kan
        zonder overstap. Bij elk onderdeel staat eerlijk wat het vandaag kan.
      </p>
      {/* Elke concurrent in deze markt zet "demo aanvragen" als primaire actie —
          een verkoopgesprek. Wij hebben een werkende omgeving waar je zelf in kunt,
          en dat is het enige dat zij niet kunnen evenaren. Die staat dus vooraan;
          het gesprek blijft als tweede knop beschikbaar voor wie dat liever heeft.
          Tekst en bestemming van beide knoppen staan in src/config/demo.ts. */}
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={DEMO_ZELF.href} class="btn-primary no-underline">{DEMO_ZELF.label}</a>
        <a href={DEMO_GESPREK.href} class="btn-secondary no-underline">{DEMO_GESPREK.label}</a>
        <a href="/trust" class="ml-2 text-sm font-medium text-curanta-700 no-underline hover:underline">
          Of begin bij het Trust Centre →
        </a>
      </div>
      <p class="mt-8 text-sm text-ink-500">
        Verzonnen cliënten, u kunt niets stukmaken · Geen verkoopgesprek nodig
      </p>
    </div>
  </div>
</section>
