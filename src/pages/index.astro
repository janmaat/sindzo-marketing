---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ChallengeCallout from '../components/ChallengeCallout.astro';
import LogoStrip from '../components/LogoStrip.astro';
import UspGrid from '../components/UspGrid.astro';
import WhiteSpaceUsps from '../components/WhiteSpaceUsps.astro';
import SegmentTiles from '../components/SegmentTiles.astro';
import TrustBadges from '../components/TrustBadges.astro';
import DeadlineUrgency from '../components/DeadlineUrgency.astro';
import Cta from '../components/Cta.astro';

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Curanta',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  url: Astro.site?.toString() ?? 'https://curanta.nl',
  description: 'Eén modulaire zorgsuite voor dossier (ECD), planning, declaratie en kwaliteit voor de Nederlandse VVT, gehandicaptenzorg en GGZ. FHIR intern voor de BgZ.',
  inLanguage: 'nl-NL',
  provider: { '@type': 'Organization', name: 'Curanta' },
};

// Google haalt de sitenaam in de zoekresultaten uit WebSite-markup op de homepage;
// zonder dit gokt hij, en bij een jonge merknaam gokt hij soms "curanta.nl".
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Curanta',
  url: Astro.site?.toString() ?? 'https://curanta.nl/',
  inLanguage: 'nl-NL',
};
---
<Base title="Curanta — Eén zorgsuite voor de Nederlandse zorgpraktijk">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />
  <Hero />
  <ChallengeCallout />
  <LogoStrip />
  <UspGrid />
  <section class="container-prose pb-4">
    <div class="flex flex-col gap-3 rounded-xl border border-ink-200 bg-white p-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-ink-700">
        <span class="font-display text-xl font-bold text-ink-900">Vanaf €19 per medewerker per maand.</span>
        Implementatie, training en hosting zonder aparte kosten; het cliëntportaal is gratis.
      </p>
      <a href="/prijzen" class="btn-secondary no-underline whitespace-nowrap">Bekijk de prijzen</a>
    </div>
  </section>
  <WhiteSpaceUsps />
  <SegmentTiles />
  <TrustBadges />
  <DeadlineUrgency />
  <Cta />
</Base>
