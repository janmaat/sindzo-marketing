---
// Homepage, herzien oktober 2026. Dient als ontwerpvoorbeeld voor de andere pagina's.
//
// Opbouw: introductie met productscherm en twee acties → één bezoek van rooster tot declaratie →
// drie productvoorbeelden → doelgroepen → overstappen → gegevens en beveiliging → prijzen →
// kennismaken of partner worden.
//
// Vormgeving: compositie naar het voorbeeld van Canopy (Medium Rare, een Webflow-sjabloon): tekst
// links, groot beeld, rustige afwisseling van witte en lichte vlakken, één donkere band, ronde
// knoppen. Overgenomen zijn alleen die principes, geen code, beelden of iconen; daarvoor is geen
// licentie nodig. Lettertype en kleuren blijven die van Curanta.
//
// Elk feit staat in het feitenblad (D:\Repos\Ponscura\docs\campagne\feitenblad-curanta.md) of is
// op 08-10-2026 in de code nagelopen (zie docs/controlelijst-claims.md, "Nagelopen in de code").
// Wat nog bevestigd moet worden, staat in diezelfde controlelijst.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Screenshot from '../components/Screenshot.astro';
import StatusLabel from '../components/StatusLabel.astro';
import Icon from '../components/Icon.astro';
import { DEMO_ZELF, DEMO_GESPREK } from '../config/demo';
import type { Status } from '../config/status';

import zorgplan from '../assets/schermen/bo-zorgplan.jpg';
import rapportage from '../assets/schermen/mw-rapportage.jpg';
import portaalZorgplan from '../assets/schermen/pc-zorgplan.jpg';
import planbord from '../assets/schermen/bo-planbord.jpg';
import rooster from '../assets/schermen/mw-rooster.jpg';
import productie from '../assets/schermen/bo-productie.jpg';
import vim from '../assets/schermen/bo-vim.jpg';
import fotoVvt from '../assets/fotos/vvt-verzorgende-bewoner.jpg';
import fotoGhz from '../assets/fotos/ghz-ontbijt.jpg';
import fotoGgz from '../assets/fotos/ggz-gesprek.jpg';

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Curanta',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  url: Astro.site?.toString() ?? 'https://curanta.nl',
  description: 'Zorgsoftware voor de VVT, gehandicaptenzorg en GGZ: cliëntdossier, planning, medewerkerportaal, declaratie en kwaliteit in één systeem.',
  inLanguage: 'nl-NL',
  provider: { '@type': 'Organization', name: 'Curanta' },
};

// Google haalt de sitenaam in de zoekresultaten uit WebSite-markup op de homepage;
// zonder dit gokt hij, en bij een jonge merknaam gokt hij soms "curanta.nl".
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Curanta',
  url: Astro.site?.toString() ?? 'https://curanta.nl/',
  inLanguage: 'nl-NL',
};

// Eén bezoek in de wijk. Per stap: wie, wat die persoon doet, wat Curanta daarbij doet.
// Roostertoets: harde regels blokkeren het publiceren, alleen met een gekozen cao
// (ShiftService.cs, Planbord.razor). Retourberichten: inlezen door de XML te plakken, daarna
// gegroepeerd per oorzaak in de retourtriage (RetourInlezenDialog, RetourTriage.razor).
const werkdag = [
  {
    icoon: 'agenda',
    wie: 'Planner',
    titel: 'Zet het bezoek in het rooster',
    tekst: 'Bij publiceren toetst Curanta het rooster aan de Arbeidstijdenwet en de cao die u hebt gekozen. Een dienst met te weinig rust ervoor wordt niet gepubliceerd; de planner ziet waarom.',
  },
  {
    icoon: 'telefoon',
    wie: 'Zorgmedewerker',
    titel: 'Opent het bezoek op de telefoon',
    tekst: 'Met de taken uit het zorgplan en de overdracht van een collega. Zij meldt aankomst en vertrek. Zonder bereik bewaart de telefoon dat versleuteld en verstuurt het zodra er weer verbinding is.',
  },
  {
    icoon: 'dossier',
    wie: 'Zorgmedewerker',
    titel: 'Schrijft de rapportage',
    tekst: 'In SOEP-vorm, gekoppeld aan een probleem uit het zorgplan. Metingen uit het bezoek staan al ingevuld. De wijkverpleegkundige leest de rapportage terug in het dossier als zij het zorgplan evalueert.',
  },
  {
    icoon: 'euro',
    wie: 'Administratie',
    titel: 'Declareert wat er geleverd is',
    tekst: 'Het bezoek wordt een productieregel, met de bron erbij, en de coördinator keurt hem goed. Uit goedgekeurde productie stelt de administratie de declaratie op voor gemeente of zorgkantoor. Een retourbericht leest zij zelf in; Curanta zet de afkeuringen per oorzaak bij elkaar.',
  },
] as const;

interface Beeld { src: ImageMetadata; alt: string; adres: string; bijschrift: string; }
interface Voorbeeld {
  id: string;
  kop: string;
  wie: string;
  doet: string;
  curanta: string[];
  statussen: { status: Status; tekst: string }[];
  ai?: string;
  beperking?: string;
  link: { label: string; href: string };
  beelden: Beeld[];
}

const voorbeelden: Voorbeeld[] = [
  {
    id: 'dossier',
    kop: 'Cliëntdossier en rapportage',
    wie: 'De wijkverpleegkundige, verzorgende, begeleider of behandelaar.',
    doet: 'Legt na elk bezoek de rapportage vast, werkt bij de evaluatie het zorgplan bij en deelt een document met de cliënt of de mantelzorger.',
