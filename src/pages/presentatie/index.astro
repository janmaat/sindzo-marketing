---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import { DEMO_GESPREK } from '../../config/demo';
import { groups as onderdeelGroepen, AANTAL_ONDERDELEN } from '../../config/onderdelen';

// Landingspagina van de campagne (22-10-2026). De eerste bezoekers uit een ChatGPT-advertentie vertrokken binnen 3 tot
// 16 seconden: de pagina ging ervan uit dat zij Curanta al kenden, en het beeld van de presentatie leek een video maar
// speelde niet af. Nu zegt het eerste scherm wat Curanta is (dezelfde feiten als de homepage), speelt één deel van de
// presentatie meteen af, en vraagt het formulier alleen wat nodig is om de aanvraag te beoordelen.
// De video is deel 3 van de basispresentatie voor de wijkverpleging (Ponscura: artifacts/presentatie/bibliotheek/
// basis-vvt/video), opnieuw verpakt zonder de ondertitelstroom en met +faststart; de ondertitels staan ernaast als .vtt
// (.htaccess serveert die als text/vtt; met nosniff weigert de browser ze anders). Geen deel 2 "Waarom Curanta": dat
// opent met "waarom wij toch met Curanta komen", en dat past niet bij een volwaardig product (besluit Jan 21-10-2026).
//
// Twee varianten (22-10-2026). De ChatGPT-advertentiegroep heet "Verpleeghuiszorg – online presentatie" (Ponscura:
// docs/campagne/chatgpt/PLAN-chatgpt-ads.md). Wie daaruit komt, of met ?zorgvorm=verpleeghuis, ziet deel 3 van de
// verpleeghuispresentatie, en het formulier staat dan al op VVT en verpleeghuiszorg; de bezoeker kan het aanpassen.
// Een nieuwe campagne voor één zorgvorm: zet haar utm_campaign in CAMPAGNE_ZORGVORM in het script onderaan.
// Zonder script ziet iedereen de video voor de wijkverpleging.
const videos = [
  {
    zorgvorm: 'wijkverpleging',
    bestand: 'het-werk-in-de-wijk',
    kop: 'Het werk in de wijk',
    tekst: 'Deel 3 van de presentatie voor de wijkverpleging, 2:55 minuten. De wijkverpleegkundige stelt het zorgplan op, de planner maakt er een rooster van, en de zorgmedewerker werkt onderweg op de telefoon, ook zonder bereik.',
    mb: '7,9',
  },
  {
    zorgvorm: 'verpleeghuis',
    bestand: 'indicatie-opname-en-zorg',
    kop: 'Indicatie, opname en zorg',
    tekst: 'Deel 3 van de presentatie voor het verpleeghuis, 1:47 minuten. Van het besluit van het CIZ en de toewijzing van het zorgkantoor tot de opname op afdeling, kamer en bed. Daarna het zorgplan, de toedienlijst en de overdracht aan het eind van de dienst.',
    mb: '4,2',
  },
];
//
// Een presentatie aanvragen (ADR 2026-10-11 in Ponscura; besluit Jan 24-10-2026). De aanvraag gaat naar app.curanta.nl
// (POST /api/presentatie-aanvraag). Met een zakelijk maildomein gaat de uitnodiging voor presentatie.curanta.nl meteen
// de deur uit en kijkt Jan achteraf; met een gratis maildomein (gmail, hotmail, ...; de lijst staat in de module)
// beoordeelt Jan de aanvraag eerst. Een afgewezen aanvrager krijgt een korte, vriendelijke mail, behalve bij spam.
// Geen captcha (de site laadt geen scripts van derden): honeypot, invultijd en een snelheidsrem op de server.
// Aanbeveling 10 (24-10-2026): wat de bezoeker krijgt, met de vijf delen en hun duur. Titels en duur komen uit de
// presentatiecatalogus (Ponscura: src/Modules/Platform/Ponscura.Platform.Presentatie/Catalogus/presentatiecatalogus.json,
// duurSeconden, stand 24-10-2026). Verandert een video, dan hier ook.
const introductie: Record<string, { titel: string; delen: [string, number][] }> = {
  wijkverpleging: { titel: 'de wijkverpleging', delen: [['Uw organisatie', 125], ['Waarom Curanta', 148], ['Het werk in de wijk', 175], ['De cliënt, privacy en het geld', 123], ['Samen starten', 149]] },
  verpleeghuis: { titel: 'het verpleeghuis', delen: [['Uw organisatie', 107], ['Waarom Curanta', 119], ['Indicatie, opname en zorg', 107], ['Roosteren', 132], ['Privacy, het geld en samen starten', 146]] },
};
const mmss = (sec: number) => `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;
const minuten = (delen: [string, number][]) => Math.round(delen.reduce((n, [, s]) => n + s, 0) / 60);
// "Uw overstap in één project" (catalogus: implementatie-project, vier delen: 76 + 94 + 143 + 186 seconden = 8:19).
const overstapProject: [string, number][] = [['Wat er op mensen afkomt', 76], ['Uw eigen project', 94], ['Hoe het werk loopt', 143], ['De overstap zelf', 186]];
const overstapMinuten = Math.floor(overstapProject.reduce((n, [, s]) => n + s, 0) / 60);

// Wat een koper zelf kan nakijken, in plaats van klantnamen of citaten (die staan er niet: feitenblad, rij Klanten).
// Elke zin volgt het feitenblad: Migratie, Geen dubbele kosten, Overstap in het implementatieproject, VECOZO,
// NEN 7510:2024, Export en Exit, Positionering (aantal onderdelen uit src/config/onderdelen.ts), Prijzen, en het
// programma van eisen voor een overstap (36 eisen, dertien vragen; Documenten voor inkoop).
const nakijken = [
  {
    kop: 'De overstap',
    tekst: 'Cliënten en medewerkers importeert u uit een CSV- of Excelbestand, met een sjabloon uit Curanta. Eerst zetten wij uw gegevens één keer op proef over; u controleert de aantallen en een steekproef. Loopt uw huidige contract nog, dan betaalt u het abonnement pas vanaf het einde van dat contract, tot hoogstens zes maanden na de start.',
    link: { label: 'Overstappen', href: '/overstappen' },
  },
  {
    kop: 'Declareren via VECOZO',
    tekst: 'Berichten voor de Wmo, de Jeugdwet en de Wlz toetst Curanta bij het opstellen aan het officiële schema. Standaard levert u ze zelf aan, in het VECOZO-portaal of bij het zorgkantoor. Rechtstreeks aanleveren via VECOZO is ingericht; wij beproeven het per organisatie in de testomgeving van VECOZO, vóór uw eerste declaratiemaand.',
    link: { label: 'Koppelingen', href: '/integraties' },
  },
  {
    kop: 'NEN 7510',
    tekst: 'De maatregelen van NEN 7510:2024 zijn ingevoerd. De externe audit staat gepland voor het vierde kwartaal van 2026; een certificaat heeft Curanta dus nog niet. Per beveiligingsonderwerp staat de stand in het Trust Centre.',
    link: { label: 'Trust Centre', href: '/trust' },
  },
  {
    kop: 'Breedte en prijs',
    tekst: `${AANTAL_ONDERDELEN} onderdelen in ${onderdeelGroepen.length} groepen, van het cliëntdossier en de planning tot declaratie, kwaliteit en HRM, met per onderdeel de stand. De prijs staat per plan op de site: €19 tot €39 per actieve medewerker per maand.`,
    link: { label: 'Alle onderdelen', href: '/oplossing' },
  },
  {
    kop: 'Weer weggaan',
    tekst: 'Gaat u weg, dan krijgt u binnen 5 werkdagen een volledige export van uw gegevens en bestanden in JSON. Een exit-fee rekenen wij niet.',
    link: { label: 'Uw gegevens mee', href: '/overstappen#eruit' },
  },
  {
    kop: 'Eisen voor elke leverancier',
    tekst: 'Het programma van eisen voor een overstap (36 eisen) en de dertien vragen aan uw huidige leverancier zijn leverancier-neutraal. U legt ze naast elk pakket, ook naast Curanta. De overstapscan maakt er een planning bij, terug vanaf de einddatum van uw contract.',
    link: { label: 'Programma van eisen', href: '/overstappen/programma-van-eisen' },
  },
];

// Aanbeveling 9 (24-10-2026): "Hoe kwam u bij ons?", optioneel. Veldnamen en waarden zijn die van de API van de
// presentatiemodule in Ponscura (PresentatieGevondenVia: gevonden_via en gevonden_via_toelichting); een andere waarde
// telt daar als niet ingevuld. Een leeg veld is geen fout. Een link kan de keuze vooraf invullen met
// ?gevonden_via=<waarde> (bijvoorbeeld vanaf /adviseurs).
const gevondenVia = [
  { waarde: 'zoekmachine', label: 'Zoekmachine (Google, Bing)' },
  { waarde: 'ai-assistent', label: 'AI-assistent (ChatGPT e.d.)' },
  { waarde: 'linkedin', label: 'LinkedIn' },
  { waarde: 'collega', label: 'Collega of netwerk' },
  { waarde: 'adviseur', label: 'Adviseur of selectiebureau' },
  { waarde: 'evenement', label: 'Congres of evenement' },
  { waarde: 'advertentie', label: 'Advertentie' },
  { waarde: 'anders', label: 'Anders' },
];

const formAction = `${import.meta.env.PUBLIC_APP_URL ?? 'https://app.curanta.nl'}/api/presentatie-aanvraag`;
const veld = 'mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500';
---
<Base
  image="/og/presentatie.png"
  title="Online presentatie aanvragen | Curanta"
  description="Curanta: dossier, planning, declaratie en kwaliteit in één systeem, €19 tot €39 per medewerker per maand. Bekijk een deel van de presentatie meteen."
>
  <PageHero
    eyebrow="Online presentatie"
    title="Zorgsoftware die u eerst rustig kunt bekijken"
    subtitle="Curanta is één systeem voor het cliëntdossier, de planning, de declaratie en de kwaliteit, in de ouderen- en thuiszorg, de gehandicaptenzorg en de ggz. U betaalt €19 tot €39 per actieve medewerker per maand."
  >
    {/* Advies 20-10-2026: op een telefoon (390×844) stond er geen aanvraagknop in het eerste scherm. De eerste knop
        springt naar het formulier, de tweede naar de video, voor wie eerst wil zien wat hij aanvraagt. */}
    <div slot="actions">
      <div class="flex flex-wrap items-center gap-3">
        <a href="#presentatie-aanvraag" class="btn-primary btn-lg no-underline">Online presentatie aanvragen</a>
        <a href="#video" class="btn-secondary btn-lg no-underline">Eerst een deel bekijken</a>
      </div>
      <p class="mt-3 text-sm text-ink-600">Met een zakelijk e-mailadres krijgt u uw persoonlijke link meestal binnen enkele minuten per mail. Met een ander adres bekijken wij uw aanvraag eerst, meestal binnen 1 werkdag.</p>
    </div>
  </PageHero>

  {/* Aanbeveling 11 (24-10-2026): wie met ?van=stoppend komt (vanaf /overstappen/pakket-stopt of de overstapscan),
      ziet eerst dit blok. Bewust zonder leveranciersnaam op /presentatie (besluit Jan 24-10-2026); de namen en de
      bronnen staan op /overstappen/pakket-stopt. Zonder script blijft het verborgen. */}
  <section id="overstap-nu" data-van="stoppend" class="hidden container-prose pt-12">
    <div class="mx-auto max-w-4xl rounded-2xl border border-curanta-100 bg-curanta-50/60 p-7">
      <h2 class="font-display text-2xl font-bold text-curanta-900">Stopt uw huidige pakket?</h2>
      <p class="mt-3 max-w-3xl text-ink-700">
        Dan wilt u vooral weten hoe de overstap gaat. Daarover gaat <strong class="font-semibold text-ink-900">Uw overstap in
        één project</strong>, een onderdeel van de presentatie: vier korte video's van samen ruim {overstapMinuten} minuten.
      </p>
      <ol class="mt-4 grid gap-2 text-sm text-ink-700 sm:grid-cols-2">
        {overstapProject.map(([titel, sec], i) => (
          <li class="flex gap-3"><span class="font-semibold text-curanta-700 tabular-nums">{i + 1}.</span><span>{titel} <span class="tabular-nums text-ink-500">({mmss(sec)})</span></span></li>
        ))}
      </ol>
      <p class="mt-4 max-w-3xl text-sm text-ink-700">
        Wilt u eerst een planning? De <a href="/overstapscan" class="text-curanta-700 hover:underline">overstapscan</a>
        rekent terug vanaf de einddatum van uw pakket. Wat u van elke volgende leverancier vraagt, staat in
        <a href="/overstappen/programma-van-eisen" class="text-curanta-700 hover:underline">het programma van eisen voor een overstap</a>.
      </p>
    </div>
  </section>

  <section id="video" class="container-prose scroll-mt-24 pt-12">
    <div class="mx-auto max-w-4xl">
      {videos.map((v, i) => (
        <div data-video-zorgvorm={v.zorgvorm} class={i === 0 ? '' : 'hidden'}>
          <h2 id={`video-kop-${v.zorgvorm}`} class="font-display text-2xl font-bold text-curanta-900 sm:text-3xl">{v.kop}</h2>
          <p class="mt-2 max-w-2xl text-pretty text-ink-700">{v.tekst}</p>
          {/* preload="none": de video laadt pas als de bezoeker op afspelen drukt; tot dan staat er een dia uit de video. */}
          <video class="mt-5 aspect-video w-full rounded-xl border border-ink-200 bg-ink-900 shadow-sm"
                 controls preload="none" playsinline width="1920" height="1080"
                 poster={`/video/${v.bestand}.jpg`}>
            <source src={`/video/${v.bestand}.mp4`} type="video/mp4" />
            <track kind="captions" src={`/video/${v.bestand}.vtt`} srclang="nl" label="Nederlands" default />
            <a href={`/video/${v.bestand}.mp4`}>Download de video (mp4, {v.mb} MB)</a>
          </video>
        </div>
      ))}
      <div class="mt-8 rounded-2xl border border-ink-100 bg-ink-100/50 p-6 sm:p-8">
        <h2 class="font-display text-xl font-semibold text-ink-900">Wat u in de presentatie ziet</h2>
        {Object.entries(introductie).map(([zorgvorm, intro], i) => (
          <div data-video-zorgvorm={zorgvorm} class={i === 0 ? '' : 'hidden'}>
            <p class="mt-2 text-sm text-ink-700">
              U begint met de introductie voor {intro.titel}: vijf korte delen van samen ongeveer {minuten(intro.delen)} minuten.
            </p>
            <ol class="mt-4 grid gap-2 text-sm text-ink-700 sm:grid-cols-2">
              {intro.delen.map(([titel, sec], j) => (
                <li class="flex gap-3"><span class="font-semibold text-curanta-700 tabular-nums">{j + 1}.</span><span>{titel} <span class="tabular-nums text-ink-500">({mmss(sec)})</span></span></li>
              ))}
            </ol>
          </div>
        ))}
        <p class="mt-4 text-sm text-ink-700">
          Daarna kijkt u verder wanneer het u uitkomt: schermvideo's uit Curanta zelf, de dia's om na te lezen, en
          "Uw overstap in één project". Voor de gehandicaptenzorg, de ggz, de kraamzorg en de jeugdzorg is er een eigen
          introductie van 11 tot 13 minuten.
        </p>
        <a href="#presentatie-aanvraag" class="btn-primary mt-5 inline-block no-underline">Online presentatie aanvragen</a>
      </div>
    </div>
  </section>

  <section class="container-prose pt-16" aria-labelledby="nakijken-kop">
    <div class="mx-auto max-w-4xl">
      <h2 id="nakijken-kop" class="font-display text-2xl font-bold text-curanta-900 sm:text-3xl">Wat u zelf kunt nakijken</h2>
      <p class="mt-2 max-w-2xl text-pretty text-ink-700">
        U kiest een pakket voor jaren. Op de vragen die bij een overstap het zwaarst wegen, staat hier het antwoord, met
        de pagina waar u het naleest.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {nakijken.map((n) => (
          <li class="flex flex-col rounded-2xl border border-ink-100 bg-white p-6">
            <h3 class="font-display text-lg font-semibold text-ink-900">{n.kop}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-700">{n.tekst}</p>
            <a href={n.link.href} class="mt-3 text-sm font-semibold text-curanta-700 no-underline hover:underline">{n.link.label} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-prose py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <form id="presentatie-aanvraag" action={formAction} method="post" class="scroll-mt-24 rounded-2xl border border-ink-100 bg-white p-8" novalidate>
        <HoneypotField />
        {/* Ingevuld door het script: de campagnebron uit de URL, en hoe lang het invullen duurde. */}
        <input type="hidden" name="utm_source" />
        <input type="hidden" name="utm_medium" />
        <input type="hidden" name="utm_campaign" />
        <input type="hidden" name="utm_term" />
        <input type="hidden" name="utm_content" />
        <input type="hidden" name="invultijd" />
        {/* "stoppend" als de bezoeker met ?van=stoppend kwam (aanbeveling 11); anders uitgeschakeld en niet verstuurd. */}
        <input type="hidden" name="van" disabled />
        {/* De klikcode van Google (gclid, of bij een deel van het iOS-verkeer gbraid of wbraid) gaat alléén mee als de
            bezoeker het vakje "advertentiemeting" aanvinkt (zoals op /demo, sinds 20-10-2026); een uitgeschakeld veld
            wordt niet verstuurd. */}
        <input type="hidden" name="gclid" disabled />
        <input type="hidden" name="gbraid" disabled />
        <input type="hidden" name="wbraid" disabled />

        <h2 class="font-display text-xl font-semibold text-ink-900">Vraag de hele presentatie aan</h2>

        {/* Verplicht staat voorop (22-10-2026): naam, e-mail, organisatie, sector. Telefoon, functie en toelichting staan
            in de uitklapper hieronder; de server behandelt ze als optioneel, zoals voorheen. */}
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Naam</span>
            <input required type="text" name="naam" autocomplete="name" maxlength="120" class={veld} />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Zakelijk e-mailadres</span>
            <input required type="email" name="email" autocomplete="email" maxlength="254" class={veld} />
            <span class="mt-1 block text-xs text-ink-500">Hierheen sturen wij uw persoonlijke link.</span>
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Organisatie</span>
            <input required type="text" name="organisatie" autocomplete="organization" maxlength="160" class={veld} />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Sector</span>
            <select required name="sector" class={veld}>
              <option value="">Kies een sector</option>
              <option value="vvt">VVT (thuiszorg en verpleeghuis)</option>
              <option value="ghz">Gehandicaptenzorg</option>
              <option value="ggz">GGZ</option>
              <option value="kraamzorg">Kraamzorg</option>
              <option value="jeugdzorg">Jeugdzorg</option>
              <option value="anders">Anders</option>
            </select>
            <span class="mt-1 block text-xs text-ink-500">De presentatie gaat over uw sector.</span>
          </label>
        </div>

        {/* Bij VVT: de wijkverpleging en het verpleeghuis zijn twee presentaties (opmerkingen 17-10-2026, keuze Jan
            19-10-2026). Het script toont dit veld alleen bij VVT en maakt het dan verplicht; zonder script staat het er
            altijd en mag het leeg blijven, en dan kiest Curanta bij het goedkeuren. Curanta neemt het alleen bij VVT over. */}
        <label class="mt-5 block" id="zorgvorm-veld">
          <span class="text-sm font-semibold text-ink-900">Welke zorg levert uw organisatie? <span class="font-normal text-ink-500">(bij VVT)</span></span>
          <select name="zorgvorm" class={veld}>
            <option value="">Kies wat u levert</option>
            <option value="wijkverpleging">Wijkverpleging, bij de cliënt thuis</option>
            <option value="verpleeghuis">Verpleeghuiszorg</option>
            <option value="beide">Allebei</option>
          </select>
          <span class="mt-1 block text-xs text-ink-500">Voor de wijkverpleging en het verpleeghuis is er elk een eigen presentatie. Levert u allebei, dan krijgt u ze allebei.</span>
        </label>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Hoe kwam u bij ons? <span class="font-normal text-ink-500">(optioneel)</span></span>
            <select name="gevonden_via" class={veld}>
              <option value="">Kies een antwoord</option>
              {gevondenVia.map((h) => <option value={h.waarde}>{h.label}</option>)}
            </select>
          </label>
          {/* Zonder script altijd zichtbaar; met script pas na een keuze. */}
          <label class="block" id="gevonden-via-toelichting-veld">
            <span class="text-sm font-semibold text-ink-900">Wie of welke? <span class="font-normal text-ink-500">(optioneel)</span></span>
            <input type="text" name="gevonden_via_toelichting" maxlength="200" class={veld}
                   placeholder="Bijvoorbeeld het adviesbureau of het congres" />
          </label>
        </div>

        <details id="meer-vertellen" class="group mt-5 rounded-md border border-ink-100 px-4 py-3">
          <summary class="cursor-pointer text-sm font-semibold text-curanta-700">Meer vertellen (optioneel): telefoon, functie, uw vraag</summary>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold text-ink-900">Telefoon</span>
              <input type="tel" name="telefoon" autocomplete="tel" maxlength="40" class={veld} />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-ink-900">Functie</span>
              <select name="functie" class={veld}>
                <option value="">Kies een functie</option>
                <option>Bestuurder / RvB</option>
                <option>Manager I&amp;A / CIO</option>
                <option>CMIO / CNIO / zorginhoudelijk leider</option>
                <option>Manager zorg</option>
                <option>Functioneel beheer</option>
                <option>FG / CISO / privacy</option>
                <option>Finance / control</option>
                <option>Anders</option>
              </select>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-sm font-semibold text-ink-900">Waar wilt u vooral meer over weten?</span>
              <textarea name="toelichting" rows="3" maxlength="1000"
                        placeholder="Bijvoorbeeld: rapporteren bij de cliënt, de planning, of overstappen van ons huidige ECD"
                        class={veld}></textarea>
            </label>
          </div>
        </details>

        <label class="mt-5 flex items-start gap-3 text-sm text-ink-700">
          <input required type="checkbox" name="toestemming" value="yes"
                 class="mt-0.5 h-4 w-4 rounded border-ink-300 text-curanta-600 focus:ring-curanta-500" />
          <span>
            Ik ga akkoord met de verwerking van mijn gegevens volgens de
            <a href="/privacy#welke-data" class="text-curanta-700 hover:underline">privacyverklaring</a>.
            Geen marketinglijst, geen doorverkoop.
          </span>
        </label>

        {/* Alleen zichtbaar voor wie via een Google-advertentie binnenkwam (gclid in de URL). Aanvinken = toestemming voor
            "Ad User Data" in de conversie-upload; zonder vinkje verlaat de klikcode dit formulier niet. */}
        <label id="advertentiemeting" class="hidden mt-3 flex items-start gap-3 text-sm text-ink-700">
          <input type="checkbox" name="adMeting" value="yes"
                 class="mt-0.5 h-4 w-4 rounded border-ink-300 text-curanta-600 focus:ring-curanta-500" />
          <span>
            Optioneel: u kwam binnen via een advertentie van ons. Mogen wij Google laten weten
            dát deze advertentie tot een aanvraag leidde? Wij geven daarbij alleen de klik-code
            van de advertentie en het tijdstip door. Geen naam, e-mailadres of organisatie.
            <a href="/privacy#delen" class="text-curanta-700 hover:underline">Meer hierover</a>.
          </span>
        </label>

        <p id="aanvraag-melding" role="alert" tabindex="-1" class="hidden mt-5 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"></p>
        <button type="submit" class="btn-primary mt-7">Online presentatie aanvragen</button>
        <p class="mt-4 text-xs text-ink-500">
          Vragen vooraf? Bel <a href="tel:+31852501301" class="text-curanta-700 hover:underline">085 250 1301</a>
          of mail <a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a>.
        </p>
      </form>

      <aside class="space-y-6">
        <div class="rounded-2xl border border-ink-100 bg-ink-100/50 p-6">
          <h2 class="font-display text-lg font-semibold text-ink-900">Zo gaat het</h2>
          <ol class="mt-4 space-y-3 text-sm text-ink-700">
            <li class="flex gap-3">
              <span class="font-semibold text-curanta-700">1.</span>
              <span>U vraagt de presentatie aan met dit formulier.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-semibold text-curanta-700">2.</span>
              <span>Met een zakelijk e-mailadres krijgt u meteen een mail met een persoonlijke link en een toegangscode.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-semibold text-curanta-700">3.</span>
              <span>Met een ander adres, bijvoorbeeld van gmail of hotmail, bekijken wij uw aanvraag eerst, meestal binnen 1 werkdag. Daarna krijgt u een mail.</span>
            </li>
          </ol>
          <p class="mt-4 text-sm text-ink-700">
            De link en de code zijn 30 dagen geldig en alleen voor u. Is de link verlopen, dan vraagt u zelf een nieuwe aan.
            Wil een collega ook kijken? Elke collega krijgt een eigen link; in de presentatie staat hoe.
          </p>
        </div>
        <div class="rounded-2xl border border-ink-100 bg-white p-6">
          <h2 class="font-display text-lg font-semibold text-ink-900">Liever dat wij langskomen?</h2>
          <p class="mt-2 text-sm text-ink-700">
            Wij laten Curanta ook op locatie zien, aan de hand van uw eigen zorgproces. Uw collega's schuiven gewoon aan.
          </p>
          <a href={DEMO_GESPREK.href} class="mt-3 inline-block text-sm font-semibold text-curanta-700 no-underline hover:underline">Vraag een presentatie op locatie aan →</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script is:inline>
  // Campagnebron uit de URL, de invultijd, en versturen zonder de pagina te verlaten (zoals op /demo). Zonder
  // JavaScript blijft de gewone POST werken: de server stuurt dan door naar /presentatie/aangevraagd, of terug
  // hierheen met ?fout=.
  (function () {
    var form = document.getElementById('presentatie-aanvraag');
    var melding = document.getElementById('aanvraag-melding');
    if (!form || !melding) return;
    var start = Date.now();
    var here = new URLSearchParams(window.location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) {
      var v = here.get(k);
      if (v) form.elements[k].value = v.slice(0, 200);
    });

    var labels = { naam: 'uw naam', email: 'uw e-mailadres', organisatie: 'de organisatie', functie: 'de functie',
      telefoon: 'het telefoonnummer', toelichting: 'de toelichting', toestemming: 'het vakje voor de privacyverklaring',
      sector: 'de sector', zorgvorm: 'welke zorg u levert', gevonden_via: 'hoe u bij ons kwam',
      gevonden_via_toelichting: 'wie of welke' };
    var contact = ' Lukt het niet? Bel 085 250 1301 of mail info@curanta.nl.';
    var knop = form.querySelector('button[type="submit"]');
    var zorgvormVeld = document.getElementById('zorgvorm-veld');

    function isVvt() { return form.elements['sector'].value === 'vvt'; }
    function toonZorgvorm() {
      if (!zorgvormVeld) return;
      zorgvormVeld.classList.toggle('hidden', !isVvt());
      form.elements['zorgvorm'].required = isVvt();
      if (!isVvt()) form.elements['zorgvorm'].value = '';
    }
    // Vanuit de overstapscan (21-10-2026): sector, zorgvorm en een korte samenvatting staan in de URL, alleen als de
    // bezoeker daar zelf op "Online presentatie aanvragen" klikte. Alleen bekende waarden; de bezoeker past het aan.
    ['sector', 'zorgvorm', 'gevonden_via'].forEach(function (k) {
      var v = here.get(k), el = form.elements[k];
      if (v && el && Array.prototype.some.call(el.options, function (o) { return o.value === v; })) el.value = v;
    });
    var uitScan = here.get('toelichting');
    if (uitScan && !form.elements['toelichting'].value) form.elements['toelichting'].value = uitScan.slice(0, 1000);
    // De optionele velden staan ingeklapt. Open ze als er al iets in staat (overstapscan, of 'vorige' in de browser).
    var meer = document.getElementById('meer-vertellen');
    function openMeer() { if (meer) meer.open = true; }
    if (['telefoon', 'functie', 'toelichting'].some(function (k) { return form.elements[k].value; })) openMeer();

    // Campagnes voor één zorgvorm (zie de toelichting bij `videos` bovenin): de bezoeker ziet de video voor die
    // zorgvorm, en het formulier staat er al op, tenzij de URL zelf een sector of zorgvorm meegeeft.
    var CAMPAGNE_ZORGVORM = { 'curanta_nl_presentatie_test_202610': 'verpleeghuis' };
    var uitCampagne = CAMPAGNE_ZORGVORM[here.get('utm_campaign')];
    if (uitCampagne && !here.get('sector') && !here.get('zorgvorm')) {
      form.elements['sector'].value = 'vvt';
      form.elements['zorgvorm'].value = uitCampagne;
    }
    var videoZorgvorm = here.get('zorgvorm') || uitCampagne;
    var varianten = document.querySelectorAll('[data-video-zorgvorm]');
    if (Array.prototype.some.call(varianten, function (el) { return el.getAttribute('data-video-zorgvorm') === videoZorgvorm; })) {
      Array.prototype.forEach.call(varianten, function (el) {
        el.classList.toggle('hidden', el.getAttribute('data-video-zorgvorm') !== videoZorgvorm);
      });
    }

    form.elements['sector'].addEventListener('change', toonZorgvorm);
    toonZorgvorm();

    // "Hoe kwam u bij ons?": het vrije veld verschijnt pas na een keuze (zonder script staat het er altijd).
    var gevondenViaToelichting = document.getElementById('gevonden-via-toelichting-veld');
    function toonGevondenViaToelichting() {
      if (gevondenViaToelichting) gevondenViaToelichting.classList.toggle('hidden', !form.elements['gevonden_via'].value);
    }
    form.elements['gevonden_via'].addEventListener('change', toonGevondenViaToelichting);
    toonGevondenViaToelichting();

    // Wie met ?van=stoppend komt (aanbeveling 11), ziet eerst het blok over de overstap, en de aanvraag krijgt
    // van=stoppend mee. Alleen deze ene waarde; zonder de parameter gaat het veld niet mee.
    if (here.get('van') === 'stoppend') {
      var blok = document.getElementById('overstap-nu');
      if (blok) blok.classList.remove('hidden');
      form.elements['van'].value = 'stoppend';
      form.elements['van'].disabled = false;
    }

    // De klikcode van een Google-advertentie (gclid, gbraid of wbraid) gaat alleen mee met het vinkje (zoals op /demo).
    var klikVelden = ['gclid', 'gbraid', 'wbraid']
      .filter(function (k) { return here.get(k); })
      .map(function (k) { var el = form.elements[k]; el.value = here.get(k).slice(0, 200); return el; });
    if (klikVelden.length) {
      var vinkje = form.elements['adMeting'];
      document.getElementById('advertentiemeting').classList.remove('hidden');
      // Ook bij terugkeren via 'vorige': de browser herstelt het vinkje, niet de disabled-stand.
      var zetKlikVelden = function () { klikVelden.forEach(function (el) { el.disabled = !vinkje.checked; }); };
      zetKlikVelden();
      vinkje.addEventListener('change', zetKlikVelden);
    }

    function toon(tekst) {
      melding.textContent = tekst;
      melding.classList.remove('hidden');
      melding.focus();
      if (knop) { knop.disabled = false; knop.removeAttribute('aria-busy'); }
    }

    function velden(lijst) {
      // Een fout in een ingeklapt veld moet de bezoeker kunnen zien.
      if (lijst.some(function (v) { return v === 'telefoon' || v === 'functie' || v === 'toelichting'; })) openMeer();
      var namen = lijst.map(function (v) { return labels[v] || v; });
      var tekst = namen.length > 1 ? namen.slice(0, -1).join(', ') + ' en ' + namen[namen.length - 1] : namen[0];
      return 'Controleer ' + tekst + '.';
    }

    var fout = here.get('fout');
    if (fout === 'storing') {
      toon('Aanvragen lukt op dit moment niet.' + contact);
    } else if (fout) {
      toon(velden(fout.split(',')));
    }

    form.addEventListener('submit', function (e) {
      form.elements['invultijd'].value = String(Date.now() - start);
      if (!window.fetch || !window.FormData) return;
      e.preventDefault();
      var ontbreekt = ['naam', 'email', 'organisatie', 'sector'].filter(function (v) { return !form.elements[v].value.trim(); });
      if (isVvt() && !form.elements['zorgvorm'].value) ontbreekt.push('zorgvorm');
      if (!form.elements['toestemming'].checked) ontbreekt.push('toestemming');
      if (ontbreekt.length) { toon(velden(ontbreekt)); return; }
      melding.classList.add('hidden');
      if (knop) { knop.disabled = true; knop.setAttribute('aria-busy', 'true'); }
      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
        credentials: 'omit'
      }).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (d) {
          if (r.ok && d && d.redirect) { window.location.href = d.redirect; return; }
          if (r.status === 400 && d && d.velden) { toon(velden(d.velden) + ' Pas het aan en verstuur opnieuw.'); return; }
          if (r.status === 429 || (r.status === 503 && !(d && d.fout))) {
            toon('U heeft zojuist al een aanvraag verstuurd. Probeer het over een paar minuten opnieuw.' + contact); return;
          }
          toon('Het versturen is niet gelukt; uw gegevens staan nog in het formulier. Probeer het zo opnieuw.' + contact);
        });
      }).catch(function () {
        toon('Het versturen is niet gelukt door een verbindingsprobleem; uw gegevens staan nog in het formulier.' + contact);
      });
    });
  })();
</script>
