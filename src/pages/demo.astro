---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HoneypotField from '../components/HoneypotField.astro';

// Form-action wijst naar de app-side endpoint zodat leads direct in de CRM
// landen — geen Hubspot of separate lead-store nodig. Implementeer
// AllowAnonymous-endpoint /api/lead in Curanta.Host.
const formAction = 'https://app.curanta.nl/api/lead';
---
<Base
  title="Demo aanvragen — Curanta"
  description="Demo op uw eigen zorgproces. Reactie binnen 1 werkdag. Geen verkoopdruk."
>
  <PageHero
    eyebrow="Demo aanvragen"
    title="Demo op uw eigen werkprocessen."
    subtitle="Stuur drie typische werkstromen uit uw organisatie. Wij laten zien hoe Curanta ze ondersteunt — geen scripted sales-pitch."
  />

  <section class="container-prose py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <form action={formAction} method="post" class="rounded-2xl border border-ink-100 bg-white p-8">
        <input type="hidden" name="source" value="marketing/demo" />
        <input type="hidden" name="product" value="curanta" />
        <HoneypotField />
        {/* Campagnebron — gevuld door het script onderaan uit de URL (zie Base.astro). */}
        <input type="hidden" name="utm_source" />
        <input type="hidden" name="utm_medium" />
        <input type="hidden" name="utm_campaign" />
        <input type="hidden" name="utm_term" />
        <input type="hidden" name="utm_content" />
        {/* gclid gaat alléén mee als de bezoeker het vakje "advertentiemeting" aanvinkt;
            een uitgeschakeld veld wordt niet verstuurd. */}
        <input type="hidden" name="gclid" disabled />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Voornaam</span>
            <input required type="text" name="firstName" autocomplete="given-name"
                   class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Achternaam</span>
            <input required type="text" name="lastName" autocomplete="family-name"
                   class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Zakelijk e-mailadres</span>
            <input required type="email" name="email" autocomplete="email"
                   class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Telefoon (optioneel)</span>
            <input type="tel" name="phone" autocomplete="tel"
                   class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-sm font-semibold text-ink-900">Organisatie</span>
            <input required type="text" name="organization"
                   class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Rol</span>
            <select name="role" class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500">
              <option value="">Kies een rol</option>
              <option>Bestuurder / RvB</option>
              <option>Manager I&amp;A / CIO</option>
              <option>CMIO / CNIO / zorginhoudelijk leider</option>
              <option>Functioneel beheer</option>
              <option>FG / CISO / privacy</option>
              <option>Finance / control</option>
              <option>Anders</option>
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink-900">Segment</span>
            <select name="segment" class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500">
              <option value="">Kies een segment</option>
              <option>VVT</option>
              <option>Gehandicaptenzorg</option>
              <option>GGZ</option>
              <option>Huisartsenzorg</option>
              <option>Jeugdzorg</option>
              <option>Kraamzorg</option>
              <option>Anders</option>
            </select>
          </label>
        </div>

        <label class="mt-5 block">
          <span class="text-sm font-semibold text-ink-900">Drie typische werkstromen die u wilt zien</span>
          <textarea name="workflows" rows="4"
                    placeholder="Bijv. 'opstellen zorgplan na intake', 'eOverdracht naar ziekenhuis', 'maandelijkse iWmo-declaratie'"
                    class="mt-1.5 block w-full rounded-md border-ink-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-curanta-500 focus:ring-curanta-500"></textarea>
        </label>

        <label class="mt-5 flex items-start gap-3 text-sm text-ink-700">
          <input required type="checkbox" name="consent" value="yes"
                 class="mt-0.5 h-4 w-4 rounded border-ink-300 text-curanta-600 focus:ring-curanta-500" />
          <span>
            Ik ga akkoord met de verwerking van mijn gegevens conform de
            <a href="/privacy" class="text-curanta-700 hover:underline">privacyverklaring</a>.
            Geen marketinglijst, geen doorverkoop.
          </span>
        </label>

        {/* Alleen zichtbaar voor wie via een Google-advertentie binnenkwam (gclid in de URL).
            Aanvinken = toestemming voor "Ad User Data" in de conversie-upload; zonder vinkje
            verlaat de klik-ID dit formulier niet. Bewust los van het verplichte vakje erboven. */}
        <label id="advertentiemeting" class="hidden mt-3 flex items-start gap-3 text-sm text-ink-700">
          <input type="checkbox" name="adMeting" value="yes"
                 class="mt-0.5 h-4 w-4 rounded border-ink-300 text-curanta-600 focus:ring-curanta-500" />
          <span>
            Optioneel: u kwam binnen via een advertentie van ons. Mogen wij Google laten weten
            dát deze advertentie tot een aanvraag leidde? Wij geven daarbij alleen de klik-code
            van de advertentie en het tijdstip door — geen naam, e-mailadres of organisatie.
            <a href="/privacy#delen" class="text-curanta-700 hover:underline">Meer hierover</a>.
          </span>
        </label>

        <button type="submit" class="btn-primary mt-7">
          Demo aanvragen
        </button>
        <p class="mt-4 text-xs text-ink-500">
          Wij reageren binnen 1 werkdag. Vragen vooraf? Bel
          <a href="tel:+31852501301" class="text-curanta-700 hover:underline">085 250 1301</a>.
        </p>
      </form>

      <aside class="space-y-6">
        <div class="rounded-2xl border border-ink-100 bg-ink-100/50 p-6">
          <h2 class="font-display text-lg font-semibold text-ink-900">Wat te verwachten</h2>
          <ol class="mt-4 space-y-3 text-sm text-ink-700">
            <li class="flex gap-3">
              <span class="font-semibold text-curanta-700">1.</span>
              <span>Korte verkenning (30 min) — uw situatie, doelen, ICT-landschap.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-semibold text-curanta-700">2.</span>
              <span>Demo op úw werkstromen (60 min) — uw rollen, uw begrippen, uw flows.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-semibold text-curanta-700">3.</span>
              <span>Documenten op aanvraag: de stukken voor uw inkoop, zoals de DPA, stellen wij voor u op.</span>
            </li>
          </ol>
        </div>
        <div class="rounded-2xl border border-ink-100 bg-white p-6">
          <h2 class="font-display text-lg font-semibold text-ink-900">Liever eerst zelf rondkijken?</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/oplossing" class="text-curanta-700 hover:underline no-underline">→ Bekijk de modulekaart</a></li>
            <li><a href="/trust" class="text-curanta-700 hover:underline no-underline">→ Open Trust Centre</a></li>
            <li><a href="/integraties" class="text-curanta-700 hover:underline no-underline">→ Bekijk koppelingen</a></li>
            <li><a href="/prijzen" class="text-curanta-700 hover:underline no-underline">→ Plan-matrix</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script is:inline>
  // Campagnebron uit de URL in het formulier zetten (de links op de site dragen hem mee).
  (function () {
    var here = new URLSearchParams(window.location.search);
    var form = document.querySelector('form[action$="/api/lead"]');
    if (!form) return;
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) {
      var v = here.get(k);
      if (v) form.elements[k].value = v.slice(0, 200);
    });
    var gclid = here.get('gclid');
    if (!gclid) return;
    var veld = form.elements['gclid'];
    var blok = document.getElementById('advertentiemeting');
    var vinkje = form.elements['adMeting'];
    veld.value = gclid.slice(0, 200);
    blok.classList.remove('hidden');
    // Ook bij terugkeren via 'vorige': de browser herstelt het vinkje, niet de disabled-stand.
    veld.disabled = !vinkje.checked;
    vinkje.addEventListener('change', function () { veld.disabled = !vinkje.checked; });
  })();
</script>
