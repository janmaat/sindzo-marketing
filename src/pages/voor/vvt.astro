import SegmentLayout from '../../layouts/SegmentLayout.astro';
---
<SegmentLayout
  image="/og/voor-vvt.png"
  segmentKey="vvt"
  segmentLabel="VVT"
  title="VVT-software — verpleging, verzorging, thuiszorg | Curanta"
  description="VVT-software voor verpleeghuis en wijkverpleging: dossier, zorgplan, planning, declaratie en medewerkerportaal in één systeem. Cliëntportaal in 5 talen."
  eyebrow="Voor VVT-organisaties"
  hero="Eén systeem voor verpleeghuis en wijkverpleging, met minder administratie per dienst."
  subtitle="Curanta brengt dossier, planning, declaratie en kwaliteit samen. Uw zorgmedewerkers schakelen niet tussen systemen en voeren niets dubbel in, zodat er meer tijd overblijft voor de cliënt."
  triggers={[
    { title: 'Arbeidsmarktkrapte', body: 'Het tekort aan zorgpersoneel blijft groeien (ABF/AZW: van 89.800 in 2026 naar 261.800 in 2035). Curanta verlaagt de administratie per dienst, zodat zorgmedewerkers meer tijd aan cliënten besteden.' },
    { title: 'Verpleeghuis en wijk los van elkaar', body: 'Eén dossier voor verpleeghuis én wijk. Eén cliënt, één rapportage — ongeacht waar de zorg geleverd wordt.' },
    { title: 'Regeldruk via het ECD', body: 'Berenschot voor VWS (meting 2025): 34% van de werktijd gaat naar administratie, terwijl zorgprofessionals zelf 23% acceptabel vinden. Curanta dringt dat terug met een Coach-voorstel bij de SOEP-rapportage, spraakinvoer in de backoffice en een logische dossierstructuur.' },
    { title: 'eOverdracht & Wegiz', body: 'Overdracht naar ziekenhuis, huisarts of vervolgzorg via de BgZ in plaats van printen en faxen. De BgZ-bundel bouwt Curanta al; de aansluiting voor de eOverdracht is in ontwikkeling.' },
    { title: 'Cliënten die Nederlands niet als eerste taal hebben', body: 'Veel oudere cliënten en hun familie lezen formele teksten beter in hun eigen taal. Het cliëntportaal werkt in 5 talen (NL/EN/TR/AR/DE) — volgens onze eigen marktscan van mei 2026 biedt geen andere VVT-leverancier dat.' },
  ]}
  modules={[
    { name: 'Medewerkerportaal', note: 'Rooster, bezoeken met SOEP-rapportage, uren en verlof op de telefoon — €19 per zorgmedewerker' },
    { name: 'Cliëntdossier + zorgplan', note: 'Omaha-zorgplan, BSN versleuteld' },
    { name: 'SOEP-rapportage', note: 'Coach-voorstel; spraakinvoer in de backoffice' },
    { name: 'Zelfrooster', note: 'Medewerkers kiezen eigen diensten binnen CAO-kaders' },
    { name: 'Tijdregistratie', note: 'Uren bevestigen in het medewerkerportaal, ook zonder verbinding' },
    { name: 'Routeplanning', note: 'Wijkroutes met reistijd en voorkeursmedewerker per cliënt' },
    { name: 'Cao-controle', note: 'Rusttijden, pauzes en maximale diensten, met signalen vóór publicatie' },
    { name: 'eOverdracht', note: 'BgZ intern gebouwd, aansluiting in ontwikkeling' },
    { name: 'Medicatie via Medimo', note: 'Voorschrift → toedienregistratie' },
    { name: 'iWmo, productie en budget', note: 'Van toewijzing tot declaratie en budgetbewaking' },
    { name: 'Cliëntportaal', note: 'Voor cliënten en mantelzorgers: taken, foto\'s, berichten; in 5 talen' },
    { name: 'Collega-netwerk (welzijn)', note: 'Buddy of intervisiepartner — strikt gescheiden van HR' },
  ]}
  regulatory={['Wkkgz', 'Wtza', 'AVG', 'NEN 7510', 'Wegiz', 'Wzd (extramurale toepassing)']}
