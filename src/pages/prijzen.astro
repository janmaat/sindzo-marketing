---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanCard from '../components/PlanCard.astro';
import Cta from '../components/Cta.astro';
import Veelgesteld from '../components/Veelgesteld.astro';
import { HOOFDKNOP, DEMO_ZELF, DEMO_GESPREK, PRESENTATIE } from '../config/demo';

// Prijzen zijn indicatief en bewust zichtbaar — concurrenten verbergen
// pricing tot na demo, wat procurement-cyclus verlengt. Wij tonen ranges
// zodat bestuurders interne business case kunnen maken vóór gesprek.

// Zichtbaar op de pagina én als FAQPage (component Veelgesteld, 17-10-2026); de tekst is ongewijzigd.
const prijsVragen = [
  { vraag: "Wat telt als \"actieve medewerker\"?", antwoord: "Een gebruiker die in de afgelopen 30 dagen heeft ingelogd. Slapende accounts tellen niet mee: u betaalt niet voor mensen die niet werken." },
  { vraag: "Wat kost een zorgmedewerker die alleen het medewerkerportaal gebruikt?", antwoord: "€19 per maand, in elk plan. Dat geldt voor wie alleen het medewerkerportaal nodig heeft. Wie ook in de backoffice werkt, betaalt het bedrag van het plan (bijvoorbeeld een wijkverpleegkundige die indicaties stelt)." },
  { vraag: "Hoe zit het met cliënten en mantelzorgers?", antwoord: "Het cliëntportaal en het mantelzorgerportaal zijn gratis, in alle plannen. Cliënten, mantelzorgers en familie tellen niet als medewerker." },
  { vraag: "Hoe loggen gebruikers in?", antwoord: "Met tweestapsverificatie, inbegrepen in elk plan. Inloggen met DigiD voor cliënten en mantelzorgers is een betaalde optie." },
  { vraag: "Wat kost het bij meer dan 500 medewerkers?", antwoord: "Vanaf 500 medewerkers geldt een staffeltarief. Bij een Enterprise-contract stemmen wij dat met u af; bel ons voor een indicatie." },
  { vraag: "Zitten koppelingen in de prijs?", antwoord: "De koppelingen die gebouwd zijn (zie <a href=\"/integraties\" class=\"text-curanta-700 hover:underline\">de stand per koppeling</a>) zitten in het abonnement; daar rekenen wij niets extra voor. Wat de externe partij zelf rekent, bijvoorbeeld een Vecozo-certificaat of een ZorgMail-abonnement, betaalt u rechtstreeks aan die partij." },
  { vraag: "Is migratie van mijn huidige ECD inbegrepen?", antwoord: "Migratie vanuit <strong>Nedap Ons</strong>, <strong>Gerimedica Ysis</strong>, <strong>SDB</strong> of <strong>Pluriform Zorg (Adapcare)</strong> doen wij als migratieproject, tegen een vaste prijs vooraf. Er is geen open einde. Een kant-en-klare import per bronsysteem is er nog niet; de route stellen wij per organisatie samen op. De uitwerking per bronsysteem, met ook de weg terug naar buiten, staat op de pagina <a href=\"/overstappen\" class=\"text-curanta-700 hover:underline\">Overstappen en exit</a>." },
  { vraag: "Hoelang duurt een implementatie?", antwoord: "Dat spreken wij per organisatie af, na een migratie-inschatting. Wij zijn nieuw en noemen liever geen doorlooptijd die nog geen enkele klant heeft gehaald. De training is in alle plannen inbegrepen. De implementatie is maatwerk, met een prijs die wij vooraf afspreken. De migratie is een project tegen een vaste prijs vooraf, dus zonder open einde." },
  { vraag: "Kan ik tussentijds van plan wisselen?", antwoord: "Naar een hoger plan kan altijd direct; naar een lager plan per contractjaar. Het contract is een jaarcontract, en het aantal medewerkers schaalt per maand mee. Uw gegevens blijven van u: bij vertrek krijgt u een export in JSON, zonder exit-fee." },
];
---
<Base
  image="/og/prijzen.png"
  title="Prijzen per medewerker per maand | Curanta"
  description="Curanta kost €19 tot €39 per actieve medewerker per maand, met training en hosting inbegrepen. De implementatie is maatwerk. Het cliëntportaal is gratis."
>
  <PageHero
    eyebrow="Prijzen"
    title="Prijzen per medewerker per maand"
    subtitle="Vier abonnementsplannen, en een plan voor de praktijk; u zet alleen aan wat u nodig hebt. Geen aparte kosten voor training, hosting of basisondersteuning; de implementatie is maatwerk, met een prijs die wij vooraf afspreken. Zorgmedewerkers die alleen het medewerkerportaal gebruiken: €19 per maand, in elk plan."
  />

  <section class="container-prose py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <PlanCard
        name="Basic"
        tagline="Voor kleine teams en startende organisaties"
        priceFrom="€19"
        features={[
          'Cliëntdossier en SOEP-rapportage',
          'Tot 25 medewerkers',
          'Cliënt- en mantelzorgerportaal gratis',
          '1 declaratiemodule: Wmo, Jeugdwet, Wlz of Zvw',
          'Ondersteuning per e-mail binnen 1 werkdag',
          'NEN 7510-basismaatregelen',
        ]}
        cta={PRESENTATIE}
      />
      <PlanCard
        name="Compliance Pro"
        tagline="Voor organisaties die aan veel regels moeten voldoen"
        priceFrom="€29"
        highlight={true}
        features={[
          'Alles uit Basic',
          'Onbeperkt medewerkers',
          'Wtza, Wtta en inzet van zzp\'ers',
          'NEN 7510-maatregelen met auditexport',
          'Wzd-stappenplan en halfjaarlijkse IGJ-uitdraai',
          'Klachten (Wkkgz) en incidentmeldingen (VIM)',
          'De Cyberbeveiligingswet voor het bestuur: meldtermijnen, zorgplicht, vaststelling en leveranciersregister',
          'AI bij de rapportage, de overdracht en het zorgplan; standaard bij Mistral AI in de EU',
          'Meertalig cliëntportaal (5 talen)',
          'Collega-netwerk en lotgenoten (lotgenoten na uw DPIA)',
          'Telefonische ondersteuning 09:00-17:00',
        ]}
        cta={PRESENTATIE}
      />
      <PlanCard
        name="Totaalzorg Plus"
        tagline="Voor organisaties met een flexibele schil van personeel"
        priceFrom="€39"
        features={[
          'Alles uit Compliance Pro',
          'Volledige planning, routeplanning en cao-controle',
          'Zorgvraag naast rooster en formatie, per team en per week',
          'Inzet van zzp\'ers met AGB-controle',
          'Buddy voor internationaal geworven collega\'s',
          'CO₂-rapportage woon-werkverkeer (WPM, verplicht vanaf 100 werknemers)',
        ]}
        cta={PRESENTATIE}
      />
      <PlanCard
        name="Enterprise"
        tagline="Voor concerns, ketens en grote organisaties"
        features={[
          'Alles uit Totaalzorg Plus',
          'Concernrapportage over meerdere organisaties',
          'Een vaste success manager',
          'SLA en responstijden die wij met u afspreken',
          'On-premises-optie (NL)',
        ]}
        cta={{ label: 'Plan een verkenning', href: '/contact' }}
      />
    </div>

    {/* Het plan Praktijk (besluit Jan 02-10-2026; op de site sinds 14-10-2026, besluit Jan). Nagelopen in
        SubscriptionPlanCatalog ("praktijk", €29: basis + PraktijkModules). Bewust geen vijfde kaart in het
        rijtje: het plan is voor een andere lezer dan de vier hierboven. De Zvw-declaratie van een paramedicus
        zit er níét in; noem alleen de GGZ-declaratie, de nota en de Jeugdwet. SQ-48 en 4DKL wachten op de
        rechthebbenden. */}
    <div id="praktijk" class="mt-12 scroll-mt-24 grid gap-8 rounded-2xl bg-curanta-50 p-8 sm:p-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-sm font-semibold text-curanta-700">Voor de praktijk</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-ink-900">Praktijk</h2>
        <p class="mt-3 flex items-baseline gap-2">
          <span class="font-display text-3xl font-bold tabular-nums text-ink-900">€29</span>
          <span class="text-sm text-ink-500">per medewerker per maand</span>
        </p>
        <p class="mt-4 text-pretty leading-relaxed text-ink-700">
          Voor de vrijgevestigde GGZ-praktijk en de eerstelijns paramedische praktijk: het dossier, de
          behandelagenda en de declaratie in één plan.
        </p>
        <a href="/voor/ggz" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-curanta-700 no-underline hover:underline">Curanta voor de GGZ →</a>
      </div>
      <ul class="space-y-2.5 text-sm text-ink-700 lg:col-span-7 lg:pt-2">
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-curanta-500" aria-hidden="true"></span>Alles uit de basis van elk plan, met het cliëntdossier, de anamnese, metingen en het cliëntportaal</li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-curanta-500" aria-hidden="true"></span>De behandelagenda, met aanmelding en wachtlijst</li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-curanta-500" aria-hidden="true"></span>De GGZ-declaratie volgens het zorgprestatiemodel (GDS801), de nota aan de cliënt en declareren onder de Jeugdwet</li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-curanta-500" aria-hidden="true"></span>Omzetplafonds per verzekeraar, retourtriage en de controle op verzekering (COV)</li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-curanta-500" aria-hidden="true"></span>Klachten, incidentmeldingen, NEN 7510 en de AVG-onderdelen</li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-curanta-500" aria-hidden="true"></span>Niet inbegrepen: de AI-functies (een eigen betaalde laag) en de volledige planning</li>
      </ul>
    </div>

    {/* Wens Jan 25-09-2026: het tarief voor zorgmedewerkers die alleen het medewerkerportaal
        gebruiken is een sterk argument en stond alleen in de kleine lettertjes en de FAQ. De
        functies hieronder zijn routes die in Curanta.Medewerker bestaan. */}
    <div id="medewerkerportaal" class="mt-12 rounded-2xl border-2 border-curanta-500 bg-curanta-50/60 p-8 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-curanta-700">Medewerkerportaal</p>
          <h2 class="mt-2 font-display text-3xl font-bold text-ink-900 sm:text-4xl">€19 per zorgmedewerker per maand</h2>
          <p class="mt-4 text-ink-700 leading-relaxed">
            Voor wie alleen het medewerkerportaal gebruikt: de wijkverpleegkundige, verzorgende of
            begeleider die bij de cliënt werkt. Dat tarief geldt in elk plan, ook naast Compliance Pro of
            Totaalzorg Plus. Alleen wie ook in de backoffice werkt, betaalt het bedrag van het plan.
          </p>
          <p class="mt-4 text-sm text-ink-700 leading-relaxed">
            <strong>Rekenvoorbeeld:</strong> een organisatie op Compliance Pro heeft 40 zorgmedewerkers in het
            medewerkerportaal en 5 planners en teamleiders in de backoffice. Dat is 40 × €19 + 5 × €29 = <strong>€905 per maand</strong>.
            Het cliënt- en mantelzorgerportaal zijn gratis.
          </p>
        </div>
        <div>
          <p class="text-sm font-semibold text-ink-900">Wat de zorgmedewerker ermee doet, ook op de telefoon, in elk plan:</p>
          <ul class="mt-3 grid gap-2 text-sm text-ink-700 sm:grid-cols-2">
            {[
              'Haar eigen rooster en de diensten van vandaag',
              'Bezoeken met taken en SOEP-rapportage',
              'Zorgplan van de cliënt en overdracht',
              'Verlof aanvragen',
              'Kilometers declareren',
              'Ziek melden en incidenten melden',
            ].map((f) => (
              <li class="flex gap-2"><span class="text-curanta-700 font-bold" aria-hidden="true">✓</span><span>{f}</span></li>
            ))}
          </ul>
          <p class="mt-4 text-sm font-semibold text-ink-900">Met de volledige planning in Totaalzorg Plus ook:</p>
          <ul class="mt-3 grid gap-2 text-sm text-ink-700 sm:grid-cols-2">
            {[
              'Uren bevestigen, ook zonder verbinding',
              'Beschikbaarheid doorgeven',
              'Open diensten oppakken en diensten ruilen',
            ].map((f) => (
              <li class="flex gap-2"><span class="text-curanta-700 font-bold" aria-hidden="true">✓</span><span>{f}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-8 text-center text-sm text-ink-500">
      Alle prijzen excl. btw, per actieve medewerker per maand, bij een jaarcontract.
      Zorgmedewerkers die alleen het medewerkerportaal gebruiken: €19 per maand, in elk plan.
      Het cliënt- en mantelzorgerportaal zijn gratis.
      Vanaf 500 medewerkers geldt een staffeltarief.
      Dit zijn indicaties; de werkelijke prijs hangt af van segment, schaal en de modules die u kiest.
    </p>
  </section>

  {/* Toegevoegd 2026-08-17. Onderzocht: in elk ECD-selectieadvies staat dat
      organisaties de implementatie onderschatten en dat de eenmalige kosten vaak
      zwaarder wegen dan de licentie. Onze tarieven stonden er wel, maar zonder
      referentiekader — en juist het kader maakt ze pas een argument. Bewust een
      vergelijking met een marktbandbreedte en niet met een genoemde concurrent:
      dat laatste vraagt om gelijksoortige, verifieerbare cijfers per leverancier,
      en die publiceert niemand in deze markt. */}
  <section class="border-y border-ink-100 bg-curanta-50/60 py-16">
    <div class="container-prose">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Waar deze bedragen staan in de markt</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">
          Een licentieprijs zegt weinig zonder de rest van de rekening. In selectietrajecten
          gaat het mis op precies twee posten: de eenmalige implementatie, en de vraag wie de
          migratie betaalt. Daarom staan die hier naast het abonnement.
        </p>
      </div>

      <div class="mt-8 overflow-x-auto rounded-xl border border-ink-100 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-ink-100/50 text-left text-xs uppercase tracking-wider text-ink-500">
            <tr>
              <th class="px-4 py-3 font-semibold">Kostenpost</th>
              <th class="px-4 py-3 font-semibold">Gangbaar in de markt</th>
              <th class="px-4 py-3 font-semibold">Bij Curanta</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100 text-ink-700">
            <tr>
              <td class="px-4 py-3">Abonnement per gebruiker per maand</td>
              <td class="px-4 py-3">€50 tot €90</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">€19 tot €39 per actieve medewerker</td>
            </tr>
            <tr>
              <td class="px-4 py-3">Eenmalige implementatie en training</td>
              <td class="px-4 py-3">implementatie €4.000 tot €15.000, training €1.000 tot €5.000</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">training inbegrepen in elk plan; de implementatie is maatwerk, met een prijs die wij vooraf afspreken</td>
            </tr>
            <tr>
              <td class="px-4 py-3">Migratie vanuit uw huidige ECD</td>
              <td class="px-4 py-3">per geval</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">
                vaste prijs vooraf, per bronsysteem
              </td>
            </tr>
            <tr>
              <td class="px-4 py-3">Koppelingen (bijv. ZorgMail, Vecozo)</td>
              <td class="px-4 py-3">€50 tot €200 per maand</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">
                gebouwde koppelingen zitten in het abonnement; wat de externe partij rekent
                (bijv. Vecozo-certificaat, ZorgMail-abonnement) betaalt u zelf aan die partij
              </td>
            </tr>
            <tr>
              <td class="px-4 py-3">Export van uw gegevens bij opzegging</td>
              <td class="px-4 py-3">wisselend, soms tegen kosten</td>
              <td class="px-4 py-3 font-semibold text-curanta-900">geen exit-fee; volledige export van uw gegevens en bestanden in JSON</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-4 max-w-3xl text-xs text-ink-500">
        Marktbandbreedte uit de Heldy-kostengids voor Nederlandse zorgaanbieders (april 2026).
        Het is een bandbreedte, geen tarief van één bepaalde leverancier. Niet elke leverancier
        publiceert een prijs, en wie dat doet, rekent vaak in een andere eenheid (zie hieronder).
        Wat u werkelijk betaalt, hangt bij ons én bij anderen af van schaal, segment en modulekeuze.
      </p>

      <p class="mt-6 max-w-3xl text-sm text-ink-700 leading-relaxed">
        Dat wij onderaan die bandbreedte zitten, is een keuze en geen introductieactie. In onze
        kosten zit geen verkoopafdeling, geen implementatieafdeling en geen laag accountmanagers.
        Wat u verder vooraf kunt nakijken, staat op de pagina
        <a href="/cases" class="text-curanta-700 hover:underline">Zelf nakijken</a>.
      </p>
    </div>
  </section>

  {/* Herzien 2026-08-17. De vorige versie rekende elke leverancier om naar "per
      medewerker per maand" bij een aangenomen 8 cliënten per medewerker. Dat gaf
      Nedap €184 — vijf keer wat een organisatie van 50-500 medewerkers betaalt,
      omdat die €23 een zzp-resellertarief is terwijl Nedap zelf een schaalbaar
      pay-per-use-model publiceert zonder eenheidsprijs. En die caseload-ratio had
      geen bron: V&VN, Movisie en het NJi zeggen alle drie dat er geen vaste ratio
      bestaat. Een concurrent vijf keer te duur voorstellen op een pagina die
      eerlijkheid als onderscheid verkoopt, is het slechtst mogelijke ruilmiddel —
      onze kopers hebben Nedap-offertes op hun bureau liggen.

      Nu: elke leverancier in zijn eigen eenheid, met wat hij zélf publiceert, en
      de rekenoefening vervangen door de vraag die er werkelijk toe doet. Elke
      regel is op 2026-08-17 bij de bron nagetrokken. */}
  <section class="container-prose py-16 border-t border-ink-100">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Hoe dit zich verhoudt tot andere modellen</h2>
      <p class="mt-3 text-ink-700 leading-relaxed">
        Wij rekenen per actieve medewerker. De meeste partijen in de langdurige zorg rekenen
        per actief cliëntdossier. In de GGZ rekenen sommige partijen ook per behandelaar, of per
        gebruiker plus een deel van de omzet. Die modellen zijn niet rechtstreeks vergelijkbaar. Welk
        model voordelig uitpakt, hangt af van het aantal cliënten voor wie één medewerker gemiddeld zorgt.
        Dat verschilt sterk per organisatie.
      </p>
      <p class="mt-3 text-ink-700 leading-relaxed">
        Daarom zetten wij hier geen omgerekend bedrag neer. Hieronder staat per leverancier wat
        hij zelf publiceert, in zijn eigen eenheid.
      </p>
    </div>
    <div class="mt-8 overflow-x-auto rounded-xl border border-ink-100 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-ink-100/50 text-left text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="px-4 py-3 font-semibold">Leverancier</th>
            <th class="px-4 py-3 font-semibold">U betaalt per</th>
            <th class="px-4 py-3 font-semibold">Gepubliceerd tarief</th>
            <th class="px-4 py-3 font-semibold">Bron</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100 text-ink-700">
          <tr class="bg-greensoft/40">
            <td class="px-4 py-3 font-semibold text-curanta-900">Curanta Compliance Pro</td>
            <td class="px-4 py-3">actieve medewerker</td>
            <td class="px-4 py-3 font-semibold text-curanta-900">€29 per maand</td>
            <td class="px-4 py-3 text-xs text-ink-500">Deze pagina</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Nedap Ons</td>
            <td class="px-4 py-3">actief cliëntdossier</td>
            <td class="px-4 py-3">
              Geen eenheidsprijs openbaar. Nedap noemt het model schaalbaar en publiceert
              alleen een minimum van €25 per maand.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">nedap-ons.nl</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Ecare PUUR.</td>
            <td class="px-4 py-3">niet gepubliceerd</td>
            <td class="px-4 py-3">
              Geen tarief of prijsmodel openbaar. Ecare verwijst voor een prijs naar een demo of
              een gesprek.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">ecare.nl</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Octaaf Thuiszorgsoftware</td>
            <td class="px-4 py-3">licentie + cliënt</td>
            <td class="px-4 py-3">
              €27,83 per maand + €2,79 per cliënt. Onbeperkt aantal gebruikers inbegrepen.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">octaafthuiszorgsoftware.nl</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Karify (GGZ, eHealth)</td>
            <td class="px-4 py-3">professional</td>
            <td class="px-4 py-3">
              Vanaf €29,95 per maand. Boven 250 medewerkers op aanvraag; modules deels per
              gebruik.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">karify.com</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Curasoft (GGZ)</td>
            <td class="px-4 py-3">gebruiker, plus beheerder</td>
            <td class="px-4 py-3">
              €106 per gebruiker, of €26 per gebruiker + 1% van de maandomzet. Beheerderslicentie
              apart: €185 respectievelijk €104.
            </td>
            <td class="px-4 py-3 text-xs text-ink-500">curasoft.nl</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-4 max-w-3xl text-xs text-ink-500">
      Wij hebben elk tarief hierboven op 17 augustus 2026 nagetrokken bij de leverancier zelf, dat
      van Ecare op 25 september 2026. Wij rekenen de tarieven hier bewust niet om naar één noemer.
      Daarvoor is een aanname nodig over het aantal cliënten per medewerker. V&amp;VN, Movisie en
      het Nederlands Jeugdinstituut stellen alle drie dat daar geen vaste norm voor bestaat. Een
      vergelijking op een aanname die wij zelf kiezen, is geen vergelijking. Ziet u een fout in
      deze tabel? Laat het ons weten via
      <a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a>; wij reageren binnen 1 werkdag.
    </p>
    <div class="mt-8 rounded-2xl border border-ink-100 bg-curanta-50 p-6 max-w-3xl">
      <h3 class="font-display text-lg font-semibold text-ink-900">Wat het voor ú betekent</h3>
      <p class="mt-2 text-sm text-ink-700 leading-relaxed">
        Geef ons uw aantal medewerkers en uw aantal actieve cliënten, dan rekenen wij het door
        tegen uw huidige contract. Valt dat uit in het voordeel van uw huidige leverancier? Dan
        zeggen wij dat. Dat is voor ons goedkoper dan een klant die na een jaar spijt heeft.
      </p>
      <a href="/contact" class="mt-4 inline-block btn-primary no-underline">Laat het doorrekenen</a>
    </div>
  </section>

  <section class="container-prose py-16 border-t border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Wat wij niet apart in rekening brengen</h2>
    {/* Twee kolommen met een lijn erboven, geen kaarten: zeven punten in een raster van drie
        kaarten lieten een leeg vak achter (Taste Skill, 14-10-2026). Sinds 15-10-2026 zes: de implementatie is
        maatwerk (besluit Jan) en staat eronder, bij wat wel apart is. */}
    <ul class="mt-8 grid max-w-5xl gap-x-14 gap-y-8 md:grid-cols-2">
      {[
        ['Hosting', 'IONOS Cloud in Berlijn (EU). Geen extra kosten.'],
        ['Gebouwde koppelingen', 'Zitten in het abonnement. Wat de externe partij zelf rekent (bijvoorbeeld een Vecozo-certificaat of een ZorgMail-abonnement) betaalt u rechtstreeks aan die partij.'],
        ['Training', 'Training voor uw medewerkers bij de start.'],
        ['Nieuwe versies', 'U krijgt nieuwe versies zonder meerprijs.'],
        ['Basisondersteuning', 'Per e-mail, met een reactie binnen 1 werkdag.'],
        ['Documenten voor inkoop', 'Verwerkersovereenkomst en beveiligingsdossier stellen wij op aanvraag op, zonder geheimhoudingsverklaring (NDA).'],
      ].map(([title, body]) => (
        <li class="border-t-2 border-curanta-200 pt-4">
          <h3 class="font-display font-semibold text-ink-900">{title}</h3>
          <p class="mt-1 text-pretty text-sm leading-relaxed text-ink-700">{body}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-3xl text-sm leading-relaxed text-ink-700">
      Wel apart: de implementatie, want die is maatwerk; de prijs spreken wij vooraf met u af. En de migratie van uw
      gegevens, als project tegen een vaste prijs na een migratie-inschatting.
    </p>
  </section>

  <Veelgesteld titel="Veelgestelde vragen over prijs" vragen={prijsVragen} />

  <Cta
    title="Niet zeker welk plan past?"
    subtitle="Vertel ons over uw situatie (sector, omvang, huidige systemen). Wij reageren binnen 1 werkdag, ook als ons advies is dat een andere leverancier beter past."
    primary={{ label: 'Vraag een advies', href: '/contact' }}
    secondary={HOOFDKNOP}
  />
</Base>
