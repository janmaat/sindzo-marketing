---
const links = [
  { label: 'Oplossing', href: '/oplossing' },
  { label: 'Voor wie', href: '/voor' },
  { label: 'Integraties', href: '/integraties' },
  { label: 'Overstappen', href: '/overstappen' },
  { label: 'Trust Centre', href: '/trust' },
  { label: 'Prijzen', href: '/prijzen' },
];
---
<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/85 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="container-prose flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 no-underline" aria-label="Curanta — terug naar home">
      <img src="/logo/curanta-logo.svg" alt="Curanta" class="h-10 w-auto" width="135" height="40" />
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm text-ink-700">
      {links.map((l) => (
        <a href={l.href} class="no-underline hover:text-curanta-700 transition">{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/login" class="hidden sm:inline text-sm text-ink-700 hover:text-curanta-700 no-underline">Inloggen</a>
      {/* Bewust naar de open demo-omgeving en niet naar het aanvraagformulier:
          zelf kunnen inloggen is wat ons van de concurrentie onderscheidt. */}
      <a href="/demo-omgeving" class="btn-primary no-underline">Bekijk de demo</a>
    </div>
  </div>
</header>
