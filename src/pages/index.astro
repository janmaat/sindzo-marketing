      'Maakt productieregels uit afgeronde bezoeken en registraties, met de bron erbij.',
      'Stelt uit goedgekeurde productie de declaraties op voor de Wmo, de Jeugdwet en de Wlz, en de aanlevering voor het CAK.',
      'Volgt een incidentmelding of klacht van melding tot afhandeling, met de termijnen uit de Wkkgz.',
    ],
    statussen: [
      { status: 'demo', tekst: 'Productieregistratie, declaraties opstellen, incidentmeldingen en klachten' },
      { status: 'inrichten', tekst: 'Versturen via Vecozo: na aansluiting met het Vecozo-certificaat van uw organisatie. In de demo zijn de koppelingen niet live.' },
      { status: 'ontwikkeling', tekst: 'Declareren bij zorgverzekeraars (Zvw). Retourberichten automatisch ophalen; nu leest u ze zelf in.' },
    ],
    link: { label: 'Alle onderdelen van declaratie en kwaliteit', href: '/oplossing#declaratie' },
    beelden: [
      {
        src: productie,
        alt: 'Backoffice: de productieregistratie, met tellers voor in te dienen, goedgekeurde en afgekeurde regels, en per regel medewerker, cliënt, datum, kader, product, minuten, status en bron.',
        adres: 'app.curanta.nl',
        bijschrift: 'Backoffice: productieregistratie, met per regel de bron, zoals de groepszorg, en de status. Opname oktober 2026.',
      },
      {
        src: vim,
        alt: 'Backoffice: het overzicht van incidentmeldingen met het aantal gemelde incidenten, calamiteiten en datalekken, en een lijst meldingen om te beoordelen.',
