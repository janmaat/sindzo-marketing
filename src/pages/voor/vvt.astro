---
import SegmentLayout from '../../layouts/SegmentLayout.astro';
import { DOORBRAAKMIDDELEN, MEERTALIG_PORTAAL, PEER_SUPPORT } from '../../config/kennisbank';
import beeld from '../../assets/schermen/mw-bezoek.jpg';
---
<SegmentLayout
  beeld={{ src: beeld, adres: 'medewerker.curanta.nl', alt: 'Medewerkerportaal: een bezoek aan een verzonnen cliënt, met adres, de knop Meld aankomst, een takenlijst uit het zorgplan en het medicatieoverzicht.', bijschrift: 'Medewerkerportaal: het bezoek, met de taken uit het zorgplan. Opname oktober 2026.' }}
  image="/og/voor-vvt.png"
  segmentKey="vvt"
  segmentLabel="VVT"
  title="VVT-software voor verpleging, verzorging en thuiszorg | Curanta"
  description="VVT-software voor verpleeghuis en wijkverpleging: dossier, zorgplan, planning, declaratie en medewerkerportaal in één systeem. Cliëntportaal in 5 talen."
  eyebrow="Voor VVT-organisaties"
  hero="Eén systeem voor de wijkverpleging en het verpleeghuis"
  subtitle="De zorgmedewerker ziet op de telefoon de bezoeken, de taken en het zorgplan, en schrijft daar ook de rapportage. De planner en de administratie werken met diezelfde gegevens: dossier, planning, medewerkerportaal en declaratie zitten in één systeem. De Zvw-declaratie maakt Curanta klaar; u levert hem zelf aan in het VECOZO-portaal."
  triggers={[
    { title: 'Te weinig collega\'s', body: 'Het tekort aan personeel in zorg en welzijn groeit van 89.800 in 2026 naar 261.800 in 2035 (ABF/AZW). Curanta zet het werk van de dag op de telefoon van de zorgmedewerker: de bezoeken, de taken, de rapportage en de uren.' },
    { title: 'Wijk en verpleeghuis apart', body: 'Verhuist een cliënt van de wijk naar het verpleeghuis, dan blijft het dossier hetzelfde. Eén cliënt, één rapportage, waar u de zorg ook levert. In het verpleeghuis legt u afdeling, kamer en bed vast, en het team van de afdeling kan vanzelf bij de dossiers van zijn bewoners.' },
    { title: 'Tijd kwijt aan het dossier', body: 'Zorgprofessionals besteden 34% van hun werktijd aan administratie, terwijl zij zelf 23% acceptabel vinden (Berenschot voor VWS, meting 2025). Bij elk bezoek staan de taken uit het zorgplan klaar, en metingen staan al in de rapportage. Wilt u dat, dan doet Curanta een voorstel voor de evaluatie, en de zorgverlener leest het na.' },
    { title: 'Geld voor minder administratie', body: 'Van 1 tot en met 31 januari 2027 kunt u voor uw Zvw-zorg de doorbraakmiddelen aanvragen, voor spraakgestuurd rapporteren en voor capaciteitsplanning. Beide vragen een nulmeting. Curanta laat per team zien hoe lang rapporteren duurt, en welk deel van de geroosterde uren naar cliënten gaat: de maat die het modelplan voor capaciteitsplanning in de vvt gebruikt is het aandeel cliëntgebonden tijd. Wat de aanvraag verder van uw software vraagt, staat in de kennisbank.' },
    { title: 'eOverdracht en de Wegiz', body: 'Het doel: een overdracht naar het ziekenhuis, de huisarts of de vervolgzorg via de BgZ, zonder printer of fax. Curanta maakt het overdrachtsdocument volgens eOverdracht 4.0, met alle 14 onderdelen van de Minimale eOverdracht voor zover ze in het dossier staan. U downloadt het en stuurt het zelf mee, bijvoorbeeld via ZorgMail. Automatisch verzenden bouwen wij nog. (De Wegiz is de Wet elektronische gegevensuitwisseling in de zorg.)' },
    { title: 'Cliënten die Nederlands niet als eerste taal hebben', body: 'Veel oudere cliënten en hun familie lezen formele teksten beter in hun eigen taal. De menu’s en vaste teksten van het cliëntportaal zijn er in vijf talen: Nederlands, Engels, Turks, Arabisch en Duits. Hoe andere leveranciers dat doen, staat met bronnen op de vergelijkingspagina.' },
  ]}
  modules={[
    { name: 'Medewerkerportaal', note: 'Rooster, bezoeken met SOEP-rapportage, uren en verlof op de telefoon: €19 per zorgmedewerker' },
    { name: 'Cliëntdossier + zorgplan', note: 'Zorgplan rond de problemen van het Omaha System (geen keurmerk); BSN versleuteld' },
    { name: 'SOEP-rapportage', note: 'Subjectief, objectief, evaluatie en plan. Met coach-voorstel; spraakinvoer in de backoffice' },
    { name: 'Rapportageduur per team', note: 'Hoe lang rapporteren duurt, met en zonder het voorstel van de coach; per team, nooit per medewerker' },
    { name: 'Van zorgvraag naar rooster', note: 'De zorgvraag per team naast de geroosterde uren en de formatie (Totaalzorg Plus)' },
    { name: 'Zelfrooster', note: 'Medewerkers kiezen hun eigen diensten binnen de grenzen van de cao' },
    { name: 'Tijdregistratie', note: 'Uren bevestigen in het medewerkerportaal, ook zonder verbinding' },
    { name: 'Routeplanning', note: 'Wijkroutes met reistijd en voorkeursmedewerker per cliënt; per bezoek de speling rond de afgesproken tijd' },
    { name: 'Bezettingsnorm', note: 'Een minimale bezetting per team en dagdeel, met een signaal als het rooster eronder zakt' },
    { name: 'Waarschuwingen', note: 'MRSA, valrisico of agressie bovenaan het dossier, en zonder bereik op de telefoon' },
    { name: 'Cao-controle', note: 'Rusttijden, pauzes en maximale diensten, met signalen voordat u het rooster publiceert' },
    { name: 'eOverdracht', note: 'Document om te downloaden en zelf mee te sturen; verzenden in ontwikkeling' },
    { name: 'Medicatie', note: 'Toedienlijst; overzicht uit Medimo of uit de eigen registratie' },
    { name: 'iWmo, productie en budget', note: 'Van toewijzing tot declaratie en budgetbewaking' },
    { name: 'Cliëntportaal', note: 'Voor cliënten en mantelzorgers: taken, foto\'s, berichten; in 5 talen' },
    { name: 'Collega-netwerk (welzijn)', note: 'Buddy of intervisiepartner, strikt gescheiden van HR' },
  ]}
  vragen={[
    { vraag: 'Kunnen wij de Zvw-declaratie via VECOZO doen?', antwoord: 'Curanta maakt de Zvw-declaratie klaar; u levert hem zelf aan in het VECOZO-portaal. Rechtstreeks versturen via VECOZO bouwen wij nog.' },
    { vraag: 'Helpt Curanta bij een aanvraag voor de doorbraakmiddelen?', antwoord: 'Van 1 tot en met 31 januari 2027 kunt u voor uw Zvw-zorg de doorbraakmiddelen aanvragen. Curanta laat per team zien hoe lang rapporteren duurt, en welk deel van de geroosterde uren naar cliënten gaat. Inspreken onderweg in het medewerkerportaal is er nog niet. Wat de aanvraag van uw software vraagt, staat in <a href="/kennisbank/doorbraakmiddelen-modelplan-software" class="text-curanta-700 hover:underline">de kennisbank</a>.' },
  ]}
  nogNiet={[
    'Declaraties rechtstreeks versturen via VECOZO. Nu levert u het bestand zelf aan in het VECOZO-portaal.',
    'eOverdracht automatisch verzenden naar ziekenhuis of vervolgzorg, en een kwalificatie door Nictiz.',
    'Inspreken onderweg in het medewerkerportaal; in de backoffice kan het wel, op het apparaat zelf.',
  ]}
  artikelen={[DOORBRAAKMIDDELEN, MEERTALIG_PORTAAL, PEER_SUPPORT]}
  regulatory={['Wkkgz', 'Wtza', 'AVG', 'NEN 7510', 'Wegiz', 'Wzd (extramurale toepassing)']}
  proofPoints={[
    { value: 'EU', label: 'Hosting (IONOS, Berlijn) · ondersteuning in het Nederlands' },
    { value: '1×', label: 'Inloggen: alle modules in één werkruimte' },
    { value: 'FHIR', label: 'API voor de Basisgegevensset Zorg (BgZ), alleen lezen, na registratie' },
    { value: 'NEN 7513', label: 'Logboek met hash-keten, bewaard zolang het dossier bestaat' },
  ]}
/>
