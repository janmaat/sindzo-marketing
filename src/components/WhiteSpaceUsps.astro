---
// Functies waarvan onze eigen marktscan (peildatum 2026-05-29) laat zien dat geen
// directe Nederlandse concurrent ze biedt. Bewust met de scan erbij: zorgbestuurders
// die hier sceptisch zijn, kunnen het natrekken.
//
// Het zorgplan (SMART-doelen, risicoprofielen) stond hier eerst als derde kaart, maar
// /vergelijking laat zelf zien dat Nedap SMART-doelen ook heeft; het hoort dus niet onder
// "wat de markt mist". Het buitenlandse retentiecijfer bij peer-support is weggehaald:
// niet teruggevonden (feitenblad 25-09-2026).
//
// Status-conventie matchet de rest van de site:
//   live    — gebouwd (in de code aanwezig)
//   wip     — in ontwikkeling
//   roadmap — gepland, nog niet gestart

const usps = [
  {
    eyebrow: 'Meertalig cliëntportaal',
    title: '5 talen in het cliëntportaal — voor de hele familie',
    body: 'Nederlands, Engels, Turks, Arabisch en Duits. Pools en Oekraïens zijn vertaald maar staan nog uit. Voor ouderen die Nederlands niet als eerste taal hebben, en voor hun familie en mantelzorgers, ook buiten Nederland.',
    evidence: 'Eigen marktscan, peildatum 29-05-2026: Nedap Ons + Caren, PinkRoccade myNeva, Cura, Carit, Plancare 2, Salar BeFlex, Quli en Famped/Famedio zijn allemaal alleen Nederlandstalig. ChipSoft levert NL en EN, maar alleen in HiX (ziekenhuizen).',
    status: 'live',
    statusNote: '',
  },
  {
    eyebrow: 'Collega-netwerk',
    title: 'Een buddy of intervisiepartner voor zorgmedewerkers',
    body: 'Medewerkers melden zich zelf aan voor een buddy bij de start, een buddy voor internationaal geworven collega\'s of een intervisiepartner. Strikt gescheiden van HR: leidinggevenden kijken niet mee. Het lotgenotendeel staat uit tot uw organisatie de DPIA heeft afgerond.',
    evidence: 'Eigen marktscan, peildatum 29-05-2026: geen Nederlandse concurrent biedt dit. Nedap Ons heeft het niet; Speakap is een algemeen intranet.',
    status: 'live',
    statusNote: 'lotgenoten aan na uw DPIA',
  },
];

const statusColor = (s: string) =>
  s === 'live' ? 'bg-green-500' : s === 'wip' ? 'bg-amber-500' : 'bg-ink-300';
const statusLabel = (s: string) =>
  s === 'live' ? 'Gebouwd' : s === 'wip' ? 'In ontwikkeling' : 'Gepland';
---
<section class="container-prose py-20 border-t border-ink-100">
  <div class="max-w-3xl">
    <span class="eyebrow">Wat wij bij anderen niet vonden</span>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tightish text-ink-900 sm:text-4xl">
      Twee functies die de Nederlandse <em class="italic font-semibold text-accent-600">VVT en gehandicaptenzorg</em> nu missen.
    </h2>
    <p class="mt-3 text-ink-700">
      Wij noemen welke leveranciers wij op welke datum hebben bekeken. Heeft een leverancier dit
      inmiddels toch? Laat het ons weten via
      <a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a>.
    </p>
  </div>

  <ul class="mt-12 grid gap-6 md:grid-cols-2">
    {usps.map((u) => (
      <li class="flex flex-col rounded-xl border border-ink-200 bg-white p-6">
        <div class="flex items-center gap-2">
          <span class={`inline-block h-2 w-2 rounded-full ${statusColor(u.status)}`}></span>
          <span class="text-xs font-semibold text-ink-500">{statusLabel(u.status)}{u.statusNote ? ` · ${u.statusNote}` : ''}</span>
        </div>
        <div class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-accent-700">{u.eyebrow}</div>
        <h3 class="mt-2 font-display text-lg font-semibold text-ink-900 leading-snug">{u.title}</h3>
        <p class="mt-3 text-sm text-ink-700 leading-relaxed flex-1">{u.body}</p>
        <div class="mt-5 rounded-lg border border-ink-100 bg-ink-100/40 p-3">
          <div class="text-xs font-bold text-ink-500 mb-1">Marktscan</div>
          <p class="text-xs text-ink-700 leading-snug">{u.evidence}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
