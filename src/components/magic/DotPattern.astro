---
// Stippenraster als achtergrond, naar DotPattern van Magic UI (magicui.design, MIT-licentie),
// omgezet naar een statische SVG: geen React, geen script. De kleur komt uit `currentColor`, dus
// een tekstklasse op de component kleurt de stippen; `masker` laat het raster naar de randen
// uitvloeien, zodat het nooit als harde rand achter de tekst staat.
interface Props {
  /** Afstand tussen de stippen in px. */
  afstand?: number;
  /** Straal van een stip in px. */
  straal?: number;
  /** Waar het raster het sterkst is; daarbuiten loopt het uit naar transparant. */
  masker?: 'rechtsboven' | 'midden' | 'linksboven' | 'geen';
  class?: string;
}
const { afstand = 18, straal = 1.1, masker = 'rechtsboven', class: klasse = '' } = Astro.props;

// Uniek per exemplaar: twee rasters op één pagina mogen elkaars <pattern> niet lenen.
const id = `stippen-${Math.random().toString(36).slice(2, 9)}`;
const maskers = {
  rechtsboven: 'radial-gradient(ellipse 70% 80% at 85% 10%, #000 20%, transparent 75%)',
  linksboven: 'radial-gradient(ellipse 70% 80% at 10% 10%, #000 20%, transparent 75%)',
  midden: 'radial-gradient(ellipse 60% 70% at 50% 50%, #000 25%, transparent 80%)',
  geen: 'none',
};
---
<svg
  aria-hidden="true"
  class={`pointer-events-none absolute inset-0 h-full w-full ${klasse}`}
  style={`-webkit-mask-image:${maskers[masker]};mask-image:${maskers[masker]}`}
>
  <defs>
    <pattern id={id} width={afstand} height={afstand} patternUnits="userSpaceOnUse">
      <circle cx={afstand / 2} cy={afstand / 2} r={straal} fill="currentColor" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
