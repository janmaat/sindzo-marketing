---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';

// Eigen indexpagina voor "Voor wie" — voorkomt dat de nav-link op subpagina's
// terugspringt naar #voor-wie op de homepage (gebroken navigatiepatroon).

// Volgorde: de drie hoofdsectoren (VVT, GHZ, GGZ) eerst, zoals op de homepage; kraam- en jeugdzorg
// daarna. In het raster staan ze als 3 + 2, zodat er geen leeg vak overblijft (Taste Skill, 14-10-2026).
const segments = [
  {
    label: 'VVT',
    title: 'Verpleging, verzorging en thuiszorg',
    pitch: 'Dossier, planning en medewerkerportaal voor wijk en verpleeghuis. U declareert onder de Wmo, de Wlz en de Zvw.',
    href: '/voor/vvt',
    accent: 'from-curanta-100 to-cream', // eindigt in wit zoals de andere kaarten; to-curanta-50 gaf een harde rand
  },
  {
    label: 'GHZ',
    title: 'Gehandicaptenzorg',
    pitch: 'Het ondersteuningsplan met signaleringsplan, verblijf en logeren onder de Wet langdurige zorg (Wlz), en de Wet zorg en dwang (Wzd).',
    href: '/voor/ghz',
    accent: 'from-greensoft to-cream',
  },
  {
    label: 'GGZ',
    title: 'Geestelijke gezondheidszorg',
    pitch: 'Het EPD met trajecten volgens het zorgprestatiemodel, de declaratie bij zorgverzekeraars volgens de standaard van Vektis en afscherming per cliënt.',
    href: '/voor/ggz',
    accent: 'from-curanta-50 to-cream',
  },
  {
    label: 'Kraamzorg',
    title: 'Kraamzorg',
    pitch: 'Het kraamdossier met de controles van moeder en kind, de kraambezoeken in de planning en de eigen bijdrage per verzekeraar.',
    href: '/voor/kraamzorg',
    accent: 'from-curanta-50 to-cream',
  },
  {
    label: 'Jeugdzorg',
    title: 'Jeugdzorg',
    pitch: 'Het jeugddossier met hulpvragen, het hulpverleningsplan, toewijzingen en de meldcode.',
    href: '/voor/jeugdzorg',
    accent: 'from-greensoft to-cream',
  },
];
---
<Base
  image="/og/voor.png"
  title="Voor wie is Curanta? VVT, GHZ, GGZ, kraam- en jeugdzorg"
  description="Zorgsoftware voor VVT, gehandicaptenzorg en GGZ: één systeem voor dossier, planning, declaratie en kwaliteit. U zet alleen aan wat u nodig hebt."
>
  <PageHero
    eyebrow="Voor wie"
    title="Voor wie is Curanta gebouwd?"
    subtitle="Voor zorgorganisaties in de VVT, de gehandicaptenzorg, de GGZ, de kraamzorg en de jeugdzorg: één systeem voor dossier, planning, declaratie en kwaliteit. U zet alleen aan wat u nodig hebt, en later bijzetten kan zonder overstap."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="/oplossing" class="btn-primary no-underline">Bekijk de modulekaart</a>
      <a href="/prijzen" class="btn-secondary no-underline">Prijzen</a>
    </div>
  </PageHero>

  <section class="container-prose py-16">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {segments.map((s, i) => (
        <a href={s.href} class={`${i === 0 ? 'sm:col-span-2 lg:col-span-2' : i < 3 ? 'lg:col-span-2' : 'lg:col-span-3'} spotlight group relative overflow-hidden rounded-xl border border-ink-300 bg-white p-6 no-underline transition hover:border-curanta-300 hover:shadow-md`}>
          <div class={`absolute inset-x-0 top-0 h-24 -z-0 bg-gradient-to-b ${s.accent}`}></div>
          <div class="relative">
            <span class="text-xs font-semibold uppercase tracking-wider text-curanta-700">{s.label}</span>
            <h2 class="mt-3 font-display text-lg font-semibold text-ink-900">{s.title}</h2>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{s.pitch}</p>
            <span class="mt-5 inline-block text-sm font-medium text-curanta-700 transition group-hover:translate-x-0.5">
              Meer over deze sector →
            </span>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-8 text-sm text-ink-500 max-w-3xl">
      <strong class="text-ink-700">Eerstelijnszorg (huisartsen)</strong>: Curanta heeft geen
      huisartsinformatiesysteem (HIS) en bouwt er nu geen. Voor de samenwerking met de huisarts heeft Curanta
      koppelingen met ZorgMail en ZorgDomein gebouwd. Met toestemming van de cliënt leest de huisarts mee in een
      deel van het dossier, via een eigen ingang met een tweede factor.
    </p>
    <p class="mt-3 text-sm text-ink-500 max-w-3xl">
      <strong class="text-ink-700">Fysiotherapie, ergotherapie, logopedie en diëtetiek</strong>: deze zijn er als
      behandeldienst naast de VVT, de gehandicaptenzorg of een GGZ-instelling. Daarbij horen een eigen dossier, de
      behandelagenda en het overzicht van de behandeluren. De zelfstandige paramedische praktijk, oefentherapie en podotherapie biedt
      Curanta niet aan.
    </p>
  </section>

  <Cta />
</Base>
