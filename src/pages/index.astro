const doelgroepen = [
  {
    naam: 'VVT',
    kop: 'Wijkverpleging, thuiszorg en verpleeghuizen',
    tekst: 'Routes en bezoeken, rapportage onderweg, medicatie uit Medimo of de eigen registratie, en declareren onder de Wmo en de Wlz.',
    let: 'Declareren bij zorgverzekeraars (Zvw) is in ontwikkeling.',
    href: '/voor/vvt',
    link: 'Curanta voor de VVT',
    foto: fotoVvt,
    alt: 'Een verzorgende in gesprek met een oudere bewoner.',
  },
  {
    naam: 'Gehandicaptenzorg',
    kop: 'Wonen, dagbesteding en begeleiding',
    tekst: 'Het ondersteuningsplan met signaleringsplan, dagbesteding, verblijf en logeren onder de Wlz, de Wzd, en verwanten die het plan in het cliëntportaal lezen en akkoord geven.',
