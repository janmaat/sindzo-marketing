---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';

// Onderzocht: de reden dat zorgorganisaties niet van ECD wisselen is niet
// tevredenheid maar dataportabiliteit — ze kunnen hun cliëntgegevens niet
// meenemen en zouden alles opnieuw moeten invoeren. Berenschot noemt het
// voorkomen van lock-in zelf als remedie tegen administratieve druk. Deze
// pagina is het antwoord daarop; het stond eerder als één regel in de FAQ op
// /prijzen. Zie docs/marktonderzoek-conversie-curanta-2026-08-17.md.

const bronsystemen = [
  {
    naam: 'Nedap Ons',
    status: 'maatwerk, vaste prijs',
    toelichting:
      'Cliënten, zorgplannen, rapportages en medewerkers brengen we over als migratieproject tegen een vaste prijs die vooraf vaststaat. Een kant-en-klare Nedap-import is er nog niet; de route stellen we per organisatie samen op.',
  },
  {
    naam: 'Gerimedica Ysis',
    status: 'in voorbereiding',
    toelichting:
      'Import is in ontwikkeling. Overweegt u een overstap vanuit Ysis, dan bepalen we samen de planning — wij zeggen liever "nog niet" dan dat we u een datum beloven die we niet halen.',
  },
  {
    naam: 'SDB',
    status: 'maatwerk, vaste prijs',
    toelichting:
      'Maatwerk-import tegen een vaste prijs die vooraf vaststaat. Geen open einde, geen nacalculatie.',
  },
  {
    naam: 'Adapcare Pluriform Zorg',
    status: 'maatwerk, vaste prijs',
    toelichting:
      'Maatwerk-import tegen een vaste prijs die vooraf vaststaat. Geen open einde, geen nacalculatie.',
  },
];

const statusKleur = {
  inbegrepen: 'bg-accent-500',
  'in voorbereiding': 'bg-curanta-300',
  'maatwerk, vaste prijs': 'bg-curanta-500',
};
---
<Base
  title="Overstappen van uw huidige ECD — Curanta"
  description="Overstappen vanuit Nedap Ons, Ysis, SDB en Adapcare tegen een vaste prijs vooraf, en een exit-pad dat op papier staat. Wat u erin stopt, kunt u er ook weer uit halen."
>
  <PageHero
    eyebrow="Overstappen"
    title="Vastzitten is geen argument om te blijven."
    subtitle="De meest genoemde reden om niet van ECD te wisselen is niet dat het huidige systeem goed is. Het is dat de data er niet uit komt, en dat niemand het vooruitzicht aankan om alles opnieuw in te voeren. Daar hebben wij een antwoord op — vóór u klant wordt, en ook voor als u ooit weer weg wilt."
  >
    <div slot="actions" class="flex flex-wrap items-center gap-3">
      <a href="/contact" class="btn-primary no-underline">Vraag een migratie-inschatting</a>
      <a href="#eruit" class="btn-secondary no-underline">Eerst: hoe komt u er weer uit?</a>
    </div>
  </PageHero>

  <section class="container-prose py-16">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Waar u vandaan komt</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Wij bouwen imports per bronsysteem in plaats van een generieke "stuur ons een Excel"-route.
        Dat is meer werk voor ons en minder voor u. Hieronder staat eerlijk waar we zijn.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {bronsystemen.map((b) => (
        <article class="rounded-2xl border border-ink-100 bg-white p-6">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-display text-lg font-semibold text-ink-900">{b.naam}</h3>
            <span class="badge whitespace-nowrap">
              <span class={`status-dot ${statusKleur[b.status]}`}></span>
              {b.status}
            </span>
          </div>
          <p class="mt-3 text-sm text-ink-700 leading-relaxed">{b.toelichting}</p>
        </article>
      ))}
    </div>

    <p class="mt-6 text-sm text-ink-500 max-w-3xl">
      Staat uw systeem er niet bij? Vraag het gewoon. Wij zeggen ook eerlijk wanneer een import
      niet loont en handmatig overzetten goedkoper is — dat komt voor bij kleine
      cliëntenbestanden.
    </p>
  </section>

  <section class="border-y border-ink-100 bg-curanta-50/60 py-16">
    <div class="container-prose">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Wat het kost en hoe lang het duurt</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">
          De valkuil die in elk ECD-selectieadvies terugkomt is dat organisaties de
          implementatie onderschatten: ze kijken naar de software en vergeten voorbereiding,
          training en begeleiding. Daarom staan die hier bij de prijs, niet ernaast.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-ink-100 bg-white p-6">
          <h3 class="font-display text-lg font-semibold text-ink-900">Inbegrepen in elk plan</h3>
          <p class="mt-3 text-sm text-ink-700 leading-relaxed">
            Onboardingtraject, migratie en training zitten in het abonnement. Geen aparte
            implementatiefactuur.
          </p>
        </div>
        <div class="rounded-2xl border border-ink-100 bg-white p-6">
          <h3 class="font-display text-lg font-semibold text-ink-900">Doorlooptijd</h3>
          <p class="mt-3 text-sm text-ink-700 leading-relaxed">
            Die spreken we per organisatie af, na een migratie-inschatting. Wij zijn nieuw en
            noemen liever geen doorlooptijd die nog door geen enkele klant is gehaald.
          </p>
        </div>
        <div class="rounded-2xl border border-ink-100 bg-white p-6">
          <h3 class="font-display text-lg font-semibold text-ink-900">Grotere trajecten</h3>
          <p class="mt-3 text-sm text-ink-700 leading-relaxed">
            Complexer of groter wordt een vast geprijsd project. U weet het bedrag vooraf, ook
            als het ons meer tijd kost dan gedacht.
          </p>
        </div>
      </div>

      <p class="mt-6 text-sm text-ink-500">
        Tarieven per plan staan op <a href="/prijzen" class="text-curanta-700 hover:underline">/prijzen</a>.
      </p>
    </div>
  </section>

  <section id="eruit" class="container-prose py-16">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">En hoe u er weer uit komt</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Dit hoort op dezelfde pagina als de import, en niet in de kleine letters. Een leverancier
        die u alleen vertelt hoe u binnenkomt, heeft er belang bij dat u niet weg kunt. Wij
        vinden lock-in een ontwerpfout, geen verdienmodel — en dat is niet alleen een mening:
        onafhankelijk onderzoek naar administratieve druk in de zorg noemt dataportabiliteit
        expliciet als een van de remedies.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-ink-100 bg-white p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">Uw data blijft van u</h3>
        <ul class="mt-4 space-y-3 text-sm text-ink-700">
          <li>Exit-export in JSON en CSV, op verzoek en zonder exit-fee.</li>
          <li>Bij beëindiging bewaren wij uw export nog zes maanden, voor het geval een tweede uitdraai nodig blijkt. Daarna wissen wij definitief.</li>
          <li>Voor Enterprise-contracten spreken we desgewenst een langere exit-periode af.</li>
          <li>Downgraden tussen plannen kan per kwartaalgrens, ook zonder exit-fee.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-ink-100 bg-white p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">En de standaarden eronder</h3>
        <p class="mt-3 text-sm text-ink-700 leading-relaxed">
          Openheid is meer dan een exportknop. Onze architectuur staat op FHIR R4, met MedMij en
          Wegiz in afronding, en de koppelingen zijn publiek gedocumenteerd. Wat er live is en
          wat nog niet, houden wij eerlijk bij — inclusief de onderdelen waar wij achterlopen.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/integraties" class="btn-secondary no-underline">Bekijk de integraties</a>
          <a href="/trust" class="btn-secondary no-underline">Trust Centre</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-ink-100 bg-ink-100/40 py-16">
    <div class="container-prose max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900">Wilt u eerst zien wat u ervoor terugkrijgt?</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Logisch. Een migratie is geen besluit dat u op een brochure neemt. Er staat een
        werkende omgeving open waar u zelf in kunt — met verzonnen cliënten, dus u kunt er niets
        stukmaken.
      </p>
      <a href="/demo-omgeving" class="mt-6 inline-block btn-primary no-underline">Log zelf in op de demo</a>
    </div>
  </section>

  <Cta
    title="Wat kost het om bij ons binnen te komen?"
    subtitle="Stuur uw huidige systeem, uw aantal cliënten en uw aantal medewerkers. Wij geven binnen 1 werkdag een inschatting van de migratie — ook als die is dat u beter blijft zitten."
  />
</Base>
