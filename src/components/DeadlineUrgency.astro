---
// Concrete, externe wettelijke data. Rechts alleen een termijn, geen productstatus;
// wat Curanta doet staat onder de pijl. Wetsnamen zoals nagetrokken in het feitenblad (25-09-2026).
import { NIS2CARE_LIVE, NIS2CARE_URL } from '../config/features';

const deadlines = [
  {
    date: '15 augustus 2026',
    daysAway: 'van kracht',
    law: 'Cyberbeveiligingswet (NIS2)',
    obligation: 'Aangewezen entiteiten moeten registreren en passende maatregelen aantonen.',
    module: 'NIS2-incidentmodule in Curanta: registratie en de meldtermijnen van 24 uur, 72 uur en één maand.',
    moduleUrl: NIS2CARE_LIVE ? NIS2CARE_URL : undefined,
    moduleLinkLabel: 'nis2care.nl',
  },
  {
    date: '31 mei jaarlijks',
    daysAway: 'jaarlijks',
    law: 'Wtza-jaarverantwoording',
    obligation: 'Toelatingsverplichte zorgaanbieders verantwoorden zich publiek via DigiMV.',
    module: 'Curanta legt de toelating vast en bewaakt de deadline van de jaarverantwoording, met herinneringen. De aanlevering zelf doet u in DigiMV.',
  },
  {
    date: '1 januari 2027',
    daysAway: 'vanaf 2027',
    law: 'Wtta (toelating uitleners)',
    obligation: 'Wie zorgpersoneel uitleent, heeft een toelating van de NAU nodig. Wie inleent, mag alleen inlenen van een toegelaten uitlener.',
    module: 'Curanta legt uw eigen toelating vast, en per uitlener de controle van zijn toelating, met een controletaak bij elke nieuwe inleenovereenkomst. De toelating zelf vraagt de uitlener aan.',
  },
  {
    date: '2 december 2027',
    daysAway: 'vanaf eind 2027',
    law: 'AI-verordening (hoog risico)',
    obligation: 'AI-toepassingen met een hoog risico moeten aan extra eisen voldoen, zoals een register en een risicobeoordeling. Niet alle AI in de zorg valt daaronder.',
    module: 'Register en classificatie van de AI-systemen in Curanta, met een logboek van AI-aanroepen.',
  },
];
---
<section class="border-y border-ink-100 bg-ink-100/40 py-14">
  <div class="container-prose">
    <div class="max-w-3xl">
      <span class="eyebrow">Agenda 2026–2027</span>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tightish text-ink-900 sm:text-4xl">
        Vier wettelijke data <em class="italic font-semibold text-accent-600">voor 2026–2027</em>.
      </h2>
      <p class="mt-3 text-ink-700">
        Wat de wet vraagt, en wat Curanta daarbij doet.
      </p>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {deadlines.map((d) => (
        <li class="rounded-xl border border-ink-100 bg-white p-5">
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-display text-lg font-bold text-curanta-900">{d.date}</span>
            <span class="text-xs text-ink-500">{d.daysAway}</span>
          </div>
          <h3 class="mt-2 font-semibold text-ink-900 text-sm">{d.law}</h3>
          <p class="mt-1 text-xs text-ink-700 leading-relaxed">{d.obligation}</p>
          <p class="mt-3 text-xs font-medium text-accent-700">→ {d.module}</p>
          {d.moduleUrl && (
            <a href={d.moduleUrl} target="_blank" rel="noopener" class="mt-2 inline-flex items-center gap-1 text-xs font-bold text-curanta-700 no-underline hover:underline">
              {d.moduleLinkLabel ?? d.moduleUrl} ↗
            </a>
          )}
        </li>
      ))}
    </ul>
    <p class="mt-6 text-xs text-ink-500">
      Bron: rijksoverheid.nl, IGJ.nl, Autoriteit Persoonsgegevens; Cyberbeveiligingswet: Staatsblad 2026, 187.
      Curanta volgt wijzigingen en houdt de modulekaart bij.
    </p>
  </div>
</section>
