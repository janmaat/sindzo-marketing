---
import SegmentLayout from '../../layouts/SegmentLayout.astro';
import beeld from '../../assets/schermen/bo-kraamzorg.jpg';
// Nieuw 08-10-2026 (besluit Jan: eigen doelgroeppagina). Nagelopen in de code: kraamweekregistratie
// (Ponscura 4e1b70705, ADR 2026-10-05-kraamweekregistratie), KraamzorgDossier, SegmentenDemoSeed.
// 23-10-2026: kraambezoeken in de planning en het medewerkerportaal, indicatie per onderdeel met herindicatie,
// meerlingen en de eigen bijdrage per verzekeraar zijn gebouwd (Ponscura 7ef39ffb9, ccae3c3e9, 9a56f4a0c,
// c473816ae; feitenblad, rij Kraamzorg).
// 23-10-2026 (later die dag): de Zvw-declaratie KZ301 v3.2 is gebouwd, getoetst aan de recordlayout en de testset van
// Vektis, met de hand aan te leveren in het VECOZO-portaal (Ponscura 388c0148b, ADR 2026-10-23-kz301-kraamzorgdeclaratie).
// Rechtstreeks via VECOZO is voor de kraamzorg niet ingericht; het retourbericht leest de klant in het VECOZO-portaal.
// De LIP-berekening ontbreekt nog; die staat onder "Wat er nog niet is".
---
<SegmentLayout
  image="/og/voor-kraamzorg.png"
  beeld={{ src: beeld, adres: 'app.curanta.nl', alt: 'Backoffice: het kraamdossier van een verzonnen cliënt, met indicatie-uren, de overdracht aan de JGZ en grafieken van de temperatuur van moeder en kind en het gewicht van het kind.', bijschrift: 'Het kraamdossier met de controles van de kraamweek. Opname oktober 2026.' }}
  segmentKey="kraamzorg"
  segmentLabel="Kraamzorg"
  title="Kraamzorgsoftware: dossier, planning en declaratie | Curanta"
  description="Kraamzorg in Curanta: het kraamdossier, kraambezoeken in de planning en op de telefoon, de eigen bijdrage en de Zvw-declaratie (KZ301)."
  eyebrow="Voor de kraamzorg"
  hero="Het kraamdossier, de planning en de declaratie"
  subtitle="De kraamverzorgende legt per controlemoment vast wat zij bij moeder en kind ziet. De planner zet de kraambezoeken op het planbord, en de kraamverzorgende ziet ze in het medewerkerportaal. Na de bevalling legt u de overdracht aan de jeugdgezondheidszorg (JGZ) vast. Uit de goedgekeurde kraambezoeken maakt Curanta de Zvw-declaratie voor de zorgverzekeraar."
  triggers={[
    { title: 'Controles per kraamdag', body: 'Bij de moeder onder meer temperatuur, pols, stand van de baarmoeder en vloeien. Bij het kind onder meer temperatuur, gewicht, geel zien en de navel. Het overleg met de verloskundige staat erbij, en grafieken tonen temperatuur en gewicht over de week.' },
    { title: 'Uren in zicht', body: 'De indicatie legt u per onderdeel vast, met herindicatie; bij een meerling staat elk kind apart. Bezoeken tellen af van de uren uit de indicatie. Die uren vult u zelf in.' },
    { title: 'Bezoeken plannen en op de telefoon', body: 'Kraambezoeken plant u op het planbord, en een collega kan een dossier waarnemen. De kraamverzorgende ziet het bezoek in het medewerkerportaal en legt daar de uren per onderdeel en de controles vast.' },
    { title: 'Declareren bij de zorgverzekeraar', body: 'Per verzekeraar en maand maakt Curanta het declaratiebericht KZ301 van Vektis: één prestatie per kraambezoek, bij een uurtarief afgerond op een kwartier, met de tarieven die u per prestatie vastlegt. Het bestand is getoetst aan de recordlayout en de testset van Vektis. U levert het aan in het VECOZO-portaal en leest daar ook het retourbericht.' },
    { title: 'De eigen bijdrage', body: 'Per verzekeraar stelt u in wie de eigen bijdrage int. Int uw organisatie hem, dan maakt Curanta na het afsluiten van het dossier de factuur via de facturatie, en gaat de eigen bijdrage in de declaratie van het bedrag af. Een correctie gaat met een creditnota.' },
    { title: 'De overdracht aan de JGZ', body: 'Na de bevalling legt u vast of de kraamvrouw toestemming gaf voor de overdracht aan de jeugdgezondheidszorg. U legt ook vast hoe de overdracht ging. Curanta verstuurt zelf niets.' },
    { title: 'Correcties met een reden', body: 'De leidinggevende kan de bevallingsdatum corrigeren. De reden is verplicht en wordt bij de correctie bewaard; het logboek toont dat er gecorrigeerd is.' },
  ]}
  modules={[
    { name: 'Kraamdossier', note: 'Geboortegegevens met Apgar, voeding en afsluiten' },
    { name: 'Kraamweekregistratie', note: 'Controles van moeder en kind per controlemoment' },
    { name: 'Weekgrafieken', note: 'Temperatuur en gewicht' },
    { name: 'Kraambezoeken in de planning', note: 'Op het planbord en in het medewerkerportaal, met de uren per onderdeel' },
    { name: 'Indicatie per onderdeel', note: 'Met herindicatie, en meerdere kinderen bij een meerling' },
    { name: 'Zvw-declaratie (KZ301)', note: 'Per verzekeraar en maand uit de goedgekeurde kraambezoeken; getoetst aan de recordlayout en de testset van Vektis; u levert aan in het VECOZO-portaal' },
    { name: 'Eigen bijdrage', note: 'Per verzekeraar in te stellen; factuur via de facturatie, correctie met een creditnota' },
    { name: 'Overdracht aan de JGZ', note: 'Toestemming en wijze vastleggen; geen digitaal verzenden' },
    { name: 'Logboek (NEN 7513)', note: 'Wie het dossier inzag of wijzigde' },
    { name: 'Uitlegvideo’s', note: 'Een eigen reeks voor de kraamzorg in de app' },
  ]}
  vragen={[
    { vraag: 'Kan Curanta declareren voor de kraamzorg?', antwoord: 'Ja. Curanta maakt per zorgverzekeraar en maand de Zvw-declaratie volgens de standaard KZ301 van Vektis, uit de goedgekeurde kraambezoeken, en toetst het bestand aan de recordlayout en de testset van Vektis. U levert het aan in het VECOZO-portaal; rechtstreeks aanleveren via VECOZO is er voor de kraamzorg niet. Int uw organisatie de eigen bijdrage zelf, dan gaat die van het gedeclareerde bedrag af, en maakt Curanta de factuur aan de kraamvrouw via de facturatie.' },
  ]}
  nogNiet={[
    'Rechtstreeks aanleveren via VECOZO voor de kraamzorg: u levert de declaratie aan in het VECOZO-portaal.',
    'Een berekening van de indicatie volgens het Landelijk Indicatieprotocol: de uren vult u zelf in.',
    'Een bezoek dat in het medewerkerportaal is afgerond, komt nog niet vanzelf in het kraamdossier.',
    'Grenswaarden of signalen bij de controles: Curanta legt vast, maar bewaakt geen protocol.',
    'De overdracht aan de JGZ digitaal versturen.',
  ]}
  regulatory={['Zvw', 'Wkkgz', 'AVG', 'NEN 7510']}
/>
