---
import SegmentLayout from '../../layouts/SegmentLayout.astro';
---
<SegmentLayout
  image="/og/voor-ghz.png"
  segmentKey="ghz"
  segmentLabel="GHZ"
  title="Gehandicaptenzorg-software | Curanta"
  description="Software voor de gehandicaptenzorg: ondersteuningsplan (OPP), dagbesteding, cliëntportaal en declaratie in één systeem, in de taal van de sector."
  eyebrow="Voor de gehandicaptenzorg"
  hero="Ondersteuningsplan, dagbesteding en contact met familie — in één systeem."
  subtitle="Curanta brengt het ondersteuningsplan (OPP), de dagbestedingslogistiek en het contact met naasten samen. De begrippen van de gehandicaptenzorg (OPP, AVB-verslag) zijn ingebouwd — niet bijgebogen vanuit een VVT-model."
  triggers={[
    { title: 'Versnipperde dagbesteding', body: 'Aanwezigheid, activiteiten, rapportages en foto\'s zitten nu vaak in verschillende systemen. Curanta brengt ze samen rond één cliëntdossier.' },
    { title: 'Familie wil meekijken', body: 'Naasten verwachten een portaal voor berichten, foto\'s en taken. Curanta levert dat standaard, met privacy als uitgangspunt en een versleuteld BSN.' },
    { title: 'Wzd-registratie', body: 'Het stappenplan onvrijwillige zorg en de halfjaarlijkse uitdraai voor de IGJ zitten erin. De XML-uitdraai is nog niet gevalideerd tegen de specificatie van de IGJ.' },
    { title: 'Het ondersteuningsplan centraal', body: 'Het ondersteuningsplan is het hart van de gehandicaptenzorg. Curanta legt het OPP vast met levensdomeinen en persoonlijke doelen, plus het AVB-verslag — niet als een uitgekleed zorgplan.' },
    { title: 'Wettelijk vertegenwoordigers in eigen taal', body: 'Ouders en curatoren van GHZ-cliënten met niet-Nederlandse achtergrond willen het dossier in eigen taal volgen. Het cliëntportaal werkt in het Nederlands, Engels, Turks, Arabisch en Duits — volgens onze eigen marktscan van mei 2026 biedt geen Nederlandse concurrent dat.' },
  ]}
  modules={[
    { name: 'Ondersteuningsplan (OPP) en AVB-verslag', note: 'Levensdomeinen en persoonlijke doelen' },
    { name: 'Groepszorg & dagbesteding', note: 'Activiteiten, aanwezigheid, foto\'s, rapportages' },
    { name: 'Cliëntportaal', note: 'Voor cliënten, familie en mantelzorgers: taken, berichten, agenda' },
    { name: 'Wzd-stappenplan', note: 'Met halfjaarlijkse XML-uitdraai (nog niet gevalideerd tegen de IGJ-specificatie)' },
    { name: 'Aanmelding, triage en wachtlijst', note: 'Met een aparte module voor multidisciplinair overleg (MDO)' },
    { name: 'iWlz + CAK', note: 'Berichten versturen via Vecozo; retourberichten handmatig inlezen' },
    { name: 'Vragenlijsten (PREM)', note: 'Cliënt- en naastentevredenheid' },
    { name: 'Cliëntagenda', note: 'Activiteiten, afspraken, MDO\'s' },
  ]}
  regulatory={['Wzd', 'Wlz', 'Wkkgz', 'Wtza', 'AVG', 'NEN 7510']}
  proofPoints={[
    { value: 'Wzd', label: 'Stappenplan en halfjaarlijkse uitdraai' },
    { value: '1 dossier', label: 'Voor cliënt + naasten + team' },
    { value: 'EU', label: 'Hosting (IONOS, Berlijn) · ondersteuning in het Nederlands' },
    { value: 'BSN', label: 'Versleuteld (AES-256-GCM)' },
  ]}
/>
