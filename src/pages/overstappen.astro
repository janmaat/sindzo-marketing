---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { DEMO_ZELF_AANGEBODEN, DEMO_EERSTE } from '../config/demo';

// Onderzocht: de reden dat zorgorganisaties niet van ECD wisselen is niet
// tevredenheid maar dataportabiliteit — ze kunnen hun cliëntgegevens niet
// meenemen en zouden alles opnieuw moeten invoeren. Berenschot noemt het
// voorkomen van lock-in zelf als remedie tegen administratieve druk. Deze
// pagina is het antwoord daarop; het stond eerder als één regel in de FAQ op
// /prijzen. Zie docs/marktonderzoek-conversie-curanta-2026-08-17.md.

// Stemgids (14-10-2026): elke kaart zei "migratieproject tegen een vaste prijs die vooraf vaststaat" en
// "een kant-en-klare import is er nog niet". Dat staat nu één keer in de inleiding; per systeem staat alleen
// wat verschilt. Geen bewering is weggevallen of sterker geworden.
const bronsystemen: { naam: string; toelichting?: string; bron?: string }[] = [
  {
    naam: 'Nedap Ons',
    toelichting: 'Cliënten, zorgplannen, rapportages en medewerkers gaan mee. De route stellen we per organisatie samen op.',
  },
  {
    naam: 'Gerimedica Ysis',
    toelichting: 'De planning bepalen we samen. Wij zeggen liever "nog niet" dan dat we u een datum beloven die we niet halen.',
  },
  { naam: 'SDB' },
  {
    naam: 'mijnCaress (PinkRoccade)',
    toelichting: 'Volgens M&I/Partners (ECD-inventarisatie 2025) trekt mijnCaress zich als ECD terug uit de markt.',
    bron: 'https://mxi.nl/kennis/730/ecd-inventarisatie-2025-gehandicaptenzorg-en-ouderenzorg',
  },
  { naam: 'Pluriform Zorg (Adapcare)' },
];
---
<Base
  title="Overstappen van uw huidige ECD | Curanta"
  description="Overstappen vanuit Nedap Ons, Ysis, SDB of Pluriform Zorg als project tegen een vaste prijs vooraf. En zo komt u er weer uit: export, geen exit-fee."
>
  <PageHero
    eyebrow="Overstappen"
    title="Vastzitten is geen argument om te blijven."
    subtitle="De meest genoemde reden om bij een ECD te blijven, is niet dat het zo goed is. Het is dat de gegevens er niet uit komen. Alles opnieuw invoeren is voor niemand te doen. Daar hebben wij een antwoord op: vóór u klant wordt, en ook voor als u ooit weer weg wilt."
  >
    <div slot="actions" class="flex flex-wrap items-center gap-3">
      <a href="/contact" class="btn-primary no-underline">Vraag een migratie-inschatting</a>
      <a href="#eruit" class="btn-secondary no-underline">Eerst: hoe komt u er weer uit?</a>
    </div>
  </PageHero>

  <section class="container-prose py-16">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Waar u vandaan komt</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Wij zetten de migratie per bronsysteem op. U hoeft ons dus geen Excel-bestand te sturen. Dat is
        meer werk voor ons en minder voor u. Voor elk systeem is het een migratieproject tegen een vaste
        prijs die u vooraf weet: geen open einde, geen nacalculatie. Een kant-en-klare import is er voor
        geen van deze systemen nog.
      </p>
    </div>

    {/* Systeem links, wat er speelt rechts. Was een raster van vijf kaarten (een leeg vak, en twee kaarten
        die alleen herhaalden wat voor alle systemen geldt). */}
    <dl class="mt-10 max-w-4xl divide-y divide-ink-200 border-y border-ink-200">
      {bronsystemen.map((b) => (
        <div class="grid gap-1 py-5 sm:grid-cols-[15rem_1fr] sm:gap-8">
          <dt class="font-display text-lg font-semibold text-ink-900">{b.naam}</dt>
          <dd class="text-pretty leading-relaxed text-ink-700">
            {b.toelichting ?? 'Zoals hierboven: een migratieproject tegen een vaste prijs.'}
            {b.bron && <a href={b.bron} rel="noopener" class="ml-1 text-sm font-semibold text-curanta-700">Bron: M&amp;I/Partners</a>}
          </dd>
        </div>
      ))}
    </dl>

    <p class="mt-6 text-sm text-ink-500 max-w-3xl">
      Staat uw systeem er niet bij? Vraag het gewoon. Wij zeggen het ook als een import niet
      loont en handmatig overzetten goedkoper is. Dat komt voor bij kleine cliëntenbestanden.
    </p>
  </section>

  <section class="border-y border-ink-100 bg-curanta-50/60 py-16">
    <div class="container-prose">
      <div class="max-w-3xl">
        <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Wat het kost en hoe lang het duurt</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">
          In ECD-selectieadviezen komt steeds dezelfde valkuil terug: organisaties onderschatten hoeveel werk
          de invoering is. Ze kijken naar de software en vergeten de voorbereiding, de training en de
          begeleiding. Daarom staan die hier bij de prijs, niet ernaast.
        </p>
      </div>

      {/* Term links, uitleg rechts, in plaats van drie gelijke kaarten (Taste Skill, 14-10-2026). */}
      <dl class="mt-10 max-w-4xl divide-y divide-ink-200 border-y border-ink-200">
        <div class="grid gap-2 py-6 sm:grid-cols-[13rem_1fr] sm:gap-8" data-reveal>
          {/* Tot 18-10-2026 stond hier "De invoering en de training zitten in het abonnement": sinds het besluit
              van Jan op 15-10 is de implementatie maatwerk (feitenblad, rij Implementatie). */}
          <dt class="font-display text-lg font-semibold text-ink-900">Training en implementatie</dt>
          <dd class="text-pretty leading-relaxed text-ink-700">
            De training zit in het abonnement. De implementatie is maatwerk, met een prijs die wij
            vooraf afspreken. Het overzetten van uw gegevens is een eigen project, tegen een vaste prijs
            die u vooraf weet.
          </dd>
        </div>
        <div class="grid gap-2 py-6 sm:grid-cols-[13rem_1fr] sm:gap-8" data-reveal style="--reveal-vertraging:80ms">
          <dt class="font-display text-lg font-semibold text-ink-900">Doorlooptijd</dt>
          <dd class="text-pretty leading-relaxed text-ink-700">
            Die spreken we per organisatie af, na de migratie-inschatting. Wij zijn nieuw. Een
            doorlooptijd die nog geen enkele klant heeft gehaald, noemen wij liever niet.
          </dd>
        </div>
        <div class="grid gap-2 py-6 sm:grid-cols-[13rem_1fr] sm:gap-8" data-reveal style="--reveal-vertraging:160ms">
          <dt class="font-display text-lg font-semibold text-ink-900">Grotere trajecten</dt>
          <dd class="text-pretty leading-relaxed text-ink-700">
            Is het traject complexer of groter, dan maken wij er een project van tegen een vaste
            prijs. U weet het bedrag vooraf, ook
            als het ons meer tijd kost dan gedacht.
          </dd>
        </div>
      </dl>

      <p class="mt-6 text-sm text-ink-500">
        De tarieven per plan staan bij <a href="/prijzen" class="text-curanta-700 hover:underline">de prijzen</a>.
        Hoe uw eigen implementatieproject werkt, leest u bij
        <a href="/implementatie" class="text-curanta-700 hover:underline">de implementatie</a>.
      </p>
    </div>
  </section>

  <section id="eruit" class="container-prose py-16">
    <div class="max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">En hoe u er weer uit komt</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Hoe u weggaat, hoort op dezelfde pagina als hoe u binnenkomt, en niet in de kleine letters. Een leverancier
        die u alleen vertelt hoe u binnenkomt, heeft er belang bij dat u niet weg kunt. Wij
        vinden vastzitten aan een leverancier een ontwerpfout, geen verdienmodel.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-ink-100 bg-white p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">Uw gegevens blijven van u</h3>
        <ul class="mt-4 space-y-3 text-sm text-ink-700">
          <li>Een volledige export van uw gegevens en bestanden in JSON, zonder exit-fee.</li>
          <li>Bij beëindiging krijgt u de export binnen 5 werkdagen. U heeft 30 dagen om hem op te halen. Na afloop van die 30 dagen wissen wij al uw gegevens, en u krijgt een vernietigingsverklaring.</li>
          <li>Naar een lager plan wisselen kan per contractjaar, ook zonder exit-fee.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-ink-100 bg-white p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">En de standaarden eronder</h3>
        <p class="mt-3 text-sm text-ink-700 leading-relaxed">
          Een exportknop alleen is niet genoeg. Andere systemen kunnen de Basisgegevensset Zorg (BgZ)
          uit Curanta lezen via een FHIR-API; schrijven kan die API niet. Twee koppelingen bouwen wij
          nog: MedMij, voor uitwisseling met de persoonlijke gezondheidsomgeving van de cliënt, en
          eOverdracht, de digitale verpleegkundige overdracht. Op de pagina Koppelingen staat per
          koppeling hoe ver die is, ook als iets nog niet klaar is.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/integraties" class="btn-secondary no-underline">Bekijk de koppelingen</a>
          <a href="/trust" class="btn-secondary no-underline">Trust Centre</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-ink-100 bg-ink-100/40 py-16">
    <div class="container-prose max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ink-900">Wilt u eerst zien wat u ervoor terugkrijgt?</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        Logisch. Een migratie is geen besluit dat u op een brochure neemt.
        {DEMO_ZELF_AANGEBODEN
          ? 'Kijk zelf rond in een werkende omgeving met verzonnen cliënten; u kunt er niets stukmaken.'
          : 'Stuur ons drie werkstromen uit uw organisatie; dan laten wij ze zien in een werkende omgeving met verzonnen cliënten.'}
      </p>
      <a href={DEMO_EERSTE.href} class="mt-6 inline-block btn-primary no-underline">{DEMO_EERSTE.label}</a>
    </div>
  </section>

  <Cta
    title="Wat kost uw overstap?"
    subtitle="Noem ons uw huidige systeem, uw aantal cliënten en uw aantal medewerkers. Wij reageren binnen 1 werkdag en maken een afspraak voor de migratie-inschatting, ook als de uitkomst is dat u beter kunt blijven zitten."
    primary={{ label: 'Vraag een migratie-inschatting', href: '/contact' }}
    secondary={DEMO_EERSTE}
  />
</Base>
