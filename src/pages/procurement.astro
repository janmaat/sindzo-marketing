---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { DEMO_ZELF_AANGEBODEN, HOOFDKNOP } from '../config/demo';
import { CYBERBEVEILIGINGSWET } from '../config/kennisbank';

// Inkoopdossier (slug /procurement blijft). Bewust zonder formulier vóór de documenten: in de
// Nederlandse zorg verlengt elke drempel de cyclus met dagen, omdat inkoop, FG en architectuur
// ieder hun eigen review willen doen.
//
// Feitenblad (besluit Jan 25-09-2026): deze documenten bestaan nog niet als kant-en-klaar
// bestand. Dus nooit "downloaden" of "ingevuld", en geen levertermijn per document: de enige
// termijn is "wij reageren binnen 1 werkdag". Aanvragen gaan naar trust@ (inkoop, DPA,
// beveiliging).

interface Resource {
  title: string;
  body: string;
  /** Interne pagina, of 'mailto:...' voor een document dat wij op aanvraag opstellen. */
  file: string;
  /** Label naast de titel. */
  format: string;
  category: string;
}

const onRequest = (subject: string) =>
  `mailto:trust@curanta.nl?subject=${encodeURIComponent('Aanvraag document: ' + subject)}`;

const resources: Resource[] = [
  // 21-10-2026: het deel van het PVE over de overstap bestaat nu als pagina en Word-bestand (feitenblad, Documenten
  // voor inkoop); het volledige PVE voor zorg, planning en administratie blijft op aanvraag.
  {
    category: 'Programma van eisen en selectie',
    title: 'Programma van eisen voor een overstap',
    body: 'De eisen over migratie, declaraties rond de overstap, het oude dossier, exit, beveiliging en continuïteit. Leverancier-neutraal, als webpagina en als Word-bestand.',
    file: '/overstappen/programma-van-eisen',
    format: 'Webpagina en Word',
  },
  {
    category: 'Programma van eisen en selectie',
    title: 'Vragen aan uw huidige leverancier',
    body: 'Dertien vragen die u stelt vóór u opzegt: export, BSN, kosten, opzegtermijn en de Dataverordening, het oude dossier, declaraties, logging, vernietiging en beveiligingsupdates.',
    file: '/overstappen/vragen-aan-uw-leverancier',
    format: 'Webpagina',
  },
  {
    category: 'Programma van eisen en selectie',
    title: 'Overstapscan',
    body: 'Tien vragen over uw situatie, en een overzicht om te delen met bestuur, OR en cliëntenraad: planning vanaf de einddatum van uw contract, eisen, vragen en kosten.',
    file: '/overstapscan',
    format: 'Webpagina',
  },
  {
    category: 'Programma van eisen en selectie',
    title: 'Programma van eisen (PVE), volledig',
    body: 'Een Word-document met categorieën eisen voor zorg, planning en administratie, die u kunt aanvinken en aanpassen. Bedoeld om zorgvuldig te kiezen, niet als spreadsheet om in te vullen.',
    file: onRequest('Programma van eisen'),
    format: 'Op aanvraag',
  },
  {
    category: 'Programma van eisen en selectie',
    title: 'Vergelijkingsmatrix leveranciers',
    body: 'Een spreadsheet met criteria per onderwerp: functioneel, technisch en commercieel.',
    file: onRequest('Vergelijkingsmatrix leveranciers'),
    format: 'Op aanvraag',
  },
  {
    category: 'Privacy en beveiliging',
    title: 'Verwerkersovereenkomst',
    body: 'Onze verwerkersovereenkomst, met een bijlage over de subverwerkers. In uitvoering; geen NDA nodig om hem in te zien.',
    file: onRequest('Verwerkersovereenkomst'),
    format: 'Op aanvraag',
  },
  {
    category: 'Privacy en beveiliging',
    title: 'Opzet voor uw eigen DPIA',
    body: 'Voor de DPIA die u zelf maakt als u Curanta aanschaft. Met een voorbeeld van een risicoanalyse en de maatregelen.',
    file: onRequest('Opzet DPIA'),
    format: 'Op aanvraag',
  },
  {
    category: 'Privacy en beveiliging',
    title: 'Beveiligingsdossier',
    body: 'De stand van NEN 7510, bewijs per beheersmaatregel en de lijst van subverwerkers. Een externe pentest is nog niet uitgevoerd.',
    file: onRequest('Beveiligingsdossier'),
    format: 'Op aanvraag',
  },
  {
    category: 'Privacy en beveiliging',
    title: 'Uw beveiligingsvragenlijst',
    body: 'Stuurt u uw eigen vragenlijst, bijvoorbeeld CAIQ of SIG, dan vullen wij die in.',
    file: onRequest('Beveiligingsvragenlijst'),
    format: 'Op aanvraag',
  },
  {
    category: 'Architectuur en SLA',
    title: 'Architectuurplaat',
    body: 'Eén pagina met de opbouw van het systeem: modules, koppelingen, hosting, inloggen en gegevensstromen. Voor I&A en architectuur.',
    file: onRequest('Architectuurplaat'),
    format: 'Op aanvraag',
  },
  {
    category: 'Architectuur en SLA',
    title: 'SLA-overzicht',
    body: 'Beschikbaarheid, herstel na een storing (RPO en RTO) en bereikbaarheid. Voor Enterprise maken wij in overleg eigen afspraken.',
    file: onRequest('SLA-overzicht'),
    format: 'Op aanvraag',
  },
  {
    category: 'Architectuur en SLA',
    title: 'Stand van de API',
    body: 'De publieke FHIR R4-API voor de Basisgegevensset Zorg (BgZ), alleen om te lezen: wat er is en wat niet. Een openbare pagina.',
    file: '/api',
    format: 'Webpagina',
  },
  {
    category: 'Implementatie',
    title: 'Implementatieaanpak (presentatie)',
    body: 'Voor projectgroep en bestuur: de fasen, de besturing en de rol van de sleutelgebruikers.',
    file: onRequest('Presentatie implementatieaanpak'),
    format: 'Op aanvraag',
  },
  {
    category: 'Implementatie',
    title: 'Migratie per bronsysteem',
    body: 'Per bronsysteem wat wij overzetten, wat handwerk is en wat het kost. Migratie vanuit Nedap Ons, Gerimedica Ysis, SDB, mijnCaress, Lable Care, Fierit en Pluriform Zorg (Adapcare) is een project tegen een vaste prijs vooraf. Cliënten en medewerkers gaan over met de import uit een CSV- of Excelbestand; zorgplannen en het oude dossier als pdf in het dossier van de cliënt.',
    file: onRequest('Migratie per bronsysteem'),
    format: 'Op aanvraag',
  },
  {
    category: 'Kosten en opbrengst',
    title: 'Rekenhulp kosten en opbrengst',
    body: 'Een spreadsheet om uw eigen totale kosten en opbrengst in te vullen, per plan.',
    file: onRequest('Rekenhulp kosten en opbrengst'),
    format: 'Op aanvraag',
  },
];

const categories = Array.from(new Set(resources.map(r => r.category)));
---
<Base
  title="Inkoopdossier: documenten voor inkoop, FG en I&A | Curanta"
  description="Programma van eisen, verwerkersovereenkomst, beveiligingsdossier, architectuurplaat en SLA: wij stellen ze op aanvraag op, zonder NDA."
>
  <PageHero
    eyebrow="Inkoopdossier"
    title="Alles wat uw inkoop, FG en I&A willen lezen."
    subtitle="In de zorg heeft een aankoop minstens vier interne lezers: bestuur, inkoop, FG en I&A. Hieronder vraagt u elk document aan met één mail, zonder geheimhoudingsverklaring (NDA) en zonder verkoopgesprek."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href={HOOFDKNOP.href} class="btn-primary no-underline">{HOOFDKNOP.label}</a>
      <a href="/trust" class="btn-secondary no-underline">Naar het Trust Centre</a>
    </div>
  </PageHero>

  <section class="border-y border-amber-200 bg-amber-50 py-6">
    <div class="container-prose">
      <p class="text-sm text-amber-900">
        <strong>De meeste documenten op aanvraag.</strong>
        Het programma van eisen voor een overstap, de vragen aan uw huidige leverancier en de overstapscan staan online.
        De andere documenten liggen nog niet kant-en-klaar: wij stellen ze op aanvraag op, afgestemd
        op uw sector, omvang en vragen. Wij reageren binnen 1 werkdag. Laat uw eigen jurist of FG
        meekijken bij uw definitieve programma van eisen (PVE) of verwerkersovereenkomst. Onze
        documenten zijn geen juridisch advies.
      </p>
    </div>
  </section>

  {/* Onderzocht: NEN 7510 geldt óók voor softwareleveranciers die
      patiëntgegevens verwerken, naleving moet via onafhankelijk onderzoek worden
      vastgesteld, en verzekeraars kunnen de norm contractueel opleggen. Voor een
      deel van de markt is het ontbreken van een certificaat dus een reden om ons
      niet op de shortlist te zetten. Dat hier verzwijgen kost twee keer: de deal
      die er toch niet was, én het vertrouwen bij de rest. Vandaar boven de
      documentenlijst, waar inkoop en de informatiebeveiliger er als eerste naar zoeken. */}
  <section class="container-prose py-14 border-b border-ink-100">
    <div class="rounded-2xl border border-ink-200 bg-white p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <h2 class="font-display text-2xl font-bold text-ink-900">NEN 7510: waar wij staan</h2>
        <span class="badge whitespace-nowrap">
          <span class="status-dot bg-curanta-300"></span>
          nog niet gecertificeerd
        </span>
      </div>

      <p class="mt-4 max-w-3xl text-ink-700 leading-relaxed">
        Wij zijn <strong>niet</strong> NEN 7510-gecertificeerd. NEN 7510 is de norm voor
        informatiebeveiliging in de zorg. De maatregelen zijn ingevoerd en een eerste keer beoordeeld,
        en de externe audit staat gepland voor <strong>Q4 2026</strong>. Zolang die niet is afgerond,
        hebben wij een werkdocument en geen certificaat. Dat is een wezenlijk verschil, en dat willen
        wij niet wegpoetsen.
      </p>

      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="font-display text-lg font-semibold text-ink-900">Wat u van ons krijgt</h3>
          <ul class="mt-3 space-y-2 text-sm text-ink-700">
            <li>Verwerkersovereenkomst en de actuele lijst van subverwerkers (op aanvraag)</li>
            <li>Bewijs per beheersmaatregel, volgens de opbouw van NEN 7510:2024 (op aanvraag)</li>
            <li>Antwoorden op uw beveiligingsvragenlijst, bijvoorbeeld CAIQ of SIG (op aanvraag)</li>
            <li>Het volledige <a href="/trust" class="text-curanta-700 hover:underline">Trust Centre</a>, openbaar en zonder NDA</li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-ink-900">Voor wie dit vandaag een blokkade is</h3>
          <p class="mt-3 text-sm text-ink-700 leading-relaxed">
            Stelt uw inkoopbeleid of uw zorgverzekeraar certificering als harde eis, dan zijn wij
            nu geen geldige kandidaat. Zeg dat gerust meteen. Dan verspillen wij uw tijd niet
            met een traject dat op die eis afketst. Wij melden ons na de audit opnieuw.
          </p>
          <p class="mt-3 text-sm text-ink-700 leading-relaxed">
            Weegt uw organisatie op dit moment aantoonbare maatregelen zwaarder dan een
            certificaat? Dan is het materiaal hieronder precies voor die afweging bedoeld.
          </p>
        </div>
      </div>
    </div>
  </section>

  {categories.map((cat) => (
    <section class="container-prose py-14 border-b border-ink-100 last:border-0">
      <h2 class="font-display text-2xl font-bold text-ink-900">{cat}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {resources.filter(r => r.category === cat).map((r) => (
          <article class="rounded-xl border border-ink-100 bg-white p-6">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
              <h3 class="min-w-0 font-display text-lg font-semibold text-ink-900">{r.title}</h3>
              <span class="badge whitespace-nowrap">{r.format}</span>
            </div>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{r.body}</p>
            {r.file.startsWith('mailto:') ? (
              <a href={r.file} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-curanta-700 no-underline hover:underline">
                <span>✉ Aanvragen per e-mail</span>
              </a>
            ) : (
              <a href={r.file} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-curanta-700 no-underline hover:underline">
                <span>→ Bekijken</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="container-prose py-16">
    <div class="rounded-2xl border border-ink-200 bg-ink-100/50 p-8">
      <h2 class="font-display text-2xl font-bold text-ink-900">Mist u iets?</h2>
      <p class="mt-3 max-w-2xl text-ink-700">
        Vraagt uw inkoop of uw informatiebeveiliger een document dat hier niet staat? Mail het ons;
        wij reageren binnen 1 werkdag.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="mailto:trust@curanta.nl" class="btn-primary no-underline">trust@curanta.nl</a>
        <a href="mailto:info@curanta.nl" class="btn-secondary no-underline">info@curanta.nl (algemene vragen)</a>
      </div>
    </div>
  </section>

  <RelatedArticles articles={[CYBERBEVEILIGINGSWET]} />

  <Cta
    title={DEMO_ZELF_AANGEBODEN ? 'Na het lezen zelf kijken?' : 'Na het lezen in het systeem kijken?'}
    subtitle={DEMO_ZELF_AANGEBODEN
      ? 'Kijk zelf rond in een werkende omgeving met verzonnen cliënten. Of stuur drie typische werkstromen uit uw organisatie; dan laten wij uw eigen processen op het scherm zien, zonder verkooppraatje.'
      : 'Bekijk Curanta rustig zelf in de online presentatie, wanneer het u uitkomt. Of stuur drie typische werkstromen uit uw organisatie; dan laten wij uw eigen processen op het scherm zien, met verzonnen cliënten en zonder verkooppraatje.'}
  />
</Base>
