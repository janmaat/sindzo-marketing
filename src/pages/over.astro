---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
---
<Base
  image="/og/over.png"
  title="Over Curanta: wie wij zijn en waarom | Curanta"
  description="Wie Curanta is, waarom het bestaat en waar het bedrijf staat: Helmond, hosting in de EU, en een eerlijke status per onderdeel."
>
  <PageHero
    eyebrow="Over Curanta"
    title="Gebouwd voor de Nederlandse zorg."
    subtitle="Wij bouwen zorgsoftware voor de Nederlandse praktijk, omdat de bestaande pakketten vaak administratie toevoegen in plaats van weghalen. Voor u betekent dat: minder tijd aan registreren, en een leverancier die eerlijk zegt wat er al is."
  />

  <section class="container-prose py-16">
    <div class="grid gap-12 lg:grid-cols-2">
      <article class="prose-content">
        <h2 class="font-display text-2xl font-bold text-ink-900">Waarom Curanta bestaat</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">
          De Nederlandse zorg loopt vast op administratieve last. Niet omdat zorgverleners onwillig zijn,
          maar omdat de software die zij gebruiken vaak ontworpen is voor de boekhouder, niet voor de
          wijkverpleegkundige om 22:00 uur. Wij geloven dat software in de zorg de stille partner moet
          zijn: er als het nodig is, weg als het niet nodig is.
        </p>
        <p class="mt-4 text-ink-700 leading-relaxed">
          Daarom bouwen wij Curanta: één modulair systeem dat <em>met</em> de zorg meegroeit in plaats
          van die te dwingen tot ons proces. Met een medewerkerportaal op de telefoon, zodat bij de
          cliënt gerapporteerd kan worden. Met één dossier, zodat dezelfde feiten niet drie keer worden
          ingevoerd. Met een Trust Centre dat helder maakt wat wel en niet kan voor er een audit komt.
        </p>
      </article>

      <article class="prose-content">
        <h2 class="font-display text-2xl font-bold text-ink-900">Wie zit erachter</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">
          <strong>Curanta</strong> is een Nederlands bedrijf uit Helmond. Curanta is een handelsnaam
          van Maat Holding B.V.
        </p>
        <p class="mt-4 text-ink-700 leading-relaxed">
          Wij zijn nieuw en klein. Dat betekent korte lijnen: u spreekt rechtstreeks met Curanta,
          niet met een callcenter of een ticketsysteem.
        </p>
      </article>
    </div>
  </section>

  <section class="border-y border-ink-100 bg-ink-100/40 py-16">
    <div class="container-prose">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Onze principes</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {[
          { title: 'Open over de stand van zaken', body: 'Beveiliging, privacy en koppelingen staan openbaar in het Trust Centre, niet pas in een aanbesteding. Met een eerlijke status: groen, geel of grijs.' },
          { title: 'Uw werkwijze eerst', body: 'Wij vragen in een demo naar uw werkstromen, niet naar een lijst eisen. Een systeem dat alles aanvinkt maar niet past, schiet tekort.' },
          { title: 'Geen overdracht', body: 'Wie u spreekt in de aanloop, blijft uw aanspreekpunt na de ingebruikname. Er is geen implementatieteam dat het overneemt.' },
          { title: 'Modulair', body: 'U zet aan wat u nodig hebt, en later bijzetten kan zonder overstap. Geen pakket waarin u zelf moet uitzoeken wat u gebruikt.' },
          { title: 'Nederlands bedrijf, hosting in de EU', body: 'Hosting bij IONOS Cloud in Berlijn, ondersteuning op Nederlandse werktijden, Nederlands recht. Uw gegevens zijn van u; de exit staat in de voorwaarden.' },
          { title: 'Meertalig cliëntportaal', body: 'Het cliëntportaal werkt in 5 talen (NL, EN, TR, AR, DE) — voor cliënten en familie die hun dossier in hun eigen taal willen volgen. Volgens onze eigen marktscan van mei 2026 biedt geen Nederlandse VVT- of GHZ-concurrent dat.' },
        ].map((p) => (
          <article class="rounded-xl border border-ink-100 bg-white p-6">
            <h3 class="font-display text-lg font-semibold text-ink-900">{p.title}</h3>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-prose py-16">
    <div class="rounded-2xl border border-ink-100 bg-white p-8">
      <h2 class="font-display text-2xl font-bold text-ink-900">Bedrijfsgegevens</h2>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Handelsnaam</dt>
          <dd class="mt-1 text-ink-900">Curanta</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Rechtspersoon</dt>
          <dd class="mt-1 text-ink-900">Curanta is een handelsnaam van Maat Holding B.V.</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">KvK-nummer</dt>
          <dd class="mt-1 text-ink-900">09147820</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Vestiging</dt>
          <dd class="mt-1 text-ink-900">Marshallstraat 26, 5705 CN Helmond, Nederland</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Algemeen contact</dt>
          <dd class="mt-1"><a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Privacy</dt>
          <dd class="mt-1"><a href="mailto:privacy@curanta.nl" class="text-curanta-700 hover:underline">privacy@curanta.nl</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <Cta />
</Base>
