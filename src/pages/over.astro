---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { DEMO_ZELF_AANGEBODEN } from '../config/demo';

// De drie mensen achter Curanta. Elk feit hier staat in het feitenblad (rij "Mensen", besluit Jan 15-10-2026),
// met dezelfde levensloop als op sigillum.nl/over, maar zonder het notariaat: Curanta gaat over de zorg.
const mensen = [
  {
    rol: 'Founder en CTO',
    naam: 'Jan Maat',
    foto: 'jan-maat',
    tekst:
      'Jan werkt sinds 1997 in de software, en sinds 2001 heeft hij een eigen softwarebedrijf. Daarmee bouwde hij software voor organisaties in veel verschillende branches. Curanta is zijn initiatief. Als CTO leidt hij de techniek, en samen met ons team bouwde hij het product.',
  },
  {
    rol: 'Co-founder en CEO',
    naam: 'Erwin C.A. van der Star',
    foto: 'erwin-van-der-star',
    tekst:
      'Erwin richtte in 1990 een softwarebedrijf op en leidde het tien jaar als directeur en grootaandeelhouder. Daarna ging hij de zorg in. Hij richtte Vitaphone Nederland op en leidde het bijna vijftien jaar. Met Massyst Group en PicoCare Europe bouwt hij bedrijven die zorginnovaties ontwikkelen en op de markt brengen. Bij Curanta komen zijn twee vakken samen, nu als CEO.',
  },
  {
    rol: 'Co-founder en COO',
    naam: 'Janus Hoeks',
    foto: 'janus-hoeks',
    tekst:
      "Janus richtte in 1989 Intemo op. Het bedrijf maakt industriële computers en panel-pc's voor klanten in heel Europa, en hij is er nog altijd eigenaar van. Hij was ook directeur van Niteon en ECOserver. Sinds 2025 is hij samen met Erwin co-founder van Massyst Group en PicoCare Europe. Bij Curanta zorgt hij als COO voor de bedrijfsvoering, met zijn ervaring in het opbouwen van technologiebedrijven.",
  },
];

// Wat we oplossen: de vier dingen waar een zorgorganisatie het eerst naar vraagt. Elke zin komt uit het
// feitenblad (hosting, subverwerkers, BSN, migratie, export en exit, medewerkerportaal, offline, roostertoets,
// NEN 7510, NIS2).
const themas = [
  {
    eyebrow: 'Gegevens',
    titel: 'Waar de gegevens van uw cliënten staan',
    tekst:
      'Het cliëntdossier staat in Duitsland, binnen de EU, versleuteld opgeslagen. Het BSN is daarnaast op veldniveau versleuteld. Cliënten en mantelzorgers werken in een eigen cliëntportaal, los van de backoffice. De AI-functies draaien standaard bij Mistral AI, via het EU-endpoint, gepseudonimiseerd; Mistral bewaart de gegevens niet en traint er niet mee. Kiest uw organisatie zelf voor Anthropic, dan gaan ze naar de VS, onder de modelcontractbepalingen (SCC). Zet u AI uit, dan gaat er niets heen.',
  },
  {
    eyebrow: 'Overstappen',
    titel: 'Overstappen zonder open einde',
    tekst:
      'Wij maken eerst een migratie-inschatting, en daarna is de overstap een project tegen een vaste prijs die u vooraf weet. Cliënten en medewerkers importeert u uit een CSV- of Excelbestand, met een sjabloon uit Curanta. Zorgplannen en het oude dossier kunnen als pdf mee in het dossier van de cliënt. Uw gegevens blijven van u: bij vertrek krijgt u binnen 5 werkdagen een volledige export van uw gegevens en bestanden in JSON.',
  },
  {
    eyebrow: 'Administratie',
    titel: 'Rapporteren bij de cliënt, niet achteraf',
    tekst:
      'Op het medewerkerportaal ziet de zorgmedewerker haar rooster, de bezoeken met hun taken en het zorgplan. De SOEP-rapportage schrijft zij bij het bezoek zelf. Het portaal werkt ook zonder bereik: wat zij dan vastlegt, blijft versleuteld op de telefoon tot het verstuurd kan worden.',
  },
  {
    eyebrow: 'Regels',
    titel: 'De regels in het werk zelf',
    tekst:
      'Bij het plannen toetst Curanta het rooster aan de Arbeidstijdenwet, met het artikel bij elke melding. Voor NEN 7510:2024 is er een controlesuite; gecertificeerd zijn wij nog niet, en het certificeringstraject is in voorbereiding. Voor de Cyberbeveiligingswet (NIS2) is er een module voor het melden van incidenten.',
  },
];

const principes: { titel: string; tekst: string; link?: { href: string; label: string } }[] = [
  { titel: 'Open over de stand van zaken', tekst: 'Over beveiliging, privacy en koppelingen staat in het Trust Centre wat geregeld is, wat in uitvoering is en wat nog niet. Dat is openbaar, niet pas in een aanbesteding.' },
  { titel: 'Uw werkwijze eerst', tekst: 'Wij vragen in een demonstratie naar uw werkstromen, niet naar een lijst eisen. Een systeem dat alles aanvinkt maar niet past, schiet tekort.' },
  { titel: 'Geen overdracht', tekst: 'Wie u spreekt in de aanloop, blijft uw aanspreekpunt na de ingebruikname. Er is geen implementatieteam dat het overneemt.' },
  { titel: 'Modulair', tekst: 'U zet aan wat u nodig hebt, en later bijzetten kan zonder overstap. Geen pakket waarin u zelf moet uitzoeken wat u gebruikt.' },
  { titel: 'Meertalig cliëntportaal', tekst: 'De menu’s en vaste teksten van het cliëntportaal zijn er in vijf talen: Nederlands, Engels, Turks, Arabisch en Duits. Dat is voor cliënten en familie die het portaal liever in hun eigen taal gebruiken.', link: { href: '/kennisbank/meertalig-clientportaal-nl-zorg', label: 'Wat de wet vraagt' } },
  { titel: 'Eén systeem', tekst: 'De backoffice, het medewerkerportaal en het cliëntportaal werken met dezelfde gegevens. Wat de één vastlegt, ziet de volgende terug, zonder koppeling ertussen.', link: { href: '/oplossing', label: 'Alle onderdelen' } },
];

const gesprek = [
  { titel: 'U noemt twee of drie knelpunten', tekst: 'Waar het rapporteren tijd kost, waar de overdracht tussen diensten misgaat, of waar declaraties blijven hangen.' },
  { titel: 'Wij laten zien wat Curanta daarbij doet', tekst: 'Wij laten alleen zien wat bij die knelpunten hoort. En we zeggen erbij wat u nog moet laten aansluiten of instellen.' },
  { titel: 'Samen bepalen we de volgende stap', tekst: `${DEMO_ZELF_AANGEBODEN ? 'Demo-toegang' : 'Een online presentatie'} voor u en uw collega’s, een gesprek over beveiliging en privacy, of een migratie-inschatting.` },
];
---
<Base
  image="/og/over.png"
  title="Over Curanta: wie wij zijn en waarom | Curanta"
  description="Wie achter Curanta staat, waarom, en wat u van ons kunt verwachten: hosting in de EU, een eerlijke stand per onderdeel en één aanspreekpunt."
>
  <PageHero
    eyebrow="Over Curanta"
    title="Wie Curanta bouwt, en waarom."
    subtitle="Jan Maat heeft sinds 2001 een eigen softwarebedrijf. Hij nam het initiatief tot Curanta. Samen met Erwin van der Star, die bijna vijftien jaar Vitaphone Nederland leidde, en Janus Hoeks, die in 1989 Intemo oprichtte, staat hij achter Curanta. Curanta is één systeem voor de zorg, met het cliëntdossier, de planning, de declaratie en de kwaliteit, en portalen voor zorgmedewerkers, cliënten en mantelzorgers."
  />

  {/* Kop links, tekst rechts (15-10-2026): tekst in 16 px zoals de rest van de site, in twee gelijke kolommen zodat de regels rond 75 tekens blijven (besluit Jan 15-10: 18 px was te groot), zoals in PageHero bedoeld, en de
      breedte van de pagina wordt toch gebruikt. Op een smal scherm staat de kop boven de tekst. */}
  <section class="container-prose py-16 space-y-12">
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-16">
      <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Waarom Curanta bestaat</h2>
      <div class="space-y-4 text-ink-700 leading-relaxed">
          <p>
            Zorgmedewerkers besteden 34 procent van hun werktijd aan administratie, en 79 procent van hen ervaart dat
            als belastend (Berenschot, 2025). Dat komt niet doordat zorgverleners onwillig zijn. Het komt doordat hun
            software vaak is ontworpen voor de boekhouder, niet voor de wijkverpleegkundige om 22:00 uur. Intussen groeit
            het tekort aan personeel: van 89.800 mensen in 2026 naar 261.800 in 2035 (ABF Research, AZW, februari 2026).
          </p>
          <p>
            Een zorgorganisatie kiest ongeveer eens in de tien jaar een nieuw ECD (M&amp;I/Partners, januari 2026). Wie nu
            kiest, kiest dus voor de jaren waarin er minder handen zijn voor meer cliënten. Die keuze verdient software
            die tijd teruggeeft. En in die tien jaar verandert er meer dan het aantal collega's.
          </p>
      </div>
    </div>
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-16 border-t border-ink-100 pt-10">
      <h3 class="font-display text-lg font-semibold text-ink-900">De administratie moet omlaag, en AI mag daarbij helpen</h3>
      <div class="space-y-4 text-ink-700 leading-relaxed">
          <p>
            Zorgpartijen en het kabinet hebben afgesproken dat administratie in 2030 hooguit 20 procent van de werktijd
            kost (Aanvullend Zorg- en Welzijnsakkoord, 2025). Ze beginnen met rapporteren door in te spreken, en met het
            plannen van personeel. Van 1 tot en met 31 januari 2027 kan een organisatie in de vvt of de ggz daar
            voor haar Zvw-zorg geld voor aanvragen, de doorbraakmiddelen (modelplannen, september 2026). Wat die
            aanvraag van uw software vraagt, staat in <a href="/kennisbank/doorbraakmiddelen-modelplan-software" class="font-semibold text-curanta-700 hover:underline">de kennisbank</a>.
          </p>
          <p>
            In Curanta doet AI een voorstel, en de zorgmedewerker beslist. Schrijft zij een SOEP-rapportage, dan stelt
            de coach op een knopdruk de E en de P voor. Bij de dienstwissel vat Curanta de overdracht samen. Een zorgplan
            kan Curanta in gewone taal herschrijven, voor de cliënt. Elke aanroep komt in een logboek. In de backoffice kunt u
            ook inspreken, en de tekst ontstaat op het apparaat zelf. Onderweg, in het medewerkerportaal, kan dat nog niet.
          </p>
      </div>
    </div>
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-16 border-t border-ink-100 pt-10">
      <h3 class="font-display text-lg font-semibold text-ink-900">Minder leveranciers, dus meer afhankelijkheid</h3>
      <div class="space-y-4 text-ink-700 leading-relaxed">
          <p>
            Per sector hebben nog ongeveer vijf leveranciers meer dan drie grote klanten. Tien jaar geleden waren dat er
            meer dan tien (M&amp;I/Partners, januari 2026). Het ministerie van VWS schrijft over de "marktmacht van een
            klein aantal ICT-leveranciers". Volgens de ACM kan dat zorg-ICT duurder maken (Kamerbrief, januari 2026).
          </p>
          <p>
            Bij Curanta ziet u daarom vooraf wat het kost. U betaalt €19 tot €39 per actieve medewerker per maand, en dat
            staat op de site. Training en hosting zitten erbij; de implementatie is maatwerk, met een prijs die wij vooraf afspreken. En
            vertrekt u, dan neemt u al uw gegevens en bestanden mee.
          </p>
      </div>
    </div>
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-16 border-t border-ink-100 pt-10">
      <h3 class="font-display text-lg font-semibold text-ink-900">Beveiliging weegt zwaarder dan bij uw vorige keuze</h3>
      <div class="space-y-4 text-ink-700 leading-relaxed">
          <p>
            Sinds 15 augustus 2026 geldt de Cyberbeveiligingswet. Elke zorgaanbieder vanaf 50 fte valt eronder. Het
            bestuur is er zelf verantwoordelijk voor, ook voor de leveranciers die het kiest. Volgens Z-CERT zijn
            ransomware en aanvallen via leveranciers de grootste dreigingen voor de zorg (Cybersecuritybeeld Zorg 2025).
            Wat het bestuur zelf moet vaststellen, staat in
            <a href="/kennisbank/cyberbeveiligingswet-bestuur-zorg" class="font-semibold text-curanta-700 hover:underline">ons artikel over de Cyberbeveiligingswet</a>.
          </p>
          <p>
            In Curanta stelt het bestuur de maatregelen vast en ziet het zijn leveranciers terug in een register, met
            Curanta zelf erin. Wie in de backoffice een zorg- of beheerrol heeft, logt altijd in met tweestapsverificatie. Waar de gegevens van
            uw cliënten staan, leest u verderop. Een externe pentest en de NEN 7510-audit moeten nog plaatsvinden. Wat
            geregeld is en wat niet, staat in het <a href="/trust" class="font-semibold text-curanta-700 hover:underline">Trust Centre</a>.
          </p>
      </div>
    </div>
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-16">
      <div aria-hidden="true"></div>
      <div class="text-ink-700 leading-relaxed">
          <p>
            Wat Curanta per onderdeel doet, staat op de pagina <a href="/oplossing" class="font-semibold text-curanta-700 hover:underline">Product</a>,
            met bij elk onderdeel of het bij uw organisatie nog ingericht moet worden.
          </p>
      </div>
    </div>
  </section>

  <section class="border-y border-ink-100 bg-ink-100/40 py-16">
    <div class="container-prose">
      <div class="grid gap-4 lg:grid-cols-2 lg:gap-16 lg:items-end">
        <div>
          <span class="eyebrow">Wie wij zijn</span>
          <h2 class="mt-2 font-display text-2xl font-bold text-ink-900 sm:text-3xl">De mensen achter Curanta.</h2>
        </div>
        <p class="text-ink-700 leading-relaxed">
          Erwin en Janus kennen de zorg en de techniek als ondernemers. Jan leidt het team dat de software bouwt. U
          spreekt dus rechtstreeks met de mensen die beslissen, niet met een callcenter of een ticketsysteem.
        </p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {mensen.map((m) => (
          <article class="rounded-xl border border-ink-100 bg-white p-6">
            {/* Dezelfde portretten als op sigillum.nl/over (public/images/over, 160 en 320 px). */}
            <img
              src={`/images/over/${m.foto}-160.webp`}
              srcset={`/images/over/${m.foto}-160.webp 160w, /images/over/${m.foto}-320.webp 320w`}
              sizes="88px"
              width="88"
              height="88"
              loading="lazy"
              alt={`Portret van ${m.naam}`}
              class="mb-4 h-[88px] w-[88px] rounded-full object-cover ring-1 ring-ink-100"
            />
            <p class="text-xs font-semibold uppercase tracking-wider text-curanta-700">{m.rol}</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-ink-900">{m.naam}</h3>
            <p class="mt-3 text-sm text-ink-700 leading-relaxed">{m.tekst}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-prose py-16">
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-16 lg:items-end">
      <div>
        <span class="eyebrow">Wat we oplossen</span>
        <h2 class="mt-2 font-display text-2xl font-bold text-ink-900 sm:text-3xl">
          Vier dingen waar een zorgorganisatie het eerst naar vraagt.
        </h2>
      </div>
      <p class="text-ink-700 leading-relaxed">
        Bij een nieuw systeem gaat de eerste vraag zelden over functies. Hij gaat over de gegevens van cliënten, de
        overstap, de tijd van zorgmedewerkers en de regels. Dit doet Curanta daarmee.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {themas.map((t) => (
        <article class="rounded-xl border border-ink-100 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-curanta-700">{t.eyebrow}</p>
          <h3 class="mt-2 font-display text-lg font-semibold text-ink-900">{t.titel}</h3>
          <p class="mt-2 text-sm text-ink-700 leading-relaxed">{t.tekst}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-ink-100 bg-ink-100/40 py-16">
    <div class="container-prose">
      <span class="eyebrow">Wat u van ons kunt verwachten</span>
      <h2 class="mt-2 font-display text-2xl font-bold text-ink-900 sm:text-3xl">Onze principes</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {principes.map((p) => (
          <article class="rounded-xl border border-ink-100 bg-white p-6">
            <h3 class="font-display text-lg font-semibold text-ink-900">{p.titel}</h3>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{p.tekst}</p>
            {p.link && (
              <a href={p.link.href} class="mt-3 inline-block text-sm font-semibold text-curanta-700 hover:underline">
                {p.link.label} →
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-prose py-16">
    <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">Zo gaat een eerste gesprek.</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {gesprek.map((s, i) => (
        <li class="rounded-xl border border-ink-100 bg-white p-6">
          <span class="font-display text-sm font-semibold text-curanta-700">Stap {i + 1}</span>
          <h3 class="mt-2 font-display text-lg font-semibold text-ink-900">{s.titel}</h3>
          <p class="mt-2 text-sm text-ink-700 leading-relaxed">{s.tekst}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-prose pb-16">
    <div class="rounded-2xl border border-ink-100 bg-white p-8">
      <h2 class="font-display text-2xl font-bold text-ink-900">Bedrijfsgegevens</h2>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Handelsnaam</dt>
          <dd class="mt-1 text-ink-900">Curanta</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">KvK-nummer</dt>
          <dd class="mt-1 text-ink-900">09147820</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Vestiging</dt>
          <dd class="mt-1 text-ink-900">Marshallstraat 26, 5705 CN Helmond, Nederland</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Telefoon</dt>
          <dd class="mt-1"><a href="tel:+31852501301" class="text-curanta-700 hover:underline">085 250 1301</a></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Algemeen contact</dt>
          <dd class="mt-1"><a href="mailto:info@curanta.nl" class="text-curanta-700 hover:underline">info@curanta.nl</a></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Privacy</dt>
          <dd class="mt-1"><a href="mailto:privacy@curanta.nl" class="text-curanta-700 hover:underline">privacy@curanta.nl</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <Cta />
</Base>
