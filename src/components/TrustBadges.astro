---
// Status-stoplichten zijn bewust eerlijk: groen = aantoonbaar, geel = in
// uitvoering, grijs = gepland. Dit is het centrale differentiërende element
// t.o.v. concurrenten die compliance pas in tender-fase delen.
import { NIS2CARE_LIVE, NIS2CARE_URL } from '../config/features';

const badges: Array<{ label: string; status: string; note: string; url?: string; urlLabel?: string }> = [
  { label: 'NEN 7510', status: 'wip', note: 'Werkdocument, externe audit gepland Q4 2026' },
  { label: 'AVG', status: 'wip', note: 'BSN versleuteld; een FG en versleuteling van de hele database vóór de eerste klant' },
  { label: 'ISO 27001', status: 'roadmap', note: 'Audit gepland 2027' },
  { label: 'FHIR R4', status: 'wip', note: 'BgZ intern in FHIR R4; publieke API in ontwikkeling' },
  { label: 'MedMij', status: 'wip', note: 'In ontwikkeling' },
  { label: 'Wegiz', status: 'wip', note: 'BgZ-bundel intern gebouwd, aansluiting in ontwikkeling' },
  {
    label: 'Cbw (NIS2)',
    status: 'wip',
    note: 'NIS2-incidentmodule in Curanta: meldtermijnen 24 uur, 72 uur en één maand',
    url: NIS2CARE_LIVE ? NIS2CARE_URL : undefined,
    urlLabel: 'nis2care.nl',
  },
  { label: 'Hosting in de EU', status: 'live', note: 'IONOS Cloud, Berlijn (Duitsland)' },
];

const dot = (s: string) =>
  s === 'live' ? 'bg-green-500' : s === 'wip' ? 'bg-amber-500' : 'bg-ink-300';
---
<section class="border-y border-ink-100 bg-ink-100/40 py-14">
  <div class="container-prose">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="font-display text-2xl font-bold text-ink-900">Beveiliging en privacy: de stand per onderwerp.</h2>
        <p class="mt-2 text-sm text-ink-700 max-w-2xl">
          Eerlijke status per wet en norm, zonder NDA. In het Trust Centre staat de onderbouwing per onderwerp.
        </p>
      </div>
      <a href="/trust" class="text-sm font-medium text-curanta-700 no-underline hover:underline whitespace-nowrap">
        Volledig Trust Centre →
      </a>
    </div>
    <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {badges.map((b) => (
        <li class="flex items-start gap-3 rounded-lg border border-ink-100 bg-white p-4">
          <span class={`status-dot mt-1.5 ${dot(b.status)}`}></span>
          <div class="flex-1">
            <div class="text-sm font-semibold text-ink-900">{b.label}</div>
            <div class="mt-0.5 text-xs text-ink-500">{b.note}</div>
            {b.url && (
              <a href={b.url} target="_blank" rel="noopener" class="mt-1.5 inline-block text-[11px] font-bold text-curanta-700 no-underline hover:underline">
                {b.urlLabel ?? b.url} ↗
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-xs text-ink-500">
      <span class="status-dot bg-green-500"></span> aantoonbaar nu  ·
      <span class="status-dot bg-amber-500 ml-2"></span> in uitvoering  ·
      <span class="status-dot bg-ink-300 ml-2"></span> gepland
    </p>
  </div>
</section>
