---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ModuleCard from '../components/ModuleCard.astro';
import Screenshot from '../components/Screenshot.astro';
import StatusLegenda from '../components/StatusLegenda.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Cta from '../components/Cta.astro';
import { DEMO_ZELF_AANGEBODEN, DEMO_ZELF, DEMO_GESPREK, PRESENTATIE } from '../config/demo';
import { groups } from '../config/onderdelen';

// Modulekaart, gegroepeerd zoals de backoffice. Herzien 08-10-2026:
// - vier statussen uit src/config/status.ts (gelijk aan homepage, /integraties en /trust);
// - per groep een korte samenvatting en wie ermee werkt, en een inhoudsopgave bovenaan;
// - echte schermen uit de demo in plaats van de voorbeeldcomposities (ProductMockups);
// - feiten bijgewerkt naar het feitenblad: publieke FHIR BgZ-document-API gebouwd, Nmbrs-koppeling
//   gebouwd, Zvw-berichtlaag gebouwd maar niet bewezen bij Vecozo, medicatiegebruik ook zonder
//   Medimo, Wtta-overgangsjaar 2027 (toelatinguitleenmarkt.nl, 08-10-2026).
// "In de demo" is nagelopen in de code: alle modules staan aan in de demo-organisatie, de
// koppelingen met externe partijen niet (die vragen certificaten of contracten).
// 15-10-2026 (besluit Jan, gelijk aan /integraties): iWmo/iJw en iWlz getoetst aan de XSD en met de
// hand aangeleverd (iWlz: route per zorgkantoor); Zvw AW319 naar "inrichten"; eOverdracht-document
// gebouwd en te downloaden, verzenden niet.

// De onderdelen zelf staan sinds 21-10-2026 in src/config/onderdelen.ts (ook gebruikt door de homepage).

const AI_TOELICHTING = 'Vragen aan een taalmodel gaan gepseudonimiseerd via één centraal punt, standaard naar Mistral AI via het EU-endpoint. Mistral bewaart de gegevens niet en traint er niet mee. Uw organisatie kan ook Anthropic (VS) kiezen, of AI in één keer uitzetten.';
---
<Base
  title="Product: alle onderdelen van Curanta | Curanta"
  description={`De onderdelen van Curanta per groep, van dossier en planning tot declaratie, kwaliteit en HRM: wat elk onderdeel doet en wat u ervoor nodig hebt.`}
  image="/og/oplossing.png"
>
  <PageHero
    eyebrow="Product"
    title="Alle onderdelen van Curanta"
    subtitle="Curanta is één systeem met losse onderdelen. U zet aan wat u gebruikt, en alleen dat ziet u in het menu. Alle onderdelen werken met hetzelfde dossier. Per onderdeel ziet u wat het doet, en of het bij uw organisatie nog ingericht moet worden."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href={PRESENTATIE.href} class="btn-primary no-underline">{PRESENTATIE.label}</a>
      <a href={DEMO_GESPREK.href} class="btn-secondary no-underline">{DEMO_GESPREK.label}</a>
      {DEMO_ZELF_AANGEBODEN && <a href={DEMO_ZELF.href} class="btn-secondary no-underline">{DEMO_ZELF.label}</a>}
    </div>
  </PageHero>

  <section class="border-b border-ink-200 bg-white py-10">
    <div class="container-prose grid gap-10 lg:grid-cols-12">
      <nav class="lg:col-span-5" aria-labelledby="inhoud-kop">
        <h2 id="inhoud-kop" class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">Inhoud</h2>
        <ol class="mt-3 grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
          {groups.map((g) => (
            <li>
              <a href={`#${g.id}`} class="font-semibold text-curanta-700 no-underline hover:underline">{g.group}</a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="lg:col-span-7">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">Wat de status betekent</h2>
        <StatusLegenda class="mt-3" />
      </div>
    </div>
  </section>

  {groups.map((g, i) => (
    <section id={g.id} class={`scroll-mt-20 py-14 sm:py-16 ${i % 2 === 1 ? 'bg-curanta-50' : ''}`} aria-labelledby={`${g.id}-kop`}>
      <div class="container-prose">
        <div class={`grid gap-8 ${g.beeld ? 'lg:grid-cols-12 lg:items-start' : ''}`}>
          <div class={g.beeld ? 'lg:col-span-5' : 'max-w-3xl'}>
            <h2 id={`${g.id}-kop`} class="font-display text-2xl font-bold text-curanta-900 sm:text-3xl">{g.group}</h2>
            <p class="mt-3 text-lg leading-relaxed text-ink-700">{g.kort}</p>
            <p class="mt-3 text-sm text-ink-700"><span class="font-semibold text-ink-900">Wie werkt ermee:</span> {g.wie}</p>
            {g.id === 'ai' && <p class="mt-3 text-sm text-ink-700">{AI_TOELICHTING}</p>}
          </div>
          {g.beeld && (
            <Screenshot
              class="lg:col-span-7"
              src={g.beeld.src}
              alt={g.beeld.alt}
              adres={g.beeld.adres}
              bijschrift={g.beeld.bijschrift}
              sizes="(min-width: 1400px) 760px, (min-width: 1024px) 56vw, 100vw"
            />
          )}
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {g.modules.map((m) => (
            <ModuleCard title={m.title} body={m.body} features={m.features} status={m.status} noot={m.noot} />
          ))}
        </div>
        <p class="mt-6 text-right text-sm"><a href="#inhoud-kop" class="text-curanta-700">Terug naar de inhoud</a></p>
      </div>
    </section>
  ))}

  <RelatedArticles
    intro="Achtergrond bij het meertalige cliëntportaal en het collega-netwerk: wat de wet en het onderzoek erover zeggen, met bronnen."
    articles={[
      {
        eyebrow: 'Cliëntportaal',
        title: 'Een cliëntportaal in de taal van de cliënt: wat de wet vraagt, en wat niet',
        body: 'Begrijpelijke informatie en inzage volgens Wgbo, Wkkgz, AVG en Wabvpz, en CBS-cijfers over oudere migranten.',
        href: '/kennisbank/meertalig-clientportaal-nl-zorg',
      },
      {
        eyebrow: 'Medewerkers',
        title: 'Peer-support voor zorgmedewerkers: wat het onderzoek zegt, en wat niet',
        body: 'Het onderzoek, de AZW-cijfers en de privacyregels op een rij, met de vragen voor HR en FG.',
        href: '/kennisbank/peer-support-zorgmedewerkers',
      },
    ]}
  />

  <Cta />
</Base>
