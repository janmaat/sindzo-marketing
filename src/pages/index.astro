      {
        src: portaalZorgplan,
        alt: 'Cliëntportaal: het zorgplan van een cliënt, met een samenvatting in gewone taal en de zorgproblemen met wat het zorgteam doet.',
        adres: 'klant.curanta.nl',
        bijschrift: 'Cliëntportaal: het zorgplan zoals de cliënt en de mantelzorger het zien. De samenvatting schrijft of controleert de zorgverlener. Opname oktober 2026.',
