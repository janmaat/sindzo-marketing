import SegmentLayout from '../../layouts/SegmentLayout.astro';
---
<SegmentLayout
  image="/og/voor-vvt.png"
  segmentKey="vvt"
  segmentLabel="VVT"
  title="VVT-software — verpleging, verzorging, thuiszorg | Curanta"
  description="VVT-software voor verpleeghuis en wijkverpleging: dossier, zorgplan, planning, declaratie en medewerkerportaal in één systeem. Cliëntportaal in 5 talen."
  eyebrow="Voor VVT-organisaties"
  hero="Eén systeem voor de wijkverpleging en het verpleeghuis"
  subtitle="Dossier, planning, medewerkerportaal en declaratie in één systeem. De zorgmedewerker ziet bezoeken, taken en het zorgplan op de telefoon en rapporteert daar; planner en administratie werken met dezelfde gegevens. Declareren bij zorgverzekeraars (Zvw) is in ontwikkeling."
  triggers={[
    { title: 'Arbeidsmarktkrapte', body: 'Het tekort aan zorgpersoneel blijft groeien (ABF/AZW: van 89.800 in 2026 naar 261.800 in 2035). Curanta zet het werk van de dag op de telefoon van de zorgmedewerker: bezoeken, taken, rapportage en uren.' },
    { title: 'Verpleeghuis en wijk los van elkaar', body: 'Eén dossier voor verpleeghuis én wijk. Eén cliënt, één rapportage — ongeacht waar de zorg geleverd wordt.' },
    { title: 'Regeldruk via het ECD', body: 'Berenschot voor VWS (meting 2025): 34% van de werktijd gaat naar administratie, terwijl zorgprofessionals zelf 23% acceptabel vinden. Curanta helpt met taken uit het zorgplan bij elk bezoek, metingen die al in de rapportage staan en, als u dat wilt, een voorstel voor de evaluatie dat de zorgverlener naleest.' },
    { title: 'eOverdracht & Wegiz', body: 'Overdracht naar ziekenhuis, huisarts of vervolgzorg via de BgZ in plaats van printen en faxen. Curanta vult 11 van de 14 onderdelen van de Minimale eOverdracht uit het dossier; het eOverdracht-document en het verzenden zijn in ontwikkeling.' },
    { title: 'Cliënten die Nederlands niet als eerste taal hebben', body: 'Veel oudere cliënten en hun familie lezen formele teksten beter in hun eigen taal. De menu’s en vaste teksten van het cliëntportaal zijn er in vijf talen: Nederlands, Engels, Turks, Arabisch en Duits. Hoe andere leveranciers dat doen, staat met bronnen op de vergelijkingspagina.' },
  ]}
  modules={[
    { name: 'Medewerkerportaal', note: 'Rooster, bezoeken met SOEP-rapportage, uren en verlof op de telefoon — €19 per zorgmedewerker' },
    { name: 'Cliëntdossier + zorgplan', note: 'Omaha-zorgplan, BSN versleuteld' },
    { name: 'SOEP-rapportage', note: 'Coach-voorstel; spraakinvoer in de backoffice' },
    { name: 'Zelfrooster', note: 'Medewerkers kiezen eigen diensten binnen CAO-kaders' },
    { name: 'Tijdregistratie', note: 'Uren bevestigen in het medewerkerportaal, ook zonder verbinding' },
    { name: 'Routeplanning', note: 'Wijkroutes met reistijd en voorkeursmedewerker per cliënt' },
    { name: 'Cao-controle', note: 'Rusttijden, pauzes en maximale diensten, met signalen vóór publicatie' },
    { name: 'eOverdracht', note: 'In ontwikkeling: document en verzenden' },
    { name: 'Medicatie', note: 'Toedienlijst; overzicht uit Medimo of uit de eigen registratie' },
    { name: 'iWmo, productie en budget', note: 'Toewijzing, productie en budget; de maanddeclaratie is in ontwikkeling' },
    { name: 'Cliëntportaal', note: 'Voor cliënten en mantelzorgers: taken, foto\'s, berichten; in 5 talen' },
    { name: 'Collega-netwerk (welzijn)', note: 'Buddy of intervisiepartner — strikt gescheiden van HR' },
  ]}
