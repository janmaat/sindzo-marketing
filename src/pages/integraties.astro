---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import StatusLabel from '../components/StatusLabel.astro';
import StatusLegenda from '../components/StatusLegenda.astro';
import { STATUS, STATUS_VOLGORDE, type Status } from '../config/status';

interface Integration {
  name: string;
  category: string;
  body: string;
  status: Status;
  doc?: string;
}

// Herzien 08-10-2026 naar het feitenblad: vier statussen (src/config/status.ts). "Gebouwd, in te
// richten per klant" betekent dat de koppeling er is, maar pas werkt met een certificaat, contract
// of toegang van uw organisatie bij de andere partij. In de demo zijn deze koppelingen niet live
// (nagelopen in de code: buiten Development geen stub, zonder certificaat "niet gekoppeld").
const integrations: Integration[] = [
  // Standaarden
  { name: 'FHIR R4 en de BgZ', category: 'Standaarden', status: 'inrichten', doc: '/api',
    body: 'Een publieke, read-only FHIR R4-API die de Basisgegevensset Zorg (BgZ) van een cliënt als document levert, gevalideerd tegen de profielen van Nictiz. Beschikbaar na registratie van het systeem dat de gegevens ophaalt. Geen testomgeving en geen algemene lees- of schrijftoegang.' },
  { name: 'Wegiz / eOverdracht', category: 'Standaarden', status: 'ontwikkeling',
    body: 'Curanta vult 11 van de 14 onderdelen van de Minimale eOverdracht uit het dossier. Het volledige eOverdracht-document (STU3), de kwalificatie en het verzenden zijn nog niet gebouwd.' },
  { name: 'MedMij', category: 'Standaarden', status: 'ontwikkeling',
    body: 'Uitwisseling met een persoonlijke gezondheidsomgeving vraagt registratie bij Stichting MedMij, een PKIoverheid-certificaat en een conformiteitstest; die zijn er nog niet.' },
  { name: 'LSP (VZVZ)', category: 'Standaarden', status: 'ontwikkeling',
    body: 'Bevragen via het Landelijk Schakelpunt, met toestemming per cliënt. Aansluiten vraagt een VZVZ-aansluittraject en UZI-certificaten; die zijn er nog niet.' },

  // Communicatie
  { name: 'ZorgMail', category: 'Communicatie', status: 'inrichten',
    body: 'Beveiligde berichten en bijlagen via het ZorgMail-netwerk. Vraagt een ZorgMail-abonnement van uw organisatie.' },
  { name: 'ZorgDomein', category: 'Communicatie', status: 'inrichten',
    body: 'Inkomende verwijzingen met bijlagen via ZorgDomein. Antwoorden vanuit Curanta is in ontwikkeling.' },

  // Medicatie
  { name: 'Medimo', category: 'Medicatie', status: 'inrichten',
    body: 'Medicatieoverzicht, voorschriften, toedienregistratie en allergieën. Zonder Medimo legt u het medicatiegebruik in het dossier zelf vast (naam en ATC-code).' },

  // Financieel
  { name: 'Gemeenten (iWmo en iJw)', category: 'Financieel', status: 'inrichten',
    body: 'Toewijzingen, berichten en de maanddeclaratie (Wmo323, Jw323) via Vecozo, met het Vecozo-certificaat van uw organisatie. Retourberichten leest u nu zelf in; automatisch ophalen is in ontwikkeling.' },
  { name: 'Zorgkantoren (iWlz)', category: 'Financieel', status: 'inrichten',
    body: 'iWlz-berichten via Vecozo, met validatie. Retourberichten leest u nu zelf in; automatisch ophalen is in ontwikkeling.' },
  { name: 'CAK', category: 'Financieel', status: 'inrichten',
    body: 'De aanlevering voor de eigen bijdrage (Wlz en Wmo) via Vecozo. Retourberichten leest u nu zelf in.' },
  { name: 'Controle op verzekering (COV)', category: 'Financieel', status: 'inrichten',
    body: 'Via Vecozo, per cliënt of voor alle cliënten tegelijk; de uitkomst wordt vastgelegd. Werkt zodra er een Vecozo-certificaat is.' },
  { name: 'AGB-register (Vektis)', category: 'Financieel', status: 'inrichten',
    body: 'AGB-codes valideren en dagelijks synchroniseren met de open dataset van Vektis. De synchronisatie richten wij per klant in.' },
  { name: 'Zorgverzekeraars (GGZ, GDS801)', category: 'Financieel', status: 'inrichten',
    body: 'GGZ-declaraties volgens de standaard van Vektis, vóór verzending getoetst aan het schema, via de berichtenbox van Vecozo. Vraagt een Vecozo-certificaat; een test bij Vecozo is nog niet gedaan. Het retourbericht (GDS802) haalt u zelf op en leest u in.' },
  { name: 'Zorgverzekeraars (Zvw)', category: 'Financieel', status: 'ontwikkeling',
    body: 'Zvw-declaratie voor de wijkverpleging. De berichten (AW319 en AW320) worden opgesteld en verwerkt, maar de test bij Vecozo en het versturen zijn nog niet bewezen. Aanleveren kan nog niet.' },

  // Sensoren en domotica
  { name: 'Domotica', category: 'Sensoren en domotica', status: 'inrichten',
    body: 'Alarmen en sensormeldingen van onder meer Mextal, Ascom, Sensara, CLB en CarePhone in een eigen overzicht, met een melding aan de dienstdoende zorg. Aansluiting per leverancier.' },

  // E-health
  { name: 'E-healthaanbieders', category: 'E-health', status: 'gepland',
    body: 'Koppelingen voor blended zorg. Vragen een overeenkomst en API-toegang per aanbieder; die zijn er nog niet.' },

  // Identiteit
  { name: 'DigiD', category: 'Identiteit', status: 'inrichten',
    body: 'Inloggen op het cliëntportaal met DigiD, minimaal niveau Substantieel. Een betaalde optie; de aansluiting bij Logius regelen wij per klant.' },
  { name: 'UZI-pas', category: 'Identiteit', status: 'inrichten',
    body: 'Curanta leest de pas uit en controleert de certificaatketen en of de pas is ingetrokken. Beschikbaar zodra de UZI-hostnaam op onze server is ingericht; dat is nog niet gebeurd. De eindtest met een echte pas doen wij bij de eerste klant.' },
  { name: 'Microsoft Entra ID (SSO)', category: 'Identiteit', status: 'ontwikkeling',
    body: 'Inloggen met het account van uw organisatie, met rollen uit groepen. De instellingen zijn er; inloggen via SSO nog niet.' },

  // Klinisch
  { name: 'Ysis (Gerimedica)', category: 'Klinisch', status: 'ontwikkeling',
    body: 'Uitwisseling van het dossier met Ysis. Geen import: overstappen uit Ysis is een migratieproject.' },

  // Backoffice
  { name: 'DocuSign', category: 'Backoffice', status: 'inrichten',
    body: 'Digitaal ondertekenen van HR-documenten in het personeelsdossier. Vraagt een DocuSign-account van uw organisatie; DocuSign verwerkt de gegevens in de VS.' },
  { name: 'Mollie (betaallink voor cliënten)', category: 'Backoffice', status: 'inrichten',
    body: 'Een betaallink op de factuur; de cliënt betaalt op het eigen Mollie-account van uw organisatie. Vraagt een Mollie-account van uw organisatie. Nog niet te gebruiken: de aanmelding van Curanta bij Mollie is nog niet rond.' },
  { name: 'Boekhoudpakketten', category: 'Backoffice', status: 'demo',
    body: 'Geen koppeling maar een bestand: verkoopboekingen, toegekende declaraties en kosten voor Twinfield, SnelStart, AFAS, Exact (journaalposten) of Yuki. U leest het zelf in. Het Yuki-bestand is nog niet in een echte Yuki-administratie ingelezen.' },
  { name: 'Nmbrs', category: 'Backoffice', status: 'inrichten',
    body: 'De goedgekeurde salarisexport rechtstreeks naar Nmbrs. Vraagt een Nmbrs-partnerapp, een sleutel en toestemming van uw organisatie; de test met Nmbrs doen wij bij de eerste klant. Zonder Nmbrs: een CSV-export voor elke salarisadministratie.' },
];

const categories = Array.from(new Set(integrations.map(i => i.category)));
const telling = (s: Status) => integrations.filter(i => i.status === s).length;
---
<Base
  image="/og/integraties.png"
  title="Koppelingen: Vecozo, ZorgMail, ZorgDomein, Medimo | Curanta"
  description="Koppelingen van Curanta met Vecozo, ZorgMail, ZorgDomein, Medimo, DigiD en meer: per koppeling of hij gebouwd is en wat er nodig is om aan te sluiten."
>
  <PageHero
    eyebrow="Koppelingen en standaarden"
    title="Koppelingen: wat er is en wat u nodig hebt om aan te sluiten"
    subtitle="Een gebouwde koppeling werkt pas als uw organisatie is aangesloten bij de andere partij, met een certificaat, contract of toegang. Dat regelen wij samen bij de implementatie. De gebouwde koppelingen zitten in het abonnement; wat de andere partij rekent, zoals een Vecozo-certificaat of ZorgMail-abonnement, betaalt u zelf."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="/api" class="btn-primary no-underline">Over de FHIR-API</a>
      <a href="/trust" class="btn-secondary no-underline">Trust Centre</a>
    </div>
  </PageHero>

  <section class="border-b border-ink-200 bg-curanta-50 py-10">
    <div class="container-prose grid gap-8 lg:grid-cols-12">
      <ul class="grid grid-cols-3 gap-3 self-start lg:col-span-5" aria-label="Aantal koppelingen per status">
        {STATUS_VOLGORDE.filter((k) => k !== 'demo').map((k) => (
          <li class="rounded-xl bg-white p-4 ring-1 ring-ink-200">
            <div class="font-display text-3xl font-bold text-curanta-900">{telling(k)}</div>
            <div class="mt-1 text-xs text-ink-700">{STATUS[k].label}</div>
          </li>
        ))}
      </ul>
      <div class="lg:col-span-7">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">Wat de status betekent</h2>
        <StatusLegenda class="mt-3" />
      </div>
    </div>
  </section>

  {categories.map((cat) => (
    <section class="container-prose py-12 border-b border-ink-100 last:border-0">
      <h2 class="font-display text-2xl font-bold text-ink-900">{cat}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {integrations.filter(i => i.category === cat).map((i) => (
          <article class="rounded-lg border border-ink-100 bg-white p-5">
            <div class="flex flex-col gap-1">
              <h3 class="font-display text-base font-semibold text-ink-900">{i.name}</h3>
              <StatusLabel status={i.status} />
            </div>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{i.body}</p>
            {i.doc && (
              <a href={i.doc} class="mt-3 inline-block text-xs font-medium text-curanta-700 no-underline hover:underline">
                Over de FHIR-API →
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="container-prose py-16">
    <div class="rounded-2xl border border-ink-100 bg-ink-100/50 p-8">
      <h2 class="font-display text-2xl font-bold text-ink-900">Mist u een koppeling?</h2>
      <p class="mt-3 max-w-2xl text-ink-700">
        Laat het ons weten. Wij bekijken of hij past in de opbouw van Curanta en in uw zorgproces,
        en wij reageren binnen 1 werkdag.
      </p>
      <a href="mailto:info@curanta.nl?subject=Koppeling" class="btn-primary mt-5 no-underline">Mail info@curanta.nl</a>
    </div>
  </section>

  <Cta />
</Base>
