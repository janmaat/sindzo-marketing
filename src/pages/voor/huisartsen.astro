    { name: 'eOverdracht (BgZ)', note: 'BgZ intern gebouwd, aansluiting in ontwikkeling' },
    { name: 'LSP-koppeling', note: 'In ontwikkeling' },
  ]}
  regulatory={['Wegiz', 'AVG', 'NEN 7510']}
