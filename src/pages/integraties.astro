---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import StatusLabel from '../components/StatusLabel.astro';
import StatusLegenda from '../components/StatusLegenda.astro';
import { STATUS, STATUS_VOLGORDE, type Status } from '../config/status';

interface Integration {
  name: string;
  category: string;
  body: string;
  status: Status;
  doc?: string;
}

// Herzien 08-10-2026 naar het feitenblad: vier statussen (src/config/status.ts). "Gebouwd, in te
// richten per klant" betekent dat de koppeling er is, maar pas werkt met een certificaat, contract
// of toegang van uw organisatie bij de andere partij. In de demo zijn deze koppelingen niet live
// (nagelopen in de code: buiten Development geen stub, zonder certificaat "niet gekoppeld").
//
// Herzien 15-10-2026 (besluit Jan, claimtoets tegen Ponscura-koppel, feitenblad 5b8013fcd):
// - iWmo/iJw, iWlz, Zvw en de CAK-kaart van "ontwikkeling" naar "inrichten": de berichten zijn gebouwd,
//   worden getoetst (iStandaarden aan de XSD, AW319 aan recordlayout en testset van Vektis) en u levert
//   ze met de hand aan. Rechtstreeks versturen via VECOZO is niet beproefd en staat standaard uit.
// - iWlz: hoe het zorgkantoor ontvangt is een open vraag aan VECOZO; de route stemmen wij per
//   zorgkantoor af bij de start.
// - eOverdracht sinds 22-10-2026 "inrichten": het transport (Nictiz-workflow, Twiin-notificatie, Nuts v6) staat op
//   productie (aa4aa4436), getest tussen twee Nuts-nodes; aansluiting op een netwerk, ketentest en Nictiz-kwalificatie
//   per klant (ADR 2026-10-22-eoverdracht-transport in de Ponscura-repo).
// - Entra ID blijft "ontwikkeling" tot Jans eindtest met een echte tenant (deploy/SSO-ENTRA-TESTEN.md).
// - SIEM "inrichten" sinds 19-10-2026: eindtest geslaagd tegen een echte Splunk, Azure Monitor en syslog-server
//   (deploy/SIEM-TESTEN.md, ADR 2026-10-17-siem-doorsturen). De webhook is alleen tegen een eigen ontvanger
//   getest; noem hem daarom niet als getest.
const integrations: Integration[] = [
  { name: 'Uw SIEM (auditlogs)', category: 'Beveiliging', status: 'inrichten',
    body: 'Elke minuut het beveiligingslogboek en de beheeraudit naar het SIEM van uw organisatie: via een webhook (JSON of CEF), Splunk HEC, Azure Monitor (Logs Ingestion API) of syslog over TLS. Het NEN 7513-toegangslogboek alleen als u dat aanzet, gepseudonimiseerd. Getest met Splunk, Azure Monitor en een syslog-server. U richt de koppeling in op het beheerscherm, met de gegevens van uw SIEM.' },
  // Standaarden
  { name: 'FHIR R4 en de BgZ', category: 'Standaarden', status: 'inrichten', doc: '/api',
    body: 'Een publieke FHIR R4-API, alleen om te lezen. Hij levert de Basisgegevensset Zorg (BgZ) van een cliënt als document, gevalideerd tegen de profielen van Nictiz. Beschikbaar zodra wij het systeem dat de gegevens ophaalt, hebben geregistreerd. Geen testomgeving en geen algemene lees- of schrijftoegang.' },
  { name: 'Wegiz / eOverdracht', category: 'Standaarden', status: 'inrichten',
    body: 'Curanta maakt het overdrachtsdocument volgens eOverdracht 4.0, met alle 14 onderdelen van de Minimale eOverdracht, voor zover ze in het dossier staan, en biedt het aan via het eOverdracht-netwerk: de ontvangende organisatie haalt het op en meldt terug of zij de overdracht accepteert. Een binnengekomen overdracht beoordeelt een zorgverlener voordat er iets in het dossier komt. De aansluiting op het netwerk regelen wij bij de implementatie, met het UZI-servercertificaat van uw organisatie; de ketentest met uw ketenpartner hoort daarbij. Getest tussen twee omgevingen, niet door Nictiz gekwalificeerd. Downloaden en zelf meesturen kan ook.' },
  { name: 'MedMij', category: 'Standaarden', status: 'ontwikkeling',
    body: 'Uitwisselen met een persoonlijke gezondheidsomgeving vraagt registratie bij Stichting MedMij, een PKIoverheid-certificaat en een conformiteitstest. Die zijn er nog niet.' },
  { name: 'LSP (VZVZ)', category: 'Standaarden', status: 'ontwikkeling',
    body: 'Bevragen via het Landelijk Schakelpunt, met toestemming per cliënt. Aansluiten vraagt een VZVZ-aansluittraject en UZI-certificaten; die zijn er nog niet.' },

  // Communicatie
  { name: 'ZorgMail', category: 'Communicatie', status: 'inrichten',
    body: 'Beveiligde berichten en bijlagen via het ZorgMail-netwerk. Vraagt een ZorgMail-abonnement van uw organisatie.' },
  { name: 'ZorgDomein', category: 'Communicatie', status: 'inrichten',
    body: 'Inkomende verwijzingen met bijlagen via ZorgDomein. Antwoorden vanuit Curanta is in ontwikkeling.' },

  // Medicatie
  { name: 'Medimo', category: 'Medicatie', status: 'inrichten',
    body: 'Medicatieoverzicht, voorschriften, toedienregistratie en allergieën. Zonder Medimo legt u het medicatiegebruik in het dossier zelf vast (naam en ATC-code).' },

  // Financieel
  // 15-10-2026, claimtoets: iWmo/iJw 3.2 en iWlz 2.4.3 worden verplicht getoetst aan de officiële XSD's
  // (Istandaard32Opsteller.cs, Istandaard32Xsd.cs, Iwlz243.cs). Aanleveren gaat standaard met de hand
  // (IstandaardAanleverwijze.cs): iWmo/iJw in het VECOZO-portaal, iWlz bij het zorgkantoor. Rechtstreeks
  // versturen is nooit tegen VECOZO beproefd. Daarom "inrichten" (besluit Jan 15-10-2026). De toezegging
  // "vóór uw eerste declaratiemaand" van 14-10 is vervallen: wat er nu staat, is gebouwd.
  { name: 'Gemeenten (iWmo en iJw)', category: 'Financieel', status: 'inrichten',
    body: 'Curanta stelt de berichten op volgens iStandaard 3.2: start en stop van de zorg, verzoeken om toewijzing of wijziging en de maanddeclaratie (Wmo323, Jw323) uit goedgekeurde productie. Elk bericht wordt getoetst aan het officiële schema. U downloadt het en levert het aan in het VECOZO-portaal. Antwoorden van de gemeente leest u in, als bestand of geplakt. Rechtstreeks versturen vanuit Curanta volgt.' },
  { name: 'Zorgkantoren (iWlz)', category: 'Financieel', status: 'inrichten',
    body: 'Curanta stelt de iWlz-berichten op volgens iStandaard 2.4.3, zoals de melding van begin en einde van de zorg, en leest de berichten van het zorgkantoor in. Ze worden getoetst aan het officiële schema. De maanddeclaratie maakt Curanta als Vektis-bericht (AW319) uit goedgekeurde productie. U downloadt de bestanden en levert ze aan bij het zorgkantoor. Hoe dat gaat, stemmen wij bij de start per zorgkantoor af: of het VECOZO-portaal iWlz-bestanden en een Wlz-declaratie (AW319) aanneemt, is een open vraag aan VECOZO.' },
  // 14-10-2026: een zorgaanbieder levert niets rechtstreeks aan het CAK. Bij de Wlz geeft het zorgkantoor de start
  // en wijziging van de zorg door (iWlz AW35/AW39 van de aanbieder, CA317/CA319 naar het CAK), bij de Wmo de gemeente
  // (iEb). Bron: istandaarden.nl, iWlz 2.4.3 en iEb 4.0.
  // 15-10-2026: kaart blijft (besluit Jan), status gelijk aan iWlz. De CAK-module is verwijderd; de meldingen
  // begin/einde zijn WMO305/307 (Istandaard32Opsteller.cs) en AW35/AW39 (Iwlz243.cs).
  { name: 'Eigen bijdrage (CAK)', category: 'Financieel', status: 'inrichten',
    body: 'U levert niets aan het CAK. Het CAK krijgt zijn gegevens van het zorgkantoor (Wlz) en de gemeente (Wmo), op basis van uw meldingen over het begin en het einde van de zorg. Die meldingen stelt u op in Curanta.' },
  { name: 'Controle op verzekering (COV)', category: 'Financieel', status: 'inrichten',
    body: 'Curanta legt per cliënt vast bij welke verzekeraar hij verzekerd is, en waar dat vandaan komt. U neemt het over van de zorgpas of uit de COV-controle in het VECOZO-portaal. De automatische vraag aan VECOZO ronden wij af bij uw aansluiting.' },
  { name: 'AGB-register (Vektis)', category: 'Financieel', status: 'inrichten',
    body: 'AGB-codes valideren en dagelijks synchroniseren met de open dataset van Vektis. De synchronisatie richten wij per klant in.' },
  // 14-10-2026: het bericht wordt getoetst aan de officiële XSD van Vektis en de handmatige aanlevering via het
  // VECOZO-portaal is gebouwd (Ponscura c5d17a29b). Rechtstreeks versturen vanuit Curanta is nog niet beproefd.
  { name: 'Zorgverzekeraars (GGZ, GDS801)', category: 'Financieel', status: 'inrichten',
    body: 'GGZ-declaraties volgens de standaard van Vektis. Curanta maakt het bericht en toetst het aan het officiële schema. U levert het aan in het VECOZO-portaal, met het VECOZO-account van uw organisatie; rechtstreeks versturen vanuit Curanta volgt. Het retourbericht (GDS802) leest u in.' },
  { name: 'Zorgverzekeraars (Zvw)', category: 'Financieel', status: 'inrichten',
    body: 'Zvw-declaratie voor de wijkverpleging. Curanta maakt uit goedgekeurde zorg per zorgverzekeraar en maand het declaratiebericht (AW319), getoetst aan de recordlayout en de testset van Vektis. U levert het aan in het VECOZO-portaal en leest het antwoord (AW320) in. Rechtstreeks versturen vanuit Curanta volgt.' },

  // Sensoren en domotica
  { name: 'Domotica', category: 'Sensoren en domotica', status: 'inrichten',
    body: 'Alarmen en sensormeldingen van onder meer Mextal, Ascom, Sensara, CLB en CarePhone in een eigen overzicht. De dienstdoende zorg krijgt een melding. Aansluiten gaat per leverancier.' },

  // E-health
  { name: 'E-healthaanbieders', category: 'E-health', status: 'gepland',
    body: 'Koppelingen voor blended zorg: zorg die persoonlijk contact en e-health combineert. Vragen een overeenkomst en API-toegang per aanbieder; die zijn er nog niet.' },

  // Identiteit
  { name: 'DigiD', category: 'Identiteit', status: 'inrichten',
    body: 'Inloggen op het cliëntportaal met DigiD, minimaal niveau Substantieel. Een betaalde optie; de aansluiting bij Logius regelen wij per klant.' },
  { name: 'UZI-pas', category: 'Identiteit', status: 'inrichten',
    body: 'Curanta leest de pas uit en controleert de certificaatketen en of de pas is ingetrokken. Beschikbaar zodra wij de UZI-hostnaam op onze server hebben ingericht; dat is nog niet gebeurd. De eindtest met een echte pas doen wij bij de implementatie, met uw organisatie.' },
  { name: 'Microsoft Entra ID (SSO)', category: 'Identiteit', status: 'ontwikkeling',
    body: 'Aanmelden met het Microsoft-werkaccount in de backoffice en het medewerkerportaal, met rollen uit groepen, is gebouwd. De eindtest met een echte Microsoft-omgeving volgt. Alleen Microsoft Entra ID: geen SAML en geen andere aanbieders. Het cliëntportaal heeft geen SSO.' },

  // Klinisch
  { name: 'Ysis (Gerimedica)', category: 'Klinisch', status: 'ontwikkeling',
    body: 'Uitwisseling van het dossier met Ysis. Geen import: overstappen uit Ysis is een migratieproject.' },

  // Backoffice
  { name: 'DocuSign', category: 'Backoffice', status: 'inrichten',
    body: 'Digitaal ondertekenen van HR-documenten in het personeelsdossier. Vraagt een DocuSign-account van uw organisatie; DocuSign verwerkt de gegevens in de VS.' },
  { name: 'Mollie (betaallink voor cliënten)', category: 'Backoffice', status: 'inrichten',
    body: 'Een betaallink op de factuur; de cliënt betaalt op het eigen Mollie-account van uw organisatie. Vraagt een Mollie-account van uw organisatie. Nog niet te gebruiken: de aanmelding van Curanta bij Mollie is nog niet rond.' },
  { name: 'Boekhoudpakketten', category: 'Backoffice', status: 'demo',
    body: 'Geen koppeling maar een bestand: verkoopboekingen, toegekende declaraties en kosten voor Twinfield, SnelStart, AFAS, Exact (journaalposten) of Yuki. U leest het zelf in. Het Yuki-bestand is nog niet in een echte Yuki-administratie ingelezen.' },
  { name: 'Nmbrs', category: 'Backoffice', status: 'inrichten',
    body: 'De goedgekeurde salarisexport rechtstreeks naar Nmbrs. Vraagt een Nmbrs-partnerapp, een sleutel en toestemming van uw organisatie. De test met Nmbrs doen wij bij de implementatie, met uw organisatie. Zonder Nmbrs: een CSV-export voor elke salarisadministratie.' },
];

const categories = Array.from(new Set(integrations.map(i => i.category)));
const telling = (s: Status) => integrations.filter(i => i.status === s).length;
const gebouwd = telling('demo') + telling('inrichten');
---
<Base
  image="/og/integraties.png"
  title="Koppelingen: Vecozo, ZorgMail, ZorgDomein, Medimo | Curanta"
  description="Koppelingen van Curanta met Vecozo, ZorgMail, ZorgDomein, Medimo, DigiD en meer: per koppeling of hij gebouwd is en wat er nodig is om aan te sluiten."
>
  <PageHero
    eyebrow="Koppelingen en standaarden"
    title="Koppelingen: wat er is en wat u nodig hebt om aan te sluiten"
    subtitle="Een gebouwde koppeling werkt pas als uw organisatie bij de andere partij is aangesloten, met een certificaat, contract of toegang. Dat regelen wij samen bij de implementatie. De gebouwde koppelingen zitten in het abonnement. Wat de andere partij rekent, zoals een Vecozo-certificaat of ZorgMail-abonnement, betaalt u zelf."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="/api" class="btn-primary no-underline">Over de FHIR-API</a>
      <a href="/trust" class="btn-secondary no-underline">Trust Centre</a>
    </div>
  </PageHero>

  <section class="border-b border-ink-200 bg-curanta-50 py-10">
    <div class="container-prose grid gap-8 lg:grid-cols-12">
      {/* Hoofdgetal: wat er gebouwd is (in de demo of in te richten), daaronder de uitsplitsing per status
          (besluit Jan 14-10-2026: "gebouwd" voorop). */}
      <div class="self-start lg:col-span-5">
        <p class="font-display text-curanta-900">
          <span class="text-5xl font-extrabold tabular-nums">{gebouwd}</span>
          <span class="text-xl font-bold"> van de {integrations.length} koppelingen zijn gebouwd</span>
        </p>
        <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label="Aantal koppelingen per status">
          {STATUS_VOLGORDE.filter((k) => telling(k) > 0).map((k) => (
            <li class="rounded-xl bg-white p-3 ring-1 ring-ink-200">
              <div class="font-display text-2xl font-bold tabular-nums text-curanta-900">{telling(k)}</div>
              <div class="mt-1 text-xs text-ink-700">{STATUS[k].label}</div>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-7">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-ink-500">Wat de status betekent</h2>
        <StatusLegenda class="mt-3" />
      </div>
    </div>
  </section>

  {categories.map((cat) => (
    <section class="container-prose py-12 border-b border-ink-100 last:border-0">
      <h2 class="font-display text-2xl font-bold text-ink-900">{cat}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {integrations.filter(i => i.category === cat).map((i) => (
          <article class="rounded-lg border border-ink-100 bg-white p-5">
            <div class="flex flex-col gap-1">
              <h3 class="font-display text-base font-semibold text-ink-900">{i.name}</h3>
              <StatusLabel status={i.status} />
            </div>
            <p class="mt-2 text-sm text-ink-700 leading-relaxed">{i.body}</p>
            {i.doc && (
              <a href={i.doc} class="mt-3 inline-block text-xs font-medium text-curanta-700 no-underline hover:underline">
                Over de FHIR-API →
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="container-prose py-16">
    <div class="rounded-2xl border border-ink-100 bg-ink-100/50 p-8">
      <h2 class="font-display text-2xl font-bold text-ink-900">Mist u een koppeling?</h2>
      <p class="mt-3 max-w-2xl text-ink-700">
        Laat het ons weten. Wij bekijken of hij past in de opbouw van Curanta en in uw zorgproces.
        Wij reageren binnen 1 werkdag.
      </p>
      <a href="mailto:info@curanta.nl?subject=Koppeling" class="btn-primary mt-5 no-underline">Mail info@curanta.nl</a>
    </div>
  </section>

  <Cta />
</Base>
