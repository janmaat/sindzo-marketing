---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';

// /api — de stand van de FHIR-laag, volgens het feitenblad (rij API, bijgewerkt 28-09-2026,
// ADR 2026-09-28): een publieke, read-only FHIR R4 BgZ-document-API onder /fhir/r4, met
// CapabilityStatement, SMART-discovery en client_credentials met private_key_jwt; alleen vooraf
// geregistreerde systeemclients. Niet: "volledige FHIR-API", "SMART App Launch", "MedMij",
// "Wegiz-gekwalificeerd" of "sandbox". Beloof hier niets wat daar niet staat.

const resources = [
  { name: 'Patient', desc: 'Cliëntdemografie en contactgegevens: Zib-profiel.', status: 'live' },
  { name: 'Encounter', desc: 'Zorgmoment/contact: episode of care-context.', status: 'live' },
  { name: 'Observation', desc: 'Vitale functies.', status: 'live' },
  { name: 'MedicationStatement / MedicationRequest', desc: 'Medicatie-overzicht en voorschriften.', status: 'live' },
  { name: 'Condition', desc: 'Probleem-/diagnoseregistratie.', status: 'live' },
  { name: 'AllergyIntolerance', desc: 'Allergieën en intoleranties.', status: 'live' },
  { name: 'RelatedPerson', desc: 'Mantelzorger, wettelijk vertegenwoordiger, contactpersonen.', status: 'live' },
  { name: 'CarePlan', desc: 'Zorgplan: problemen, doelen en interventies.', status: 'live' },
  { name: 'Practitioner / PractitionerRole', desc: 'Behandelaar en zijn rol.', status: 'live' },
];

const dot = (s: string) =>
  s === 'live' ? 'bg-green-500' : s === 'wip' ? 'bg-amber-500' : 'bg-ink-300';
---
<Base
  title="API en FHIR: stand van zaken | Curanta"
  description="Curanta heeft een publieke, read-only FHIR R4-API die de BgZ van een cliënt als document levert, voor vooraf geregistreerde systemen. Wat er is en wat niet."
>
  <PageHero
    eyebrow="API en koppelen"
    title="De FHIR-API voor de BgZ: wat er is en wat niet"
    subtitle="Voor I&A en ketenpartners. Curanta heeft een publieke FHIR R4-API die alleen leestoegang geeft. Hij levert de Basisgegevensset Zorg (BgZ) van een cliënt als één document. Een systeem van een ketenpartner kan hem gebruiken nadat wij het hebben geregistreerd."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <a href="mailto:info@curanta.nl?subject=Registratie%20FHIR-API" class="btn-primary no-underline">Vraag registratie aan</a>
      <a href="/integraties" class="btn-secondary no-underline">Overzicht koppelingen</a>
    </div>
  </PageHero>

  <section class="container-prose py-12 border-b border-ink-100 bg-ink-100/40">
    <div class="grid max-w-5xl gap-6 md:grid-cols-2">
      <div class="rounded-xl bg-white p-5 ring-1 ring-ink-200">
        <h2 class="font-display text-lg font-bold text-curanta-900">Wat er is</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-ink-700">
          <li>Eén documentoperatie: de BgZ van een cliënt als FHIR R4-bundel. De bundel valideert zonder fouten of waarschuwingen tegen de profielen van Nictiz (nl-core).</li>
          <li>Een CapabilityStatement en SMART-discovery onder <code>/fhir/r4</code>.</li>
          <li>Toegang met <code>client_credentials</code> en <code>private_key_jwt</code>; een token is vijf minuten geldig en hoort bij één organisatie.</li>
          <li>Alleen voor systemen en cliënten die vooraf zijn geregistreerd.</li>
        </ul>
      </div>
      <div class="rounded-xl bg-white p-5 ring-1 ring-ink-200">
        <h2 class="font-display text-lg font-bold text-curanta-900">Wat er niet is</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-ink-700">
          <li>Geen API-sleutel, geen zelf aanmelden en geen testomgeving.</li>
          <li>Geen algemene FHIR-toegang om te lezen, zoeken of schrijven.</li>
          <li>Geen MedMij-aansluiting en geen eOverdracht via deze API.</li>
        </ul>
        <p class="mt-4 text-sm text-ink-700">
          Vragen? Mail <a href="mailto:info@curanta.nl" class="text-curanta-700">info@curanta.nl</a>; wij reageren binnen 1 werkdag.
        </p>
      </div>
    </div>
  </section>

  <section class="container-prose py-14 border-b border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">Wat er in de BgZ-bundel zit</h2>
    <p class="mt-2 text-sm text-ink-700 max-w-2xl">
      Deze FHIR-resources stelt Curanta uit het dossier samen voor de BgZ-bundel, gemapt op de Nederlandse zorginformatiebouwstenen (zibs). Van de 28 onderdelen van de BgZ vult Curanta er 6 volledig en 11 deels. Via de API vraagt u ze alleen op als onderdeel van die bundel, niet los.
    </p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {resources.map((r) => (
        <li class="flex items-start gap-3 rounded-lg border border-ink-100 bg-white p-4">
          <span class={`status-dot mt-1.5 shrink-0 ${dot(r.status)}`}></span>
          <div>
            <div class="text-sm font-semibold text-ink-900">{r.name}</div>
            <div class="mt-0.5 text-xs text-ink-500">{r.desc}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-prose py-14 border-b border-ink-100">
    <h2 class="font-display text-2xl font-bold text-ink-900">Hoe wij FHIR gebruiken</h2>
    <p class="mt-2 text-sm text-ink-700 max-w-3xl leading-relaxed">
      FHIR is bij ons het uitwisselingsformaat aan de grens met de keten; intern blijft de opslag
      relationeel (zie <a href="/adr" class="text-curanta-700 hover:underline">ADR-002</a>). Een volledige
      export van uw gegevens en bestanden krijgt u los daarvan in JSON, zonder exit-fee (zie <a href="/overstappen#eruit" class="text-curanta-700 hover:underline">Overstappen en exit</a>).
    </p>
  </section>

  <Cta
    title="Implementatiepartner of ketenleverancier?"
    subtitle="Wilt u de BgZ van gedeelde cliënten ophalen? Dan registreren wij uw systeem. Een testomgeving is er niet."
    primary={{ label: 'Mail ons over de API', href: 'mailto:info@curanta.nl?subject=API' }}
    secondary={{ label: 'Overzicht koppelingen', href: '/integraties' }}
  />
</Base>
